+def test_boundary_layer_sheltered_vertical_dse_scales_lower_increment(monkeypatch):
+    """The lower-layer shelter scales only the vertical-DSE increment."""
+    coords, physics_specs, reference_temperature, state = _ocean_bulk_shf_test_setup()
