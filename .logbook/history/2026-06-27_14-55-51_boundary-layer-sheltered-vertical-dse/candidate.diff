+def _pressure_ramped_vertical_dse_pbl_shelter_envelope(
+    vertical_coords: sigma_coordinates.SigmaCoordinates,
+) -> jax.Array:
+    """Return fixed sigma weights that shelter lower layers from vertical DSE."""
+    sigma = jnp.asarray(vertical_coords.centers, dtype=jnp.float32)
+    taper_fraction = jnp.clip(
+        (sigma - PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FULL_SIGMA)
+        / (
+            PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FLOOR_SIGMA
+            - PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FULL_SIGMA
+        ),
+        0.0,
+        1.0,
+    )
+    smooth_fraction = taper_fraction * taper_fraction * (3.0 - 2.0 * taper_fraction)
+    envelope = 1.0 - (
+        (1.0 - PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FLOOR) * smooth_fraction
+    )
+    return jnp.where(
+        sigma <= PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FULL_SIGMA,
+        1.0,
+        jnp.where(
+            sigma >= PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FLOOR_SIGMA,
+            PRESSURE_RAMPED_VERTICAL_DSE_PBL_SHELTER_FLOOR,
+            envelope,
+        ),
+    )
+
