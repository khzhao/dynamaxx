+    @jax.named_call
+    def mass_centered_weighted_dry_static_energy_anomaly(
+        self,
+        dry_static_energy_anomaly: Array,
+        layer_pressure_thickness: Array,
+    ) -> tuple[Array, Array]:
+        """Return delta-p-weighted DSE anomaly centered by layer mass."""
+        quadrature_weights = jnp.asarray(
+            self.coords.horizontal.quadrature_weights,
+            dtype=dry_static_energy_anomaly.dtype,
+        )
+        layer_mass_weights = layer_pressure_thickness * quadrature_weights
+        layer_mass_weight_sum = jnp.sum(layer_mass_weights, axis=(-2, -1))
+        tiny_weight_sum = jnp.asarray(
+            jnp.finfo(layer_mass_weight_sum.dtype).tiny,
+            dtype=layer_mass_weight_sum.dtype,
+        )
+        valid_weight_sum = jnp.isfinite(layer_mass_weight_sum) & (
+            layer_mass_weight_sum > tiny_weight_sum
+        )
+        safe_weight_sum = jnp.where(
+            valid_weight_sum,
+            layer_mass_weight_sum,
+            jnp.ones_like(layer_mass_weight_sum),
+        )
+        # The area mean subtracted in dry_static_energy_anomaly is layerwise
+        # constant, so subtracting its mass-weighted mean is equivalent to
+        # centering the underlying dry static energy by layer mass.
+        mass_mean_anomaly = (
+            jnp.sum(layer_mass_weights * dry_static_energy_anomaly, axis=(-2, -1))
+            / safe_weight_sum
+        )
+        mass_centered_dse_anomaly = (
+            dry_static_energy_anomaly - mass_mean_anomaly[:, jnp.newaxis, jnp.newaxis]
+        )
+        weighted_dse_anomaly = layer_pressure_thickness * mass_centered_dse_anomaly
+        finite_diagnostics = jnp.all(
+            jnp.asarray(
+                [
+                    jnp.all(jnp.isfinite(quadrature_weights)),
+                    jnp.all(jnp.isfinite(layer_mass_weights)),
+                    jnp.all(valid_weight_sum),
+                    jnp.all(jnp.isfinite(mass_mean_anomaly)),
+                    jnp.all(jnp.isfinite(mass_centered_dse_anomaly)),
+                    jnp.all(jnp.isfinite(weighted_dse_anomaly)),
+                ]
+            )
+        )
+        return weighted_dse_anomaly, finite_diagnostics
