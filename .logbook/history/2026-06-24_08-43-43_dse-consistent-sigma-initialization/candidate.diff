+def _dse_consistent_sigma_temperature_initialization(
+    *,
+    sigma_temperature: jax.Array,
+    pressure_level_temperature: jax.Array,
+    pressure_level_geopotential: jax.Array,
+    pressure_to_sigma: Any,
+    pressure_coords: vertical_interpolation.PressureCoordinates,
+    sigma_coords: sigma_coordinates.SigmaCoordinates,
+    surface_pressure_hpa: jax.Array,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+) -> jax.Array:
+    """Apply a bounded DSE-anomaly initialization correction to sigma temperature."""
+    if pressure_level_geopotential.shape != pressure_level_temperature.shape:
+        return sigma_temperature
+
+    pressure_level_dse = (
+        physics_specs.Cp * pressure_level_temperature + pressure_level_geopotential
+    )
+    pressure_level_dse_anomaly = _horizontal_layer_anomaly(
+        pressure_level_dse,
+        coords.horizontal.quadrature_weights,
+    )
+    projected_dse_anomaly = pressure_to_sigma(
+        {"dry_static_energy_anomaly": pressure_level_dse_anomaly},
+        pressure_coords,
+        sigma_coords,
+        surface_pressure_hpa,
+    )["dry_static_energy_anomaly"]
+    if projected_dse_anomaly.shape != sigma_temperature.shape:
+        return sigma_temperature
+
+    current_geopotential = primitive_equations.get_geopotential_on_sigma(
+        sigma_temperature,
+        nodal_orography=jnp.zeros(coords.horizontal.nodal_shape, dtype=jnp.float32),
+        sigma=sigma_coords,
+        gravity_acceleration=physics_specs.g,
+        ideal_gas_constant=physics_specs.R,
+    )
+    if current_geopotential.shape != sigma_temperature.shape:
+        return sigma_temperature
+
+    current_dse = physics_specs.Cp * sigma_temperature + current_geopotential
+    current_dse_anomaly = _horizontal_layer_anomaly(
+        current_dse,
+        coords.horizontal.quadrature_weights,
+    )
+    delta_temperature = (projected_dse_anomaly - current_dse_anomaly) / physics_specs.Cp
+    corrected_temperature = sigma_temperature + delta_temperature
+    correction_cap = (
+        _DSE_SIGMA_INITIALIZATION_MAX_CORRECTION_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+    )
+    correction_is_valid = (
+        jnp.all(jnp.isfinite(projected_dse_anomaly))
+        & jnp.all(jnp.isfinite(current_geopotential))
+        & jnp.all(jnp.isfinite(current_dse_anomaly))
+        & jnp.all(jnp.isfinite(delta_temperature))
+        & jnp.all(jnp.isfinite(corrected_temperature))
+        & jnp.all(jnp.abs(delta_temperature) <= correction_cap)
+    )
+    return jnp.where(correction_is_valid, corrected_temperature, sigma_temperature)
+
+
+def _horizontal_layer_anomaly(
+    layer_values: jax.Array,
+    quadrature_weights: np.ndarray,
+) -> jax.Array:
+    """Remove the horizontal quadrature mean from each vertical layer."""
+    weights = jnp.asarray(quadrature_weights, dtype=layer_values.dtype)
+    layer_mean = (
+        jnp.sum(layer_values * weights, axis=(-2, -1)) / jnp.sum(weights)
+    )
+    return layer_values - layer_mean[:, jnp.newaxis, jnp.newaxis]
+
