+def _weather_state_with_added_geopotential_pattern(
+    state: WeatherState,
+    pressure_levels_hpa: tuple[int, ...],
+    *,
+    amplitude: float,
+) -> WeatherState:
+    """Return one initialization with a shared horizontal geopotential anomaly."""
+    values = state.values[0]
+    longitude_count, latitude_count = state.spatial_shape
+    lon_pattern = jnp.arange(longitude_count, dtype=values.dtype)[:, np.newaxis]
+    lat_pattern = jnp.arange(latitude_count, dtype=values.dtype)[np.newaxis, :]
+    spatial_pattern = lon_pattern + 0.25 * lat_pattern
+    spatial_pattern = spatial_pattern - jnp.mean(spatial_pattern)
+    for pressure_level in pressure_levels_hpa:
+        channel_index = state.variables.index(f"geopotential_{pressure_level}")
+        values = values.at[channel_index].add(amplitude * spatial_pattern)
+    return WeatherState(values=values, variables=state.variables)
+
+
