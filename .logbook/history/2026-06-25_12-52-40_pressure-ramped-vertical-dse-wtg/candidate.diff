+                    jnp.all(jnp.isfinite(vertical_temperature_increment)),
+                    jnp.all(jnp.isfinite(low_mode_area_mean)),
+                    jnp.all(jnp.isfinite(capped_increment)),
+                    jnp.all(jnp.isfinite(candidate_temperature_tendency)),
+                ]
