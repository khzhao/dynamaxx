+def _post_dfi_forecast_initial_state(*, init_count: int) -> WeatherState:
+    longitude_count = 4
+    latitude_count = 3
+    lon_pattern = jnp.arange(longitude_count, dtype=jnp.float32)[:, np.newaxis]
+    lat_pattern = jnp.arange(latitude_count, dtype=jnp.float32)[np.newaxis, :]
+    spatial_pattern = lon_pattern + 0.25 * lat_pattern
+    pressure_levels = (300, 500, 700)
+    fields = {}
+    for pressure_level in pressure_levels:
+        pressure_fraction = pressure_level / 1000.0
+        fields[f"temperature_{pressure_level}"] = (
+            240.0 + 45.0 * pressure_fraction + 0.2 * spatial_pattern
+        )
+        fields[f"u_component_of_wind_{pressure_level}"] = (
+            2.0 + 0.4 * pressure_fraction + 0.05 * spatial_pattern
+        )
+        fields[f"v_component_of_wind_{pressure_level}"] = (
+            -1.0 + 0.2 * pressure_fraction - 0.03 * spatial_pattern
+        )
+        fields[f"specific_humidity_{pressure_level}"] = (
+            0.001 + 0.0001 * pressure_fraction
+        ) + 0.0 * spatial_pattern
+        fields[f"geopotential_{pressure_level}"] = (
+            45_000.0
+            - 45.0 * pressure_level
+            + 12.0 * jnp.cos(spatial_pattern)
+        )
+    fields["mean_sea_level_pressure"] = 100_000.0 + 20.0 * spatial_pattern
+    fields["2m_temperature"] = 286.0 + 0.1 * spatial_pattern
+    fields["10m_u_component_of_wind"] = 3.0 + 0.05 * spatial_pattern
+
+    values = jnp.stack(
+        [
+            jnp.broadcast_to(
