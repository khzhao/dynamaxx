+def _post_dfi_analysis_geopotential_or_none(
+    state: WeatherState,
+    *,
+    latitude_reversed: bool,
+    physics_specs: Any,
+) -> jax.Array | None:
+    """Return required same-time analysis geopotential or `None` for exact no-op."""
+    required_channels = tuple(
+        f"{GEOPOTENTIAL_VARIABLE}_{pressure_level}"
+        for pressure_level in _POST_DFI_THICKNESS_PRESSURE_LEVELS_HPA
+    )
+    if any(channel not in state.variables for channel in required_channels):
+        return None
+    indices = jnp.asarray(state.variable_indices(required_channels), dtype=jnp.int32)
+    geopotential = jnp.take(state.values, indices, axis=-3)
+    geopotential = _to_dinosaur_latitude_order(geopotential, latitude_reversed)
+    return geopotential * _unit_factor(physics_specs, "meter ** 2 / second ** 2")
+
+
+def _post_dfi_low_mode_thickness_recenter(
+    state: Any,
+    *,
+    analysis_geopotential: jax.Array | None,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+    pressure_levels_hpa: tuple[int, ...],
+) -> Any:
+    """Apply one guarded post-DFI low-mode thickness correction to temperature."""
+    if (
+        analysis_geopotential is None
+        or tuple(pressure_levels_hpa) == ()
+        or tuple(analysis_geopotential.shape[-3:])
+        != (
+            len(_POST_DFI_THICKNESS_PRESSURE_LEVELS_HPA),
+            *coords.horizontal.nodal_shape,
+        )
+    ):
+        return state
+
+    dfi_geopotential, pressure_bracket_is_valid = (
+        _post_dfi_geopotential_on_pressure_levels(
+            state,
+            coords=coords,
+            physics_specs=physics_specs,
+            reference_temperature=reference_temperature,
+        )
+    )
+    residual = analysis_geopotential - dfi_geopotential
+    z500_residual = residual[1]
+    thickness_residual = residual[0] - residual[2]
+    low_mode_mask = _post_dfi_thickness_low_mode_mask(coords.horizontal)
+    low_mode_z500_residual = coords.horizontal.to_nodal(
+        coords.horizontal.to_modal(z500_residual) * low_mode_mask
+    )
+    low_mode_thickness_residual = coords.horizontal.to_nodal(
+        coords.horizontal.to_modal(thickness_residual) * low_mode_mask
+    )
+
+    geopotential_unit = _unit_factor(physics_specs, "meter ** 2 / second ** 2")
+    temperature_unit = _unit_factor(physics_specs, "kelvin")
+    residual_cap = jnp.asarray(
+        _POST_DFI_THICKNESS_MAX_RESIDUAL_M2_S2 * geopotential_unit,
+        dtype=low_mode_thickness_residual.dtype,
+    )
+    residual_noop_threshold = jnp.asarray(
+        _POST_DFI_THICKNESS_NOOP_THRESHOLD_M2_S2 * geopotential_unit,
+        dtype=low_mode_thickness_residual.dtype,
+    )
+    temperature_cap = jnp.asarray(
+        _POST_DFI_THICKNESS_MAX_TEMPERATURE_INCREMENT_KELVIN * temperature_unit,
+        dtype=low_mode_thickness_residual.dtype,
+    )
+    temperature_noop_threshold = jnp.asarray(
+        _POST_DFI_THICKNESS_NOOP_TEMPERATURE_INCREMENT_KELVIN * temperature_unit,
+        dtype=low_mode_thickness_residual.dtype,
+    )
+
+    thickness_log_pressure_interval = jnp.log(jnp.asarray(700.0 / 300.0))
+    raw_temperature_increment = (
+        low_mode_thickness_residual
+        / geopotential_unit
+        / (_DRY_AIR_GAS_CONSTANT_SI * thickness_log_pressure_interval)
+        * temperature_unit
+    )
+    vertical_envelope = _post_dfi_thickness_vertical_envelope(coords.vertical)
+    layer_temperature_increment = (
+        vertical_envelope[:, jnp.newaxis, jnp.newaxis]
+        * raw_temperature_increment[jnp.newaxis, ...]
+    )
+    quadrature_weights = jnp.asarray(coords.horizontal.quadrature_weights)
+    layer_temperature_increment = jax.vmap(
+        lambda layer_increment: _bounded_area_neutral_field(
+            layer_increment,
+            temperature_cap,
+            quadrature_weights,
+        )
+    )(layer_temperature_increment)
+    modal_temperature_increment = coords.horizontal.to_modal(layer_temperature_increment)
+    layer_temperature_increment = coords.horizontal.to_nodal(
+        modal_temperature_increment
+    )
+    projected_increment_max = jnp.max(jnp.abs(layer_temperature_increment))
+    projection_scale = jnp.where(
+        projected_increment_max > temperature_cap,
+        temperature_cap / jnp.maximum(projected_increment_max, 1.0e-30),
+        1.0,
+    )
+    layer_temperature_increment = layer_temperature_increment * projection_scale
+    modal_temperature_increment = coords.horizontal.to_modal(layer_temperature_increment)
+    corrected_temperature_variation = state.temperature_variation + (
+        modal_temperature_increment
+    )
+
+    surface_pressure = jnp.exp(coords.horizontal.to_nodal(state.log_surface_pressure))
+    corrected_temperature = (
+        coords.horizontal.to_nodal(corrected_temperature_variation)
+        + jnp.asarray(reference_temperature)[:, jnp.newaxis, jnp.newaxis]
+    )
+    static_stability_is_valid = _post_dfi_static_stability_is_valid(
+        corrected_temperature,
+        surface_pressure=surface_pressure,
+        coords=coords,
+        physics_specs=physics_specs,
+    )
+    sign_consistent = (
+        jnp.max(jnp.abs(low_mode_z500_residual)) > residual_noop_threshold
+    ) & (jnp.max(jnp.abs(low_mode_thickness_residual)) > residual_noop_threshold)
+    sign_consistent = sign_consistent & jnp.all(
+        low_mode_z500_residual * low_mode_thickness_residual
+        >= -(residual_noop_threshold**2)
+    )
+    residuals_are_bounded = (
+        jnp.max(jnp.abs(low_mode_z500_residual)) <= residual_cap
+    ) & (jnp.max(jnp.abs(low_mode_thickness_residual)) <= residual_cap)
+    candidate_has_effect = (
+        jnp.max(jnp.abs(layer_temperature_increment)) > temperature_noop_threshold
+    )
+    finite_diagnostics = jnp.all(
+        jnp.asarray(
+            [
+                jnp.all(jnp.isfinite(analysis_geopotential)),
+                jnp.all(jnp.isfinite(dfi_geopotential)),
+                jnp.all(jnp.isfinite(residual)),
+                jnp.all(jnp.isfinite(low_mode_z500_residual)),
+                jnp.all(jnp.isfinite(low_mode_thickness_residual)),
+                jnp.all(jnp.isfinite(raw_temperature_increment)),
+                jnp.all(jnp.isfinite(layer_temperature_increment)),
+                jnp.all(jnp.isfinite(corrected_temperature_variation)),
+                jnp.all(jnp.isfinite(corrected_temperature)),
+                jnp.all(corrected_temperature > 0.0),
+            ]
+        )
+    )
+    use_candidate = (
+        pressure_bracket_is_valid
+        & finite_diagnostics
+        & sign_consistent
+        & residuals_are_bounded
+        & static_stability_is_valid
+        & candidate_has_effect
+    )
+    return _primitive_equation_state(
+        vorticity=state.vorticity,
+        divergence=state.divergence,
+        temperature_variation=jnp.where(
+            use_candidate,
+            corrected_temperature_variation,
+            state.temperature_variation,
+        ),
+        log_surface_pressure=state.log_surface_pressure,
+        tracers=state.tracers,
+        sim_time=state.sim_time,
+    )
+
+
+def _post_dfi_geopotential_on_pressure_levels(
+    state: Any,
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+) -> tuple[jax.Array, jax.Array]:
+    """Diagnose DFI-state geopotential on the fixed thickness pressure levels."""
+    temperature = (
+        coords.horizontal.to_nodal(state.temperature_variation)
+        + jnp.asarray(reference_temperature)[:, jnp.newaxis, jnp.newaxis]
+    )
+    humidity = None
+    if SPECIFIC_HUMIDITY_VARIABLE in state.tracers:
+        humidity = coords.horizontal.to_nodal(state.tracers[SPECIFIC_HUMIDITY_VARIABLE])
+    geopotential = primitive_equations.get_geopotential_on_sigma(
+        temperature,
+        specific_humidity=humidity,
+        nodal_orography=jnp.zeros(coords.horizontal.nodal_shape, dtype=jnp.float32),
+        sigma=cast(sigma_coordinates.SigmaCoordinates, coords.vertical),
+        gravity_acceleration=physics_specs.g,
+        ideal_gas_constant=physics_specs.R,
+        water_vapor_gas_constant=physics_specs.R_vapor,
+    )
+    pressure_factor = _unit_factor(physics_specs, "pascal")
+    surface_pressure = jnp.exp(coords.horizontal.to_nodal(state.log_surface_pressure))[
+        0
+    ]
+    surface_pressure_hpa = surface_pressure / pressure_factor / 100.0
+    sigma_centers = jnp.asarray(coords.vertical.centers)
+    sigma_pressure_hpa = sigma_centers[:, jnp.newaxis, jnp.newaxis] * (
+        surface_pressure_hpa[jnp.newaxis, ...]
+    )
+    required_pressure_levels = jnp.asarray(
+        _POST_DFI_THICKNESS_PRESSURE_LEVELS_HPA,
+        dtype=surface_pressure_hpa.dtype,
+    )
+    pressure_bracket_is_valid = (
+        jnp.all(jnp.isfinite(surface_pressure_hpa))
+        & jnp.all(surface_pressure_hpa > 0.0)
+        & jnp.all(jnp.min(sigma_pressure_hpa, axis=0) <= required_pressure_levels[0])
+        & jnp.all(jnp.max(sigma_pressure_hpa, axis=0) >= required_pressure_levels[-1])
+    )
+    pressure_fields = vertical_interpolation.interp_sigma_to_pressure(
+        {GEOPOTENTIAL_VARIABLE: geopotential},
+        _pressure_coordinates(_POST_DFI_THICKNESS_PRESSURE_LEVELS_HPA),
+        cast(sigma_coordinates.SigmaCoordinates, coords.vertical),
+        surface_pressure_hpa,
+        interpolate_fn=_FINITE_SIGMA_TO_PRESSURE_INTERPOLATE,
+    )
+    return pressure_fields[GEOPOTENTIAL_VARIABLE], pressure_bracket_is_valid
+
+
+def _post_dfi_thickness_low_mode_mask(
+    horizontal_grid: spherical_harmonic.Grid,
+) -> jax.Array:
+    """Return the fixed low-mode spectral mask for post-DFI thickness residuals."""
+    _, total_wavenumber = horizontal_grid.modal_mesh
+    low_mode_mask = (
+        np.asarray(horizontal_grid.mask)
+        & (total_wavenumber <= _POST_DFI_THICKNESS_LOW_MODE_CUTOFF)
+    )
+    return jnp.asarray(low_mode_mask, dtype=jnp.float32)
+
+
+def _post_dfi_thickness_vertical_envelope(
+    vertical_coords: sigma_coordinates.SigmaCoordinates,
+) -> jax.Array:
+    """Return the fixed smooth middle-column envelope for thickness recentering."""
+    sigma = jnp.asarray(vertical_coords.centers)
+    upper_fraction = jnp.clip(
+        (sigma - _POST_DFI_THICKNESS_SIGMA_ZERO_TOP)
+        / (_POST_DFI_THICKNESS_SIGMA_FULL_TOP - _POST_DFI_THICKNESS_SIGMA_ZERO_TOP),
+        0.0,
+        1.0,
+    )
+    lower_fraction = jnp.clip(
+        (_POST_DFI_THICKNESS_SIGMA_ZERO_BOTTOM - sigma)
+        / (_POST_DFI_THICKNESS_SIGMA_ZERO_BOTTOM - _POST_DFI_THICKNESS_SIGMA_FULL_BOTTOM),
+        0.0,
+        1.0,
+    )
+    upper_taper = upper_fraction * upper_fraction * (3.0 - 2.0 * upper_fraction)
+    lower_taper = lower_fraction * lower_fraction * (3.0 - 2.0 * lower_fraction)
+    return jnp.where(
+        (sigma >= _POST_DFI_THICKNESS_SIGMA_FULL_TOP)
+        & (sigma <= _POST_DFI_THICKNESS_SIGMA_FULL_BOTTOM),
+        1.0,
+        upper_taper * lower_taper,
+    )
+
+
+def _post_dfi_static_stability_is_valid(
+    temperature: jax.Array,
+    *,
+    surface_pressure: jax.Array,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+) -> jax.Array:
+    """Return whether corrected potential temperature keeps a positive floor."""
+    sigma_centers = jnp.asarray(coords.vertical.centers)
+    pressure = sigma_centers[:, jnp.newaxis, jnp.newaxis] * surface_pressure
+    unit_registry = cast(Any, scales.units)
+    reference_pressure = float(
+        physics_specs.nondimensionalize(unit_registry.Quantity(100000.0, "pascal"))
+    )
+    theta = primitive_equations.potential_temperature_from_temperature(
+        temperature,
+        pressure,
+        reference_pressure,
+        physics_specs.kappa,
+    )
+    static_stability_floor = (
+        _POST_DFI_THICKNESS_STATIC_STABILITY_FLOOR_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+    )
+    layer_static_stability = theta[:-1] - theta[1:]
+    return (
+        jnp.all(jnp.isfinite(theta))
+        & jnp.all(jnp.isfinite(pressure))
+        & jnp.all(pressure > 0.0)
+        & jnp.all(layer_static_stability >= static_stability_floor)
+    )
+
