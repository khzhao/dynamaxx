+def _synthetic_post_dfi_state(
+    *,
+    neutral_potential_temperature: bool = False,
+) -> tuple[coordinate_systems.CoordinateSystem, Any, np.ndarray, Any]:
+    physics_specs = units.SimUnits.from_si()
+    horizontal_grid = spherical_harmonic.Grid(
+        longitude_wavenumbers=6,
+        total_wavenumbers=8,
+        longitude_nodes=16,
+        latitude_nodes=8,
+        latitude_spacing="gauss",
+        radius=physics_specs.radius,
+    )
+    coords = coordinate_systems.CoordinateSystem(
+        horizontal_grid,
+        sigma_coordinates.SigmaCoordinates.equidistant(5),
+    )
+    reference_temperature = _reference_temperature(
+        layer_count=coords.vertical.layers,
+        temperature_kelvin=250.0,
+    )
+    surface_pressure = jnp.full(
+        coords.horizontal.nodal_shape,
+        100_000.0 * _unit_factor(physics_specs, "pascal"),
+        dtype=jnp.float32,
+    )
+    sigma_centers = jnp.asarray(coords.vertical.centers, dtype=jnp.float32)
+    if neutral_potential_temperature:
+        full_temperature = (
+            300.0
+            * sigma_centers[:, jnp.newaxis, jnp.newaxis] ** physics_specs.kappa
+            * _unit_factor(physics_specs, "kelvin")
+        )
+        full_temperature = jnp.broadcast_to(full_temperature, coords.nodal_shape)
+    else:
+        full_temperature = jnp.asarray(
+            [230.0, 245.0, 260.0, 275.0, 290.0],
+            dtype=jnp.float32,
+        )[:, jnp.newaxis, jnp.newaxis] * _unit_factor(physics_specs, "kelvin")
+        full_temperature = jnp.broadcast_to(full_temperature, coords.nodal_shape)
+    state = _primitive_equation_state(
+        vorticity=jnp.zeros(coords.modal_shape, dtype=jnp.float32),
+        divergence=jnp.zeros(coords.modal_shape, dtype=jnp.float32),
+        temperature_variation=coords.horizontal.to_modal(
+            full_temperature - reference_temperature[:, jnp.newaxis, jnp.newaxis]
+        ),
+        log_surface_pressure=coords.horizontal.to_modal(jnp.log(surface_pressure))[
+            jnp.newaxis
+        ],
+        tracers={
+            "specific_humidity": jnp.zeros(coords.modal_shape, dtype=jnp.float32),
+        },
+        sim_time=jnp.asarray(3.0, dtype=jnp.float32),
+    )
+    return coords, physics_specs, reference_temperature, state
+
+
+def _post_dfi_low_mode_pattern(horizontal_grid: spherical_harmonic.Grid) -> jax.Array:
+    longitude, sin_latitude = horizontal_grid.nodal_mesh
+    pattern = jnp.cos(longitude) * (1.0 - sin_latitude**2)
+    weights = jnp.asarray(horizontal_grid.quadrature_weights)
+    return pattern - jnp.sum(pattern * weights) / jnp.sum(weights)
