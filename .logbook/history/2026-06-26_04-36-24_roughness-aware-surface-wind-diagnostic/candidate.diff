+@pytest.mark.parametrize("mask_case", ("missing", "wrong_shape", "nonfinite"))
+def test_roughness_aware_10m_wind_invalid_mask_reproduces_incumbent(
+    monkeypatch,
+    mask_case,
+):
+    """Invalid roughness data falls back exactly to the incumbent diagnostic."""
+
+    def fake_digital_filter_initialization(
+        equation,
+        ode_solver,
+        filters,
+        time_span,
+        cutoff_period,
+        dt,
+    ):
+        del equation, ode_solver, filters, time_span, cutoff_period, dt
+        return lambda dinosaur_state: dinosaur_state
+
+    def invalid_land_sea_fraction(*, longitude, latitude, initial_time):
+        del initial_time
+        if mask_case == "missing":
+            return None
+        if mask_case == "nonfinite":
+            return jnp.full((longitude.size, latitude.size), jnp.nan, dtype=jnp.float32)
+        return jnp.zeros((longitude.size, latitude.size + 1), dtype=jnp.float32)
+
+    monkeypatch.setattr(
+        time_integration,
+        "digital_filter_initialization",
+        fake_digital_filter_initialization,
+    )
+    monkeypatch.setattr(
+        dinosaur_adapter,
+        "_load_land_sea_fraction_for_grid",
+        invalid_land_sea_fraction,
