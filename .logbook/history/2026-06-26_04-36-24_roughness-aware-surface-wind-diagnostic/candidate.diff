+def _roughness_aware_10m_wind_adjustment(
+    land_sea_fraction: jax.Array,
+) -> jax.Array:
+    """Return a bounded neutral log-law adjustment from a land-fraction proxy.
+
+    The fixed roughness lengths order open water as smoothest, land as roughest,
+    and blend coastlines geometrically to avoid discontinuities.
+    """
+    land_fraction = jnp.clip(
+        jnp.asarray(land_sea_fraction, dtype=jnp.float32), 0.0, 1.0
+    )
+    log_ocean_z0 = jnp.log(_ROUGHNESS_AWARE_10M_WIND_OCEAN_Z0_METERS)
+    log_land_z0 = jnp.log(_ROUGHNESS_AWARE_10M_WIND_LAND_Z0_METERS)
+    effective_z0 = jnp.exp(
+        (1.0 - land_fraction) * log_ocean_z0 + land_fraction * log_land_z0
+    )
+    reference_z0 = jnp.asarray(
+        _ROUGHNESS_AWARE_10M_WIND_REFERENCE_Z0_METERS,
+        dtype=effective_z0.dtype,
+    )
+
+    transfer_height = _ROUGHNESS_AWARE_10M_WIND_TRANSFER_HEIGHT_METERS
+    reference_height = _SURFACE_LAYER_REFERENCE_HEIGHT_METERS
+    roughness_transfer = jnp.log(reference_height / effective_z0) / jnp.log(
+        transfer_height / effective_z0
+    )
+    reference_transfer = jnp.log(reference_height / reference_z0) / jnp.log(
+        transfer_height / reference_z0
+    )
+    adjustment = roughness_transfer / reference_transfer
+    return jnp.clip(
+        adjustment,
+        _ROUGHNESS_AWARE_10M_WIND_MIN_ADJUSTMENT,
+        _ROUGHNESS_AWARE_10M_WIND_MAX_ADJUSTMENT,
+    )
