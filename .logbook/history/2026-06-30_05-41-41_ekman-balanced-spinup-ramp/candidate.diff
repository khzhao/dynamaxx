+def _ekman_positive_time_spinup_ramp(
+    sim_time: Any,
+    physics_specs: Any,
+) -> jax.Array:
+    """Return the fixed Ekman activation factor from forecast model time."""
+    if sim_time is None:
+        return jnp.asarray(1.0, dtype=jnp.float32)
+    sim_time = jnp.asarray(sim_time)
+    hour = scales.units.Quantity(3600.0, "second")
+    nondimensional_hour = jnp.asarray(
+        physics_specs.nondimensionalize(hour),
+        dtype=sim_time.dtype,
+    )
+    ramp_fraction = jnp.clip(
+        sim_time / (_EKMAN_SPINUP_FULL_HOURS * nondimensional_hour),
+        0.0,
+        1.0,
+    )
+    smooth_fraction = ramp_fraction * ramp_fraction * (3.0 - 2.0 * ramp_fraction)
+    ramp_factor = _EKMAN_SPINUP_INITIAL_FRACTION + (
+        1.0 - _EKMAN_SPINUP_INITIAL_FRACTION
+    ) * smooth_fraction
+    valid_time = jnp.all(jnp.isfinite(sim_time)) & jnp.all(sim_time >= 0.0)
+    return jnp.where(valid_time, ramp_factor, 1.0)
+
