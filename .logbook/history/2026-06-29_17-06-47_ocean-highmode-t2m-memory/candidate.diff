+def _ocean_high_mode_t2m_memory_test_inputs() -> tuple[Any, jax.Array, jax.Array]:
+    longitude = np.linspace(0.0, 360.0, 64, endpoint=False)
+    latitude = np.linspace(90.0, -90.0, 33)
+    grid = grid_metadata(
+        longitude=longitude,
+        latitude=latitude,
+        layer_count=2,
+        spectral_wavenumbers=None,
+    )
+    longitude_phase = jnp.arange(longitude.size, dtype=jnp.float32)
+    latitude_phase = jnp.linspace(-jnp.pi / 2.0, jnp.pi / 2.0, latitude.size)
+    residual = (
+        24.0
+        * jnp.sin(18.0 * 2.0 * jnp.pi * longitude_phase / longitude.size)[
+            :, jnp.newaxis
+        ]
+        * jnp.cos(2.0 * latitude_phase)[jnp.newaxis, :]
+    )
+    land_sea_fraction = jnp.zeros(grid.coords.horizontal.nodal_shape, dtype=jnp.float32)
+    return grid, residual.astype(jnp.float32), land_sea_fraction
+
+
+def _ocean_high_mode_t2m_memory_test_case(
+    *,
+    residual: jax.Array | None = None,
+) -> tuple[Any, jax.Array, jax.Array, WeatherState, WeatherState]:
+    grid, default_residual, land_sea_fraction = (
+        _ocean_high_mode_t2m_memory_test_inputs()
+    )
+    residual = default_residual if residual is None else residual
+    lead_count = 4
+    spatial_shape = grid.coords.horizontal.nodal_shape
+    base_temperature = jnp.full(spatial_shape, 280.0, dtype=jnp.float32)
+    raw_temperature = jnp.stack(
+        [base_temperature + float(lead_index) for lead_index in range(lead_count)]
+    )
+    raw_u_wind = jnp.stack(
+        [
+            jnp.full(spatial_shape, 2.0 + lead_index, dtype=jnp.float32)
+            for lead_index in range(lead_count)
+        ]
+    )
+    raw_pressure = jnp.stack(
+        [
+            jnp.full(
+                spatial_shape,
+                100_000.0 - 50.0 * lead_index,
+                dtype=jnp.float32,
+            )
+            for lead_index in range(lead_count)
+        ]
+    )
+    trajectory_state = WeatherState(
+        values=jnp.stack([raw_temperature, raw_u_wind, raw_pressure], axis=1),
+        variables=(
+            "2m_temperature",
+            "10m_u_component_of_wind",
+            "mean_sea_level_pressure",
+        ),
+    )
+    initial_state = WeatherState(
+        values=jnp.stack([raw_temperature[0] + residual, raw_u_wind[0] + 3.0]),
+        variables=("2m_temperature", "10m_u_component_of_wind"),
+    )
+    return grid, residual, land_sea_fraction, trajectory_state, initial_state
+
