+def _ocean_high_mode_t2m_memory_correction(
+    residual: jax.Array,
+    *,
+    low_mode_residual: jax.Array,
+    land_sea_fraction: jax.Array,
+    horizontal_grid: spherical_harmonic.Grid,
+    latitude_reversed: bool,
+    lead_hours_array: jax.Array,
+    incumbent_high_mode_decay: jax.Array,
+) -> tuple[jax.Array, jax.Array]:
+    """Return capped late ocean high-mode T2m residual memory."""
+    broad_residual, broad_residual_is_valid = _land_ocean_low_mode_t2m_residual(
+        low_mode_residual,
+        land_sea_fraction=land_sea_fraction,
+        horizontal_grid=horizontal_grid,
+        latitude_reversed=latitude_reversed,
+    )
+    residual = jnp.asarray(residual)
+    land_fraction = jnp.asarray(land_sea_fraction, dtype=residual.dtype)
+    ocean_weight = _smooth_ocean_weight_from_land_fraction(land_fraction)
+    residual_remainder = residual - broad_residual
+    weighted_remainder = residual_remainder * ocean_weight
+    band_residual, band_is_valid = _ocean_high_mode_t2m_memory_band_residual(
+        weighted_remainder,
+        horizontal_grid=horizontal_grid,
+        latitude_reversed=latitude_reversed,
+    )
+
+    lead_hours = lead_hours_array[:, jnp.newaxis, jnp.newaxis]
+    ramp_fraction = jnp.clip(
+        (lead_hours - _OCEAN_HIGH_MODE_T2M_MEMORY_RAMP_START_HOURS)
+        / (
+            _OCEAN_HIGH_MODE_T2M_MEMORY_RAMP_FULL_HOURS
+            - _OCEAN_HIGH_MODE_T2M_MEMORY_RAMP_START_HOURS
+        ),
+        0.0,
+        1.0,
+    )
+    ramp = ramp_fraction * ramp_fraction * (3.0 - 2.0 * ramp_fraction)
+    memory_decay = jnp.exp(
+        -lead_hours
+        / jnp.asarray(
+            _OCEAN_HIGH_MODE_T2M_MEMORY_DECAY_HOURS,
+            dtype=lead_hours.dtype,
+        )
+    )
+    extra_decay = jnp.maximum(memory_decay - incumbent_high_mode_decay, 0.0) * ramp
+    uncapped_correction = band_residual[jnp.newaxis, ...] * extra_decay
+    correction = jnp.clip(
+        uncapped_correction,
+        -_OCEAN_HIGH_MODE_T2M_MEMORY_MAX_CORRECTION_KELVIN,
+        _OCEAN_HIGH_MODE_T2M_MEMORY_MAX_CORRECTION_KELVIN,
+    )
+
+    quadrature_weights = jnp.asarray(
+        horizontal_grid.quadrature_weights,
+        dtype=residual.dtype,
+    )
+    quadrature_weights = _from_dinosaur_latitude_order(
+        quadrature_weights,
+        latitude_reversed,
+    )
+    tiny_weight = jnp.asarray(jnp.finfo(residual.dtype).tiny, dtype=residual.dtype)
+    ocean_weight_sum = jnp.sum(ocean_weight * quadrature_weights)
+    correction_is_valid = (
+        broad_residual_is_valid
+        & band_is_valid
+        & (ocean_weight_sum > tiny_weight)
+        & jnp.all(jnp.isfinite(residual_remainder))
+        & jnp.all(jnp.isfinite(ocean_weight))
+        & jnp.all(jnp.isfinite(extra_decay))
+        & jnp.all(jnp.isfinite(correction))
+        & jnp.all(ocean_weight >= 0.0)
+        & jnp.all(ocean_weight <= 1.0)
+        & jnp.all(extra_decay >= 0.0)
+        & jnp.all(extra_decay <= 1.0)
+    )
+    return correction, correction_is_valid
+
+
+def _smooth_ocean_weight_from_land_fraction(land_fraction: jax.Array) -> jax.Array:
+    """Return a smooth open-ocean weight from a `[0, 1]` land fraction."""
+    ocean_fraction = jnp.clip(1.0 - land_fraction, 0.0, 1.0)
+    return ocean_fraction * ocean_fraction * (3.0 - 2.0 * ocean_fraction)
+
+
+def _ocean_high_mode_t2m_memory_band_residual(
+    residual: jax.Array,
+    *,
+    horizontal_grid: spherical_harmonic.Grid,
+    latitude_reversed: bool,
+) -> tuple[jax.Array, jax.Array]:
+    """Filter an ocean T2m residual remainder into a tapered high-mode band."""
+    if tuple(residual.shape[-2:]) != tuple(horizontal_grid.nodal_shape):
+        raise ValueError(
+            "ocean high-mode T2m residual shape does not match Dinosaur horizontal grid"
+        )
+
+    residual_in_model_order = _to_dinosaur_latitude_order(residual, latitude_reversed)
+    modal_residual = horizontal_grid.to_modal(residual_in_model_order)
+    high_mode_mask = _ocean_high_mode_t2m_memory_band_mask(horizontal_grid)
+    band_residual = horizontal_grid.to_nodal(modal_residual * high_mode_mask)
+    band_residual = _from_dinosaur_latitude_order(
+        band_residual,
+        latitude_reversed,
+    )
+    band_is_valid = (
+        jnp.all(jnp.isfinite(residual))
+        & jnp.all(jnp.isfinite(high_mode_mask))
+        & jnp.any(high_mode_mask > 0.0)
+        & jnp.all(jnp.isfinite(band_residual))
+    )
+    return band_residual, band_is_valid
+
+
+def _ocean_high_mode_t2m_memory_band_mask(
+    horizontal_grid: spherical_harmonic.Grid,
+) -> jax.Array:
+    """Return the fixed tapered high-mode band for ocean T2m memory."""
+    _, total_wavenumber = horizontal_grid.modal_mesh
+    valid_modes = np.asarray(horizontal_grid.mask, dtype=bool)
+    low_mode_mask = np.asarray(_scale_separated_residual_low_mode_mask(horizontal_grid))
+    total_wavenumber = np.asarray(total_wavenumber, dtype=np.float32)
+    if not bool(valid_modes.any()):
+        return jnp.zeros_like(low_mode_mask, dtype=jnp.float32)
+
+    max_total_wavenumber = float(np.max(total_wavenumber[valid_modes]))
+    taper_start = max(
+        float(_SCALE_SEPARATED_RESIDUAL_TAPER_ZERO_MODE),
+        _OCEAN_HIGH_MODE_T2M_MEMORY_TAPER_START_FRACTION * max_total_wavenumber,
+    )
+    taper_zero = max(
+        taper_start + 1.0,
+        _OCEAN_HIGH_MODE_T2M_MEMORY_TAPER_ZERO_FRACTION * max_total_wavenumber,
+    )
+    transition = (total_wavenumber - taper_start) / (taper_zero - taper_start)
+    transition = np.clip(transition, 0.0, 1.0)
+    grid_scale_taper = 0.5 * (1.0 + np.cos(np.pi * transition))
+    grid_scale_taper = np.where(total_wavenumber >= taper_zero, 0.0, grid_scale_taper)
+    high_mode_band = (1.0 - low_mode_mask) * grid_scale_taper
+    high_mode_band = np.where(valid_modes, high_mode_band, 0.0)
+    return jnp.asarray(high_mode_band, dtype=jnp.float32)
+
