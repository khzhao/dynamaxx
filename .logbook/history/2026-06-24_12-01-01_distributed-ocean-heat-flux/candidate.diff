+def _ocean_bulk_shf_lower_column_sigma_taper(
+    vertical: sigma_coordinates.SigmaCoordinates,
+) -> jax.Array:
+    """Return fixed nonnegative lower-column weights for ocean heat distribution."""
+    sigma_centers = jnp.asarray(vertical.centers, dtype=jnp.float32)
+    active_lower_column = sigma_centers >= _OCEAN_BULK_SHF_TAPER_MIN_SIGMA
+    taper_weights = jnp.where(
+        active_lower_column,
+        jnp.maximum(sigma_centers, 0.0) ** _OCEAN_BULK_SHF_TAPER_POWER,
+        0.0,
+    )
+    valid_taper = (
+        jnp.all(jnp.isfinite(taper_weights))
+        & jnp.all(taper_weights >= 0.0)
+        & jnp.any(taper_weights > 0.0)
+    )
+    return jnp.where(valid_taper, taper_weights, jnp.zeros_like(taper_weights))
