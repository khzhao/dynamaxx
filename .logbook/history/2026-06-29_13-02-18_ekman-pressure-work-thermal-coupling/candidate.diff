+    assert float(jnp.min(nodal_delta[-1])) < 0.0
+    assert (
+        flat_lowest_temperature_delta[int(np.argmax(flat_log_pressure_increment))] > 0.0
+    )
+    assert (
+        flat_lowest_temperature_delta[int(np.argmin(flat_log_pressure_increment))] < 0.0
+    )
+    np.testing.assert_allclose(nodal_delta[0], 0.0, atol=2.0e-7)
+    np.testing.assert_allclose(layer_mean_delta, 0.0, atol=2.0e-7)
+    assert float(jnp.max(jnp.abs(nodal_delta))) <= temperature_increment_cap * 1.001
+
