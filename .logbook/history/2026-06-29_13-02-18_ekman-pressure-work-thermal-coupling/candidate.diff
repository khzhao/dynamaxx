+def test_ekman_pressure_work_adds_neutral_lower_layer_thermal_response():
+    """Dry pressure-work warms and cools lower layers with zero layer mean."""
+    coords, physics_specs, prev_state, next_state = _synthetic_ekman_coupled_state(
+        wind_scale=8.0,
+    )
+    reference_temperature = _reference_temperature(
+        layer_count=coords.vertical.layers,
+        temperature_kelvin=250.0,
+    )
+    incumbent_filter = _ekman_coupled_surface_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 900.0),
+    )
+    pressure_work_filter = _ekman_coupled_surface_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 900.0),
+        apply_pressure_work_temperature_response=True,
+    )
+
+    incumbent = incumbent_filter(prev_state, next_state)
+    corrected = pressure_work_filter(prev_state, next_state)
+
+    np.testing.assert_array_equal(corrected.vorticity, incumbent.vorticity)
+    np.testing.assert_array_equal(corrected.divergence, incumbent.divergence)
+    np.testing.assert_array_equal(
+        corrected.log_surface_pressure,
+        incumbent.log_surface_pressure,
+    )
+    modal_delta = corrected.temperature_variation - incumbent.temperature_variation
+    nodal_delta = coords.horizontal.to_nodal(modal_delta)
+    log_pressure_increment = coords.horizontal.to_nodal(
+        incumbent.log_surface_pressure - next_state.log_surface_pressure
+    )[0]
+    quadrature_weights = jnp.asarray(coords.horizontal.quadrature_weights)
+    layer_mean_delta = jnp.sum(
+        nodal_delta * quadrature_weights,
+        axis=(-2, -1),
+    ) / jnp.sum(quadrature_weights)
+    temperature_increment_cap = (
+        _EKMAN_PRESSURE_WORK_MAX_STEP_TEMPERATURE_INCREMENT_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+    )
+    flat_log_pressure_increment = np.asarray(log_pressure_increment).reshape(-1)
+    flat_lowest_temperature_delta = np.asarray(nodal_delta[-1]).reshape(-1)
+
+    assert float(jnp.max(jnp.abs(log_pressure_increment))) > 0.0
