+def test_exact_weak_held_suarez_relaxation_matches_analytic_temperature():
+    """The exact weak-HS step relaxes temperature to Teq with exp(-kt dt)."""
+    coords, physics_specs, reference_temperature = _analysis_offset_test_setup(
+        layer_count=2
+    )
+    equilibrium_offset = jnp.full(coords.nodal_shape, 0.25, dtype=jnp.float32)
+    state = _dinosaur_state_with_hs_equilibrium_offset(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        equilibrium_offset=equilibrium_offset,
+    )
+    forcing = _TracerSafeHeldSuarezForcingSigma(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        kf=0.0 / scales.units.day,
+        ka=1 / (160.0 * scales.units.day),
+        ks=1 / (16.0 * scales.units.day),
+    )
+    step_seconds = _nondimensionalize_seconds(physics_specs, 6.0 * SECONDS_PER_HOUR)
+    surface_pressure = jnp.exp(coords.horizontal.to_nodal(state.log_surface_pressure))
+    equilibrium_temperature = forcing.equilibrium_temperature(surface_pressure)
+
+    relaxed_state = _exact_weak_held_suarez_relaxation_step(
+        state,
+        forcing=forcing,
+        step_seconds=step_seconds,
+    )
+
+    relaxed_temperature = (
+        coords.horizontal.to_nodal(relaxed_state.temperature_variation)
+        + reference_temperature[:, np.newaxis, np.newaxis]
+    )
+    initial_temperature = (
+        coords.horizontal.to_nodal(state.temperature_variation)
+        + reference_temperature[:, np.newaxis, np.newaxis]
+    )
+    expected_temperature = equilibrium_temperature + (
+        (initial_temperature - equilibrium_temperature)
+        * jnp.exp(-forcing.kt() * step_seconds)
+    )
+    np.testing.assert_allclose(
+        relaxed_temperature,
+        expected_temperature,
+        rtol=2e-5,
+        atol=2e-5,
+    )
+    np.testing.assert_array_equal(relaxed_state.vorticity, state.vorticity)
+    np.testing.assert_array_equal(relaxed_state.divergence, state.divergence)
+    np.testing.assert_array_equal(
+        relaxed_state.log_surface_pressure,
+        state.log_surface_pressure,
+    )
+
