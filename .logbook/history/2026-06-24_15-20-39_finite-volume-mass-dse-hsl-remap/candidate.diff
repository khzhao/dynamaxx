+def test_finite_volume_mass_dse_remap_is_periodic_and_polar_finite():
+    """The FV-remap helper keeps periodic longitude and finite polar rows."""
+    coords, equation, _, _ = (
+        _finite_volume_mass_dse_remap_test_setup(
+            latitude_spacing="equiangular_with_poles",
+        )
+    )
+    longitude = jnp.asarray(coords.horizontal.longitudes, dtype=jnp.float32)[
+        :, jnp.newaxis
+    ]
+    latitude = jnp.asarray(coords.horizontal.latitudes, dtype=jnp.float32)[
+        jnp.newaxis, :
+    ]
+    longitude_wave = jnp.sin(longitude) + 0.25 * jnp.cos(2.0 * longitude)
+    latitude_wave = jnp.cos(latitude)
+    weighted_dse_anomaly = jnp.stack(
+        [
+            2.0 + longitude_wave + 0.2 * latitude_wave,
+            -0.5 + 0.3 * longitude_wave - 0.4 * latitude_wave,
+        ],
+        axis=0,
+    )
+    u_cos_lat = jnp.stack(
+        [
+            jnp.broadcast_to(2.0e-2 + 1.0e-3 * latitude_wave, coords.nodal_shape[1:]),
+            jnp.broadcast_to(-1.0e-2 + 5.0e-4 * latitude_wave, coords.nodal_shape[1:]),
+        ],
+        axis=0,
+    )
+    v_cos_lat = jnp.stack(
+        [
+            jnp.broadcast_to(-1.0e-2 + 6.0e-4 * latitude_wave, coords.nodal_shape[1:]),
+            jnp.broadcast_to(8.0e-3 - 2.0e-4 * latitude_wave, coords.nodal_shape[1:]),
+        ],
+        axis=0,
+    )
+    aux_state = _hsl_theta_aux_state(
+        coords,
+        u_cos_lat=u_cos_lat,
+        v_cos_lat=v_cos_lat,
+        temperature_variation=weighted_dse_anomaly,
+    )
+    remapped_weighted_dse_anomaly, valid_remap = (
+        equation._horizontal_semilagrangian_finite_volume_mass_dse_remap(
+            weighted_dse_anomaly,
+            aux_state,
+        )
+    )
+    tendency = equation.horizontal_semilagrangian_finite_volume_mass_dse_transport(
+        weighted_dse_anomaly,
+        aux_state,
+        incumbent_horizontal_tendency=jnp.zeros_like(weighted_dse_anomaly),
+    )
+    shifted_weighted_dse_anomaly = jnp.roll(weighted_dse_anomaly, shift=3, axis=1)
+    shifted_aux_state = _hsl_theta_aux_state(
+        coords,
+        u_cos_lat=jnp.roll(aux_state.cos_lat_u[0], shift=3, axis=1),
+        v_cos_lat=jnp.roll(aux_state.cos_lat_u[1], shift=3, axis=1),
+        temperature_variation=shifted_weighted_dse_anomaly,
+    )
+    shifted_remapped_weighted_dse_anomaly, shifted_valid_remap = (
+        equation._horizontal_semilagrangian_finite_volume_mass_dse_remap(
+            shifted_weighted_dse_anomaly,
+            shifted_aux_state,
+        )
+    )
+
+    assert bool(valid_remap)
+    assert bool(shifted_valid_remap)
+    assert bool(jnp.isfinite(tendency[:, :, 0]).all())
+    assert bool(jnp.isfinite(tendency[:, :, -1]).all())
+    np.testing.assert_allclose(
+        shifted_remapped_weighted_dse_anomaly,
+        jnp.roll(remapped_weighted_dse_anomaly, shift=3, axis=1),
+        rtol=1.0e-6,
+        atol=2.0e-6,
+    )
+
