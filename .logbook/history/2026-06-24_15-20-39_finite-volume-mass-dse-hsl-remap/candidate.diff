+def test_finite_volume_mass_dse_remap_preserves_layer_global_integral():
+    """The corrected remap preserves each layer's quadrature integral."""
+    coords, equation, aux_state, weighted_dse_anomaly = (
+        _finite_volume_mass_dse_remap_test_setup()
+    )
+
+    remapped_weighted_dse_anomaly, valid_remap = (
+        equation._horizontal_semilagrangian_finite_volume_mass_dse_remap(
+            weighted_dse_anomaly,
+            aux_state,
+        )
+    )
+
+    quadrature_weights = jnp.asarray(
+        coords.horizontal.quadrature_weights,
+        dtype=weighted_dse_anomaly.dtype,
+    )
+    original_integral = jnp.sum(
+        weighted_dse_anomaly * quadrature_weights,
+        axis=(-2, -1),
+    )
+    remapped_integral = jnp.sum(
+        remapped_weighted_dse_anomaly * quadrature_weights,
+        axis=(-2, -1),
+    )
+    assert bool(valid_remap)
+    np.testing.assert_allclose(
+        remapped_integral,
+        original_integral,
+        rtol=1.0e-6,
+        atol=1.0e-5,
+    )
