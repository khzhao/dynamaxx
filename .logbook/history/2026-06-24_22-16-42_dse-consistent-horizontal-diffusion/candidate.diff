@@ -2559,6 +2594,148 @@ def _horizontal_diffusion_step_filter(
     )
 
 
+def _dse_consistent_horizontal_diffusion_step_filter(
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+    orography: jax.Array,
+    step_seconds: float,
+    tau_seconds: float | None,
+    order: int,
+) -> Any:
+    """Return rollout diffusion that damps thermal DSE anomaly instead of T."""
+    incumbent_filter = _horizontal_diffusion_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        step_seconds=step_seconds,
+        tau_seconds=tau_seconds,
+        order=order,
+    )
+    tau = _horizontal_diffusion_tau(
+        coords=coords,
+        physics_specs=physics_specs,
+        tau_seconds=tau_seconds,
+    )
+    eigenvalues = coords.horizontal.laplacian_eigenvalues
+    scale = step_seconds / (tau * abs(eigenvalues[-1]) ** order)
+    modal_filter = filtering.horizontal_diffusion_filter(
+        coords.horizontal,
+        scale,
+        order,
+    )
+    diagnostic_equation = primitive_equations.PrimitiveEquations(
+        reference_temperature,
+        orography,
+        coords,
+        physics_specs,
+    )
+    quadrature_weights = jnp.asarray(coords.horizontal.quadrature_weights)
+    quadrature_weight_sum = jnp.sum(quadrature_weights)
+
+    def layer_mean(nodal_field: jax.Array) -> jax.Array:
+        weights = jnp.asarray(quadrature_weights, dtype=nodal_field.dtype)
+        return jnp.sum(nodal_field * weights, axis=(-2, -1)) / quadrature_weight_sum
+
+    def dse_consistent_horizontal_diffusion_filter(
+        prev_state: Any,
+        next_state: Any,
+    ) -> Any:
+        incumbent_state = incumbent_filter(prev_state, next_state)
+        if (
+            next_state.temperature_variation.shape != coords.modal_shape
+            or next_state.log_surface_pressure.shape != coords.surface_modal_shape
+        ):
+            return incumbent_state
+
+        aux_state = primitive_equations.compute_diagnostic_state_sigma(
+            next_state,
+            coords,
+        )
+        dry_static_energy_anomaly, geopotential = (
+            diagnostic_equation.nodal_dry_static_energy_anomaly(aux_state)
+        )
+        if (
+            dry_static_energy_anomaly.shape != coords.nodal_shape
+            or geopotential.shape != coords.nodal_shape
+        ):
+            return incumbent_state
+
+        dry_static_energy_anomaly = (
+            dry_static_energy_anomaly
+            - layer_mean(dry_static_energy_anomaly)[:, jnp.newaxis, jnp.newaxis]
+        )
+        dry_static_energy_modal = coords.horizontal.to_modal(
+            dry_static_energy_anomaly
+        )
+        if dry_static_energy_modal.shape != coords.modal_shape:
+            return incumbent_state
+
+        filtered_dry_static_energy_modal = modal_filter(dry_static_energy_modal)
+        if filtered_dry_static_energy_modal.shape != coords.modal_shape:
+            return incumbent_state
+
+        filtered_dry_static_energy_anomaly = coords.horizontal.to_nodal(
+            filtered_dry_static_energy_modal
+        )
+        if filtered_dry_static_energy_anomaly.shape != coords.nodal_shape:
+            return incumbent_state
+
+        filtered_dry_static_energy_anomaly = (
+            filtered_dry_static_energy_anomaly
+            - layer_mean(filtered_dry_static_energy_anomaly)[:, jnp.newaxis, jnp.newaxis]
+        )
+        temperature_increment = (
+            filtered_dry_static_energy_anomaly - dry_static_energy_anomaly
+        ) / diagnostic_equation.physics_specs.Cp
+        corrected_temperature_variation = (
+            next_state.temperature_variation
+            + coords.horizontal.to_modal(temperature_increment)
+        )
+        finite_diagnostics = jnp.all(
+            jnp.asarray(
+                [
+                    jnp.all(jnp.isfinite(dry_static_energy_anomaly)),
+                    jnp.all(jnp.isfinite(geopotential)),
+                    jnp.all(jnp.isfinite(dry_static_energy_modal)),
+                    jnp.all(jnp.isfinite(filtered_dry_static_energy_modal)),
+                    jnp.all(jnp.isfinite(filtered_dry_static_energy_anomaly)),
+                    jnp.all(jnp.isfinite(temperature_increment)),
+                    jnp.all(jnp.isfinite(corrected_temperature_variation)),
+                ]
+            )
+        )
+        temperature_variation = jnp.where(
+            finite_diagnostics,
+            corrected_temperature_variation,
+            incumbent_state.temperature_variation,
+        )
+        return _primitive_equation_state(
+            vorticity=incumbent_state.vorticity,
+            divergence=incumbent_state.divergence,
+            temperature_variation=temperature_variation,
+            log_surface_pressure=incumbent_state.log_surface_pressure,
+            tracers=incumbent_state.tracers,
+            sim_time=incumbent_state.sim_time,
+        )
+
+    return dse_consistent_horizontal_diffusion_filter
+
+
+def _horizontal_diffusion_tau(
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    tau_seconds: float | None,
+) -> float:
+    """Return the nondimensional horizontal diffusion damping timescale."""
+    if tau_seconds is None:
+        resolution_factor = coords.horizontal.latitude_nodes / 128.0
+        tau_hours = 8.6 / (2.4 ** np.log2(resolution_factor))
+        tau_seconds = tau_hours * 3600.0
+    return _nondimensionalize_seconds(physics_specs, tau_seconds)
+
+
