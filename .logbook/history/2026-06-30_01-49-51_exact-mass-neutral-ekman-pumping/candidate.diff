+def _bounded_surface_mass_neutral_logp_increment(
+    raw_log_pressure_increment: jax.Array,
+    surface_pressure: jax.Array,
+    max_abs_increment: jax.Array,
+    quadrature_weights: jax.Array,
+) -> jax.Array:
+    """Return a capped log-pressure increment that preserves surface mass."""
+    fallback_increment = _bounded_area_neutral_field(
+        raw_log_pressure_increment,
+        max_abs_increment,
+        quadrature_weights,
+    )
+    cap = jnp.asarray(
+        jnp.maximum(max_abs_increment, 0.0),
+        dtype=raw_log_pressure_increment.dtype,
+    )
+    surface_pressure = jnp.asarray(
+        surface_pressure,
+        dtype=raw_log_pressure_increment.dtype,
+    )
+    quadrature_weights = jnp.asarray(
+        quadrature_weights,
+        dtype=raw_log_pressure_increment.dtype,
+    )
+
+    def mass_residual(offset):
+        delta = jnp.clip(raw_log_pressure_increment - offset, -cap, cap)
+        pressure_increment = surface_pressure * jnp.expm1(delta)
+        return jnp.sum(quadrature_weights * pressure_increment, axis=(-2, -1))
+
+    lower_offset = jnp.min(raw_log_pressure_increment) - cap
+    upper_offset = jnp.max(raw_log_pressure_increment) + cap
+    lower_residual = mass_residual(lower_offset)
+    upper_residual = mass_residual(upper_offset)
+
+    def bisection_step(_, offsets):
+        lower, upper = offsets
+        midpoint = 0.5 * (lower + upper)
+        midpoint_residual = mass_residual(midpoint)
+        lower = jnp.where(midpoint_residual > 0.0, midpoint, lower)
+        upper = jnp.where(midpoint_residual > 0.0, upper, midpoint)
+        return lower, upper
+
+    lower_offset, upper_offset = jax.lax.fori_loop(
+        0,
+        40,
+        bisection_step,
+        (lower_offset, upper_offset),
+    )
+    neutral_offset = 0.5 * (lower_offset + upper_offset)
+    candidate_increment = jnp.clip(
+        raw_log_pressure_increment - neutral_offset,
+        -cap,
+        cap,
+    )
+    valid_inputs = (
+        jnp.all(jnp.isfinite(raw_log_pressure_increment))
+        & jnp.all(jnp.isfinite(surface_pressure))
+        & jnp.all(surface_pressure > 0.0)
+        & jnp.all(jnp.isfinite(quadrature_weights))
+        & jnp.isfinite(cap)
+        & jnp.isfinite(lower_offset)
+        & jnp.isfinite(upper_offset)
+        & jnp.isfinite(lower_residual)
+        & jnp.isfinite(upper_residual)
+        & (lower_offset <= upper_offset)
+        & (lower_residual >= 0.0)
+        & (upper_residual <= 0.0)
+        & jnp.all(jnp.isfinite(candidate_increment))
+        & (jnp.max(jnp.abs(raw_log_pressure_increment)) > 0.0)
+    )
+    return jnp.where(valid_inputs, candidate_increment, fallback_increment)
+
