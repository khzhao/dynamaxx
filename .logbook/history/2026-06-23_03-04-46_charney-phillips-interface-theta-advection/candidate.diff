+        sigma_dot_full: Array,
+        theta_anomaly: Array,
+        incumbent_vertical_tendency: Array,
+    ) -> Array:
+        """Return interface-sampled theta vertical advection with finite fallback."""
+        sigma_coords = self.coords.vertical
+        dtype = theta_anomaly.dtype
+        log_sigma_centers = jnp.log(jnp.asarray(sigma_coords.centers, dtype=dtype))
+        log_sigma_interfaces = jnp.log(
