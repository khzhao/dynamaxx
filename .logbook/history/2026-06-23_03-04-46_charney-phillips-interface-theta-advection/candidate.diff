+                    jnp.all(jnp.isfinite(internal_flux)),
+                    jnp.all(jnp.isfinite(flux_divergence)),
+                    jnp.all(jnp.isfinite(layer_thickness)),
+                    jnp.all(layer_thickness > 0),
