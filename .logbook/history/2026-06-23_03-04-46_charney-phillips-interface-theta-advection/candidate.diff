+        )
+        log_sigma_interface_targets = jnp.broadcast_to(
+            log_sigma_interfaces[:, np.newaxis, np.newaxis],
+            sigma_dot_full.shape,
+        )
+        interpolate_to_interfaces = vertical_interpolation.vectorize_vertical_interpolation(
+            vertical_interpolation.linear_interp_with_nearest_extrap
+        )
+        theta_interface = interpolate_to_interfaces(
+            log_sigma_interface_targets,
+            log_sigma_centers,
+            theta_anomaly,
+        )
+        layer_thickness = jnp.asarray(sigma_coords.layer_thickness, dtype=dtype)[
+            :, np.newaxis, np.newaxis
+        ]
+        column_mean_theta = (
+            jnp.sum(theta_anomaly * layer_thickness, axis=0, keepdims=True)
+            / jnp.sum(layer_thickness, axis=0, keepdims=True)
+        )
+        internal_flux = sigma_dot_full * (theta_interface - column_mean_theta)
+        flux_padding = [(0, 0)] * internal_flux.ndim
+        flux_padding[-3] = (1, 1)
+        padded_flux = jnp.pad(internal_flux, flux_padding)
+        flux_divergence = (
+            lax.slice_in_dim(padded_flux, 1, None, axis=-3)
+            - lax.slice_in_dim(padded_flux, 0, -1, axis=-3)
+        ) / layer_thickness
+        candidate_vertical_tendency = -flux_divergence
+        tendency_limit = jnp.asarray(
+            CHARNEY_PHILLIPS_THETA_VERTICAL_TENDENCY_MAX_RATIO,
+            dtype=dtype,
+        ) * jnp.maximum(
+            jnp.abs(incumbent_vertical_tendency),
+            jnp.asarray(
+                CHARNEY_PHILLIPS_THETA_VERTICAL_TENDENCY_ABSOLUTE_FLOOR,
+                dtype=dtype,
+            ),
+        )
+        bounded_vertical_tendency = jnp.where(
+            jnp.abs(candidate_vertical_tendency) <= tendency_limit,
+            candidate_vertical_tendency,
+            incumbent_vertical_tendency,
+        )
+        finite_candidate = jnp.all(
+            jnp.asarray(
+                [
