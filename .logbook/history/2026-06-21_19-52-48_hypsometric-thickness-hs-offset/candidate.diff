+def _hypsometric_thickness_analysis_held_suarez_equilibrium_offset(
+    *,
+    initial_state: WeatherState,
+    initialized_dinosaur_state: Any,
+    coords: coordinate_systems.CoordinateSystem,
+    pressure_levels_hpa: tuple[int, ...],
+    latitude_reversed: bool,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+    include_humidity: bool,
+    use_log_pressure_initialization: bool,
+) -> jax.Array:
+    """Return the thickness-derived analysis-HS offset with incumbent fallback."""
+    incumbent_offset = _analysis_offset_weak_held_suarez_equilibrium(
+        initialized_dinosaur_state,
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+    )
+    if len(pressure_levels_hpa) < 2 or not has_pressure_level_stack(
+        initial_state.variables,
+        GEOPOTENTIAL_VARIABLE,
+        pressure_levels_hpa,
+    ):
+        return incumbent_offset
+
+    analyzed_temperature = _stack_pressure_level_channels(
+        initial_state,
+        TEMPERATURE_VARIABLE,
+        pressure_levels_hpa,
+    )
+    geopotential = _stack_pressure_level_channels(
+        initial_state,
+        GEOPOTENTIAL_VARIABLE,
+        pressure_levels_hpa,
+    )
+    if geopotential.shape != analyzed_temperature.shape:
+        return incumbent_offset
+
+    specific_humidity = None
+    if has_pressure_level_stack(
+        initial_state.variables,
+        SPECIFIC_HUMIDITY_VARIABLE,
+        pressure_levels_hpa,
+    ):
+        specific_humidity = _stack_pressure_level_channels(
+            initial_state,
+            SPECIFIC_HUMIDITY_VARIABLE,
+            pressure_levels_hpa,
+        )
+        if specific_humidity.shape != analyzed_temperature.shape:
+            specific_humidity = None
+
+    thickness_temperature = _layer_mean_hydrostatic_temperature_from_geopotential_thickness(
+        analyzed_temperature=analyzed_temperature,
+        geopotential=geopotential,
+        pressure_levels_hpa=pressure_levels_hpa,
+        specific_humidity=specific_humidity,
+    )
+    temperature_channels = tuple(
+        f"{TEMPERATURE_VARIABLE}_{pressure_level}"
+        for pressure_level in pressure_levels_hpa
+    )
+    temperature_indices = jnp.asarray(
+        initial_state.variable_indices(temperature_channels),
+        dtype=jnp.int32,
+    )
+    thickness_state = WeatherState(
+        values=initial_state.values.at[temperature_indices].set(thickness_temperature),
+        variables=initial_state.variables,
+    )
+    thickness_dinosaur_state = weather_state_to_dinosaur_state(
+        thickness_state,
+        coords=coords,
+        pressure_levels_hpa=pressure_levels_hpa,
+        latitude_reversed=latitude_reversed,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        include_humidity=include_humidity,
+        use_log_pressure_initialization=use_log_pressure_initialization,
+    )
+    candidate_offset = _analysis_offset_weak_held_suarez_equilibrium(
+        thickness_dinosaur_state,
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
