+def test_tropical_wtg_mfc_gate_modulates_temperature_only_and_is_neutral():
+    """Finite low-level moist convergence changes only heat-neutral WTG weights."""
+    coords, physics_specs, prev_state, next_state = _synthetic_wtg_mass_dse_state()
+    reference_temperature = _reference_temperature(
+        layer_count=coords.vertical.layers,
+        temperature_kelvin=250.0,
+    )
+    longitude, sin_latitude = coords.horizontal.nodal_mesh
+    tropical_shape = 1.0 - sin_latitude**2
+    lower_humidity = 0.012 * tropical_shape * (1.0 + 0.25 * jnp.cos(longitude))
+    lower_convergence = tropical_shape * (1.0 + 0.75 * jnp.cos(longitude))
+    divergence_nodal = coords.horizontal.to_nodal(next_state.divergence)
+    divergence_nodal = divergence_nodal.at[coords.vertical.layers - 1].set(
+        -0.08 * lower_convergence
+    )
+    humidity_nodal = coords.horizontal.to_nodal(next_state.tracers["specific_humidity"])
+    humidity_nodal = humidity_nodal.at[coords.vertical.layers - 1].set(lower_humidity)
+    divergence = coords.horizontal.to_modal(divergence_nodal)
+    humidity = coords.horizontal.to_modal(humidity_nodal)
+    next_state = _primitive_equation_state(
+        vorticity=next_state.vorticity,
+        divergence=divergence,
+        temperature_variation=next_state.temperature_variation,
+        log_surface_pressure=next_state.log_surface_pressure,
+        tracers={"specific_humidity": humidity},
+        sim_time=next_state.sim_time,
+    )
+    prev_state = _primitive_equation_state(
+        vorticity=prev_state.vorticity,
+        divergence=divergence,
+        temperature_variation=prev_state.temperature_variation,
+        log_surface_pressure=prev_state.log_surface_pressure,
+        tracers={"specific_humidity": humidity},
+        sim_time=prev_state.sim_time,
+    )
+    incumbent_filter = _tropical_wtg_mass_dse_relaxation_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 3600.0),
+    )
+    gated_filter = _tropical_wtg_mass_dse_relaxation_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 3600.0),
+        use_moisture_convergence_gate=True,
+    )
+
+    incumbent = incumbent_filter(prev_state, next_state)
+    gated = gated_filter(prev_state, next_state)
+
+    incumbent_delta = coords.horizontal.to_nodal(
+        incumbent.temperature_variation - next_state.temperature_variation
+    )
+    gated_delta = coords.horizontal.to_nodal(
+        gated.temperature_variation - next_state.temperature_variation
+    )
+    assert float(jnp.max(jnp.abs(gated_delta - incumbent_delta))) > 1.0e-8
+    quadrature_weights = jnp.asarray(coords.horizontal.quadrature_weights)
+    layer_mean_delta = jnp.sum(
+        gated_delta * quadrature_weights, axis=(-2, -1)
+    ) / jnp.sum(quadrature_weights)
+    np.testing.assert_allclose(layer_mean_delta, 0.0, rtol=1e-6, atol=1e-6)
+    np.testing.assert_array_equal(gated.vorticity, next_state.vorticity)
+    np.testing.assert_array_equal(gated.divergence, next_state.divergence)
+    np.testing.assert_array_equal(
+        gated.log_surface_pressure,
+        next_state.log_surface_pressure,
+    )
+    assert gated.tracers.keys() == next_state.tracers.keys()
+    for tracer_name, tracer_value in gated.tracers.items():
+        np.testing.assert_array_equal(tracer_value, next_state.tracers[tracer_name])
+    np.testing.assert_array_equal(gated.sim_time, next_state.sim_time)
+
