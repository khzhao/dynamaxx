+def _moisture_convergence_wtg_sigma_envelope(
+    vertical_coords: sigma_coordinates.SigmaCoordinates,
+) -> jax.Array:
+    """Return the lower-tropospheric sigma support for the WTG gate."""
+    sigma = jnp.asarray(vertical_coords.centers)
+    upper_fraction = jnp.clip(
+        (sigma - _MOISTURE_CONVERGENCE_WTG_SIGMA_ZERO_TOP)
+        / (
+            _MOISTURE_CONVERGENCE_WTG_SIGMA_FULL_TOP
+            - _MOISTURE_CONVERGENCE_WTG_SIGMA_ZERO_TOP
+        ),
+        0.0,
+        1.0,
+    )
+    lower_fraction = jnp.clip(
+        (_MOISTURE_CONVERGENCE_WTG_SIGMA_ZERO_BOTTOM - sigma)
+        / (
+            _MOISTURE_CONVERGENCE_WTG_SIGMA_ZERO_BOTTOM
+            - _MOISTURE_CONVERGENCE_WTG_SIGMA_FULL_BOTTOM
+        ),
+        0.0,
+        1.0,
+    )
+    upper_taper = 0.5 * (1.0 - jnp.cos(jnp.pi * upper_fraction))
+    lower_taper = 0.5 * (1.0 - jnp.cos(jnp.pi * lower_fraction))
+    return jnp.where(
+        (sigma >= _MOISTURE_CONVERGENCE_WTG_SIGMA_FULL_TOP)
+        & (sigma <= _MOISTURE_CONVERGENCE_WTG_SIGMA_FULL_BOTTOM),
+        1.0,
+        upper_taper * lower_taper,
+    )
+
+
+def _moisture_convergence_gated_wtg_horizontal_envelope(
+    *,
+    latitude_envelope: jax.Array,
+    quadrature_weights: jax.Array,
+    vertical_coords: sigma_coordinates.SigmaCoordinates,
+    divergence: jax.Array,
+    specific_humidity: jax.Array,
+) -> jax.Array:
+    """Return WTG horizontal weights modulated by low-level moist convergence."""
+    dtype = latitude_envelope.dtype
+    divergence = jnp.asarray(divergence, dtype=dtype)
+    specific_humidity = jnp.asarray(specific_humidity, dtype=dtype)
+    quadrature_weights = jnp.asarray(quadrature_weights, dtype=dtype)
+    tropical_weights = latitude_envelope * quadrature_weights
+    tropical_weight_sum = jnp.sum(tropical_weights)
+    tiny_weight = jnp.asarray(jnp.finfo(dtype).tiny, dtype=dtype)
+    safe_tropical_weight_sum = jnp.where(
+        tropical_weight_sum > tiny_weight,
+        tropical_weight_sum,
+        jnp.ones_like(tropical_weight_sum),
+    )
+
+    sigma_envelope = _moisture_convergence_wtg_sigma_envelope(vertical_coords).astype(
+        dtype
+    )
+    layer_thickness = jnp.asarray(vertical_coords.layer_thickness, dtype=dtype)
+    vertical_weights = sigma_envelope * layer_thickness
+    vertical_weight_sum = jnp.sum(vertical_weights)
+
+    nonnegative_humidity = jnp.maximum(specific_humidity, 0.0)
+    convergence = jnp.maximum(-divergence, 0.0)
+    proxy = jnp.sum(
+        nonnegative_humidity
+        * convergence
+        * vertical_weights[:, jnp.newaxis, jnp.newaxis],
+        axis=0,
+    )
+    proxy_mean = jnp.sum(jnp.abs(proxy) * tropical_weights) / safe_tropical_weight_sum
+    proxy_epsilon = jnp.asarray(
+        _MOISTURE_CONVERGENCE_WTG_PROXY_EPSILON,
+        dtype=dtype,
+    )
+    normalized_proxy = proxy / (proxy_mean + proxy_epsilon)
+    raw_multiplier = _MOISTURE_CONVERGENCE_WTG_BASE_MULTIPLIER + (
+        _MOISTURE_CONVERGENCE_WTG_CONVERGENCE_MULTIPLIER
+        * normalized_proxy
+        / (1.0 + normalized_proxy)
+    )
+    multiplier_mean = (
+        jnp.sum(raw_multiplier * tropical_weights) / safe_tropical_weight_sum
+    )
+    safe_multiplier_mean = jnp.where(
+        multiplier_mean > tiny_weight,
+        multiplier_mean,
+        jnp.ones_like(multiplier_mean),
+    )
+    multiplier = raw_multiplier / safe_multiplier_mean
+    gate_is_usable = jnp.all(
+        jnp.asarray(
+            [
+                tropical_weight_sum > tiny_weight,
+                vertical_weight_sum > tiny_weight,
+                proxy_mean > proxy_epsilon,
+                jnp.all(jnp.isfinite(divergence)),
+                jnp.all(jnp.isfinite(specific_humidity)),
+                jnp.all(jnp.isfinite(proxy)),
+                jnp.all(jnp.isfinite(raw_multiplier)),
+                jnp.all(jnp.isfinite(multiplier)),
+                multiplier_mean > tiny_weight,
+            ]
+        )
+    )
+    return jnp.where(
+        gate_is_usable,
+        latitude_envelope * multiplier,
+        latitude_envelope,
+    )
+
