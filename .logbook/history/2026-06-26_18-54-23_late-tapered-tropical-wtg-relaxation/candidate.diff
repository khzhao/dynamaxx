+def _late_tropical_wtg_relaxation_taper(
+    sim_time: jax.Array | None,
+    physics_specs: Any,
+) -> jax.Array:
+    """Return the fixed forecast-age multiplier for late tropical WTG relaxation."""
+    if sim_time is None:
+        return jnp.asarray(1.0, dtype=jnp.float32)
+    sim_time = jnp.asarray(sim_time)
+    hour = _nondimensionalize_seconds(physics_specs, 3600.0)
+    start_time = jnp.asarray(_TROPICAL_WTG_TAPER_START_HOURS * hour)
+    end_time = jnp.asarray(_TROPICAL_WTG_TAPER_END_HOURS * hour)
+    taper_fraction = jnp.clip(
+        (sim_time - start_time) / (end_time - start_time),
+        0.0,
+        1.0,
+    )
+    smooth_fraction = taper_fraction * taper_fraction * (3.0 - 2.0 * taper_fraction)
+    scheduled_taper = 1.0 - (
+        (1.0 - _TROPICAL_WTG_LATE_RELAXATION_FRACTION) * smooth_fraction
+    )
+    valid_sim_time = jnp.isfinite(sim_time) & (sim_time >= 0.0)
+    return jnp.where(valid_sim_time, scheduled_taper, jnp.ones_like(scheduled_taper))
+
