+    )
+    weighted_dse_anomaly = layer_pressure_thickness * dse_anomaly
+    weighted_dse_tendency = jnp.full_like(weighted_dse_anomaly, 0.02)
+    pressure_thickness_tendency = jnp.full_like(layer_pressure_thickness, 0.001)
