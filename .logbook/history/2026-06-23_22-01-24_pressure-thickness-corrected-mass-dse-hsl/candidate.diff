+    )
+    aux_state = primitive_equations.compute_diagnostic_state_sigma(state, coords)
+    layer_pressure_thickness = candidate_equation.nodal_sigma_layer_pressure_thickness(
+        state
+    )
+    real_transport = candidate_equation.horizontal_semilagrangian_theta_transport
+    expected_tendency = (
+        incumbent_equation.temperature_tendency_potential_temperature_form(
+            state,
+            aux_state,
+        )
+    )
+
+    def nonfinite_pressure_thickness_transport(
+        scalar,
+        aux_state,
+        incumbent_horizontal_tendency,
+    ):
+        if np.allclose(np.asarray(scalar), np.asarray(layer_pressure_thickness)):
+            return jnp.full_like(incumbent_horizontal_tendency, jnp.nan)
+        return real_transport(scalar, aux_state, incumbent_horizontal_tendency)
+
+    monkeypatch.setattr(
