+                longitude_index_prev,
+                longitude_index_floor,
+                longitude_index_ceil,
+                longitude_index_next,
+            ),
+            axis=0,
+        )
+        latitude_stencil = jnp.stack(
+            (
+                latitude_index_prev,
+                latitude_index_floor,
+                latitude_index_ceil,
+                latitude_index_next,
+            ),
