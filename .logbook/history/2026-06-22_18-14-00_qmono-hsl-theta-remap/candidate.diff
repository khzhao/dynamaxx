+        def longitude_interpolated_row(latitude_index: Array) -> tuple[Array, Array]:
+            west_neighbor = scalar_layer[longitude_index_prev, latitude_index]
+            west = scalar_layer[longitude_index_floor, latitude_index]
+            east = scalar_layer[longitude_index_ceil, latitude_index]
+            east_neighbor = scalar_layer[longitude_index_next, latitude_index]
+            return _monotone_cubic_hermite_interpolate(
+                west_neighbor,
+                west,
+                east,
+                east_neighbor,
