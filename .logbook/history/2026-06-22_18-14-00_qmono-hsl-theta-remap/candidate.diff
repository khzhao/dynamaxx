+def _pchip_limited_derivative(
+    previous_delta: Array,
+    current_delta: Array,
+    previous_spacing: Array,
+    current_spacing: Array,
+) -> tuple[Array, Array]:
+    """Return a shape-preserving interior derivative and finite diagnostic."""
+    finite_inputs = (
+        jnp.isfinite(previous_delta)
+        & jnp.isfinite(current_delta)
+        & jnp.isfinite(previous_spacing)
+        & jnp.isfinite(current_spacing)
+        & (previous_spacing > 0)
+        & (current_spacing > 0)
+    )
+    same_sign = (
+        ((previous_delta > 0) & (current_delta > 0))
+        | ((previous_delta < 0) & (current_delta < 0))
+    )
+    active = finite_inputs & same_sign
+    safe_previous_delta = jnp.where(
+        active,
+        previous_delta,
+        jnp.ones_like(previous_delta),
+    )
+    safe_current_delta = jnp.where(
+        active,
+        current_delta,
+        jnp.ones_like(current_delta),
+    )
+    safe_previous_spacing = jnp.where(
+        finite_inputs,
+        previous_spacing,
+        jnp.ones_like(previous_spacing),
+    )
+    safe_current_spacing = jnp.where(
+        finite_inputs,
+        current_spacing,
+        jnp.ones_like(current_spacing),
+    )
+    previous_weight = 2.0 * safe_current_spacing + safe_previous_spacing
+    current_weight = safe_current_spacing + 2.0 * safe_previous_spacing
+    raw_derivative = (previous_weight + current_weight) / (
+        previous_weight / safe_previous_delta
+        + current_weight / safe_current_delta
+    )
+    derivative = jnp.where(
+        active & jnp.isfinite(raw_derivative),
+        raw_derivative,
+        jnp.zeros_like(raw_derivative),
+    )
+    finite_derivative = finite_inputs & jnp.isfinite(derivative)
+    return derivative, finite_derivative
+
+
+def _monotone_cubic_hermite_interpolate(
+    left_neighbor_value: Array,
+    left_value: Array,
+    right_value: Array,
+    right_neighbor_value: Array,
+    previous_spacing: Array,
+    interval_spacing: Array,
+    next_spacing: Array,
+    interval_weight: Array,
+) -> tuple[Array, Array]:
+    """Interpolate one interval with local PCHIP-style endpoint derivatives."""
+    finite_previous_spacing = (
+        jnp.isfinite(previous_spacing) & (previous_spacing > 0)
+    )
+    finite_interval_spacing = (
+        jnp.isfinite(interval_spacing) & (interval_spacing > 0)
+    )
+    finite_next_spacing = jnp.isfinite(next_spacing) & (next_spacing > 0)
+    safe_previous_spacing = jnp.where(
+        finite_previous_spacing,
+        previous_spacing,
+        jnp.ones_like(previous_spacing),
+    )
+    safe_interval_spacing = jnp.where(
+        finite_interval_spacing,
+        interval_spacing,
+        jnp.ones_like(interval_spacing),
+    )
+    safe_next_spacing = jnp.where(
+        finite_next_spacing,
+        next_spacing,
+        jnp.ones_like(next_spacing),
+    )
+    previous_delta = (left_value - left_neighbor_value) / safe_previous_spacing
+    interval_delta = (right_value - left_value) / safe_interval_spacing
+    next_delta = (right_neighbor_value - right_value) / safe_next_spacing
+    left_derivative, finite_left_derivative = _pchip_limited_derivative(
+        previous_delta,
+        interval_delta,
+        previous_spacing,
+        interval_spacing,
+    )
+    right_derivative, finite_right_derivative = _pchip_limited_derivative(
+        interval_delta,
+        next_delta,
+        interval_spacing,
+        next_spacing,
+    )
+
+    weight = jnp.clip(interval_weight, 0.0, 1.0)
+    weight_squared = weight * weight
+    weight_cubed = weight_squared * weight
+    left_basis = 2.0 * weight_cubed - 3.0 * weight_squared + 1.0
+    left_slope_basis = weight_cubed - 2.0 * weight_squared + weight
+    right_basis = -2.0 * weight_cubed + 3.0 * weight_squared
+    right_slope_basis = weight_cubed - weight_squared
+    interpolated_value = (
+        left_basis * left_value
+        + left_slope_basis * safe_interval_spacing * left_derivative
+        + right_basis * right_value
+        + right_slope_basis * safe_interval_spacing * right_derivative
+    )
+    finite_value = (
+        finite_left_derivative
+        & finite_right_derivative
+        & finite_interval_spacing
+        & jnp.isfinite(weight)
+        & jnp.isfinite(interpolated_value)
+    )
+    return interpolated_value, finite_value
