+
+
+def _qmono_local_stencil_extrema(
+    equation: primitive_equations.PrimitiveEquations,
+    scalar_layer: jax.Array,
+    longitude_displacement: jax.Array,
+    latitude_displacement: jax.Array,
+) -> tuple[jax.Array, jax.Array]:
+    """Return 4x4 local stencil extrema used by the qmono remap limiter."""
+    horizontal_grid = equation.coords.horizontal
+    longitude_values = np.asarray(horizontal_grid.longitudes, dtype=np.float32)
+    latitude_values = np.asarray(horizontal_grid.latitudes, dtype=np.float32)
+    longitude_count, latitude_count = horizontal_grid.nodal_shape
+    longitude_spacing = 2.0 * np.pi / longitude_count
+    longitude_origin = longitude_values[0]
+    longitude_mesh, latitude_mesh = np.meshgrid(
+        longitude_values,
+        latitude_values,
+        indexing="ij",
+    )
+    departure_longitude = (
+        np.mod(
+            longitude_mesh - np.asarray(longitude_displacement) - longitude_origin,
+            2.0 * np.pi,
+        )
+        + longitude_origin
+    )
+    longitude_index_floor = np.floor(
+        (departure_longitude - longitude_origin) / longitude_spacing
+    ).astype(np.int32)
+    longitude_index_floor = np.mod(longitude_index_floor, longitude_count)
+    longitude_stencil = np.stack(
+        (
+            np.mod(longitude_index_floor - 1, longitude_count),
+            longitude_index_floor,
+            np.mod(longitude_index_floor + 1, longitude_count),
+            np.mod(longitude_index_floor + 2, longitude_count),
+        ),
+        axis=0,
+    )
+
+    departure_latitude = np.clip(
+        latitude_mesh - np.asarray(latitude_displacement),
+        latitude_values[0],
+        latitude_values[-1],
+    )
+    latitude_index_floor = (
+        np.searchsorted(latitude_values, departure_latitude, side="right") - 1
+    )
+    latitude_index_floor = np.clip(
+        latitude_index_floor,
+        0,
+        latitude_count - 2,
+    ).astype(np.int32)
+    latitude_stencil = np.stack(
+        (
+            np.clip(latitude_index_floor - 1, 0, latitude_count - 1),
+            latitude_index_floor,
+            latitude_index_floor + 1,
+            np.clip(latitude_index_floor + 2, 0, latitude_count - 1),
+        ),
+        axis=0,
+    )
+
+    scalar_values = np.asarray(scalar_layer)
+    stencil_values = scalar_values[
+        longitude_stencil[:, np.newaxis, :, :],
+        latitude_stencil[np.newaxis, :, :, :],
+    ]
+    return (
+        jnp.asarray(np.min(stencil_values, axis=(0, 1))),
+        jnp.asarray(np.max(stencil_values, axis=(0, 1))),
+    )
+
