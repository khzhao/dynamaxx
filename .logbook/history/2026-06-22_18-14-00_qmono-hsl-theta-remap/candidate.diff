+        row_prev, finite_row_prev = longitude_interpolated_row(latitude_index_prev)
+        row_lower, finite_row_lower = longitude_interpolated_row(latitude_index_floor)
+        row_upper, finite_row_upper = longitude_interpolated_row(latitude_index_ceil)
+        row_next, finite_row_next = longitude_interpolated_row(latitude_index_next)
+        qmono_value, finite_latitude_value = _monotone_cubic_hermite_interpolate(
+            row_prev,
+            row_lower,
+            row_upper,
+            row_next,
+            latitude_spacing_prev,
+            latitude_spacing_center,
+            latitude_spacing_next,
+            latitude_index_weight,
+        )
+
+        longitude_stencil = jnp.stack(
