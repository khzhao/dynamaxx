+    @jax.named_call
+    def _mean_neutral_semilagrangian_theta_tendency_or_uncorrected(
+        self,
+        theta_anomaly: Array,
+        remapped_theta_anomaly: Array,
+        uncorrected_horizontal_tendency: Array,
+        step: Array,
+    ) -> Array:
+        """Remove layerwise horizontal theta-mean increments when finite."""
+        if not self.use_mean_neutral_semilagrangian_theta_transport:
+            return uncorrected_horizontal_tendency
+
+        weights = jnp.asarray(
+            self.coords.horizontal.quadrature_weights,
+            dtype=theta_anomaly.dtype,
+        )
+        weight_sum = jnp.sum(weights)
+        theta_increment = remapped_theta_anomaly - theta_anomaly
+        layer_mean_increment = (
+            jnp.sum(theta_increment * weights, axis=(-2, -1)) / weight_sum
+        )
+        corrected_remapped_theta_anomaly = (
+            remapped_theta_anomaly - layer_mean_increment[:, jnp.newaxis, jnp.newaxis]
+        )
+        corrected_horizontal_tendency = (
+            corrected_remapped_theta_anomaly - theta_anomaly
+        ) / step
+        tendency_mean_residual = (
+            jnp.sum(corrected_horizontal_tendency * weights, axis=(-2, -1))
+            / weight_sum
+        )
+        corrected_horizontal_tendency = (
+            corrected_horizontal_tendency
+            - tendency_mean_residual[:, jnp.newaxis, jnp.newaxis]
+        )
+        valid_correction = jnp.all(
+            jnp.asarray(
+                [
+                    jnp.all(jnp.isfinite(weights)),
+                    jnp.isfinite(weight_sum),
+                    weight_sum > 0.0,
+                    jnp.all(jnp.isfinite(layer_mean_increment)),
+                    jnp.all(jnp.isfinite(corrected_remapped_theta_anomaly)),
+                    jnp.all(jnp.isfinite(tendency_mean_residual)),
+                    jnp.all(jnp.isfinite(corrected_horizontal_tendency)),
+                ]
+            )
+        )
+        return jnp.where(
+            valid_correction,
+            corrected_horizontal_tendency,
+            uncorrected_horizontal_tendency,
+        )
+
