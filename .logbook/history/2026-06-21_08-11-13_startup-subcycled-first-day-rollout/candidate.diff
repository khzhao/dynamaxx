+def _startup_subcycled_first_day_trajectory_from_step(
+    *,
+    incumbent_step_fn: Any,
+    startup_step_fn: Any,
+    output_count: int,
+    incumbent_inner_steps: int,
+    startup_inner_steps: int,
+    startup_outer_steps: int,
+) -> Any:
+    """Return a trajectory that subcycles only the first positive forecast day."""
+    assert output_count >= 1
+    assert incumbent_inner_steps >= 1
+    assert startup_inner_steps == incumbent_inner_steps * _STARTUP_SUBCYCLE_FACTOR
+    assert startup_outer_steps >= 1
+
+    incumbent_outer_step = time_integration.repeated(
+        incumbent_step_fn,
+        incumbent_inner_steps,
+    )
+    startup_outer_step = time_integration.repeated(
+        startup_step_fn,
+        startup_inner_steps,
+    )
+    startup_prefix_fn = time_integration.trajectory_from_step(
+        startup_outer_step,
+        outer_steps=startup_outer_steps,
+        inner_steps=1,
+        start_with_input=True,
+    )
+    incumbent_prefix_fn = time_integration.trajectory_from_step(
+        incumbent_outer_step,
+        outer_steps=startup_outer_steps,
+        inner_steps=1,
+        start_with_input=True,
+    )
+
+    def trajectory_fn(dinosaur_state):
+        startup_day_one_state, startup_before_day_one = startup_prefix_fn(
+            dinosaur_state
+        )
+        incumbent_day_one_state, incumbent_before_day_one = incumbent_prefix_fn(
+            dinosaur_state
+        )
+        startup_is_finite = jnp.logical_and(
+            _pytree_is_finite(startup_before_day_one),
+            _pytree_is_finite(startup_day_one_state),
+        )
+        first_day_trajectory = _append_state_to_trajectory(
+            _where_pytree(
+                startup_is_finite,
+                startup_before_day_one,
+                incumbent_before_day_one,
+            ),
+            _where_pytree(
+                startup_is_finite,
+                startup_day_one_state,
+                incumbent_day_one_state,
+            ),
+        )
+
+        if output_count <= startup_outer_steps:
+            trajectory = _take_trajectory(first_day_trajectory, output_count)
+            final_state = _trajectory_state_at(first_day_trajectory, output_count)
+            return final_state, trajectory
+        if output_count == startup_outer_steps + 1:
+            final_state = incumbent_outer_step(
+                _trajectory_state_at(first_day_trajectory, startup_outer_steps)
+            )
+            return final_state, first_day_trajectory
+
+        day_one_state = _trajectory_state_at(first_day_trajectory, startup_outer_steps)
+        continuation_frame_count = output_count - startup_outer_steps - 1
+        continuation_fn = time_integration.trajectory_from_step(
+            incumbent_outer_step,
+            outer_steps=continuation_frame_count + 1,
+            inner_steps=1,
+            start_with_input=False,
+        )
+        final_state, continuation_with_extra = continuation_fn(day_one_state)
+        continuation = _take_trajectory(
+            continuation_with_extra,
+            continuation_frame_count,
+        )
+        return final_state, _concatenate_trajectories(
+            first_day_trajectory,
+            continuation,
+        )
+
+    return trajectory_fn
+
+
+def _pytree_is_finite(pytree: Any) -> jax.Array:
+    """Return a scalar boolean indicating whether every array leaf is finite."""
+    finite_leaves = [
+        jnp.all(jnp.isfinite(jnp.asarray(leaf)))
+        for leaf in jax.tree_util.tree_leaves(pytree)
+    ]
+    if not finite_leaves:
+        return jnp.asarray(True)
+    return jnp.all(jnp.stack(finite_leaves))
+
+
+def _where_pytree(condition: jax.Array, true_pytree: Any, false_pytree: Any) -> Any:
+    return jax.tree_util.tree_map(
+        lambda true_leaf, false_leaf: jnp.where(condition, true_leaf, false_leaf),
+        true_pytree,
+        false_pytree,
+    )
+
+
+def _append_state_to_trajectory(trajectory: Any, state: Any) -> Any:
+    state_trajectory = jax.tree_util.tree_map(
+        lambda leaf: leaf[jnp.newaxis, ...],
+        state,
+    )
+    return _concatenate_trajectories(trajectory, state_trajectory)
+
+
+def _concatenate_trajectories(*trajectories: Any) -> Any:
+    return jax.tree_util.tree_map(
+        lambda *leaves: jnp.concatenate(leaves, axis=0),
+        *trajectories,
+    )
+
+
+def _take_trajectory(trajectory: Any, count: int) -> Any:
+    return jax.tree_util.tree_map(lambda leaf: leaf[:count], trajectory)
+
+
+def _trajectory_state_at(trajectory: Any, index: int) -> Any:
+    return jax.tree_util.tree_map(lambda leaf: leaf[index], trajectory)
+
