+    """The midpoint ramp alias adds only the midpoint timing selector."""
+    model = create_dycore_model("dino_hsl2_mass_dse_wtg_vdse_ramp_midtime")
+    incumbent = create_dycore_model("dino_hsl2_mass_dse_wtg_vdse_ramp")
