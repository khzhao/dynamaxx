+    )
+    aux_state = primitive_equations.compute_diagnostic_state_sigma(
+        timed_state,
+        coords,
+    )
+    captured_ramp_times = []
+
+    def record_ramp_time(sim_time, physics_specs_arg):
+        assert physics_specs_arg is physics_specs
+        captured_ramp_times.append(jnp.asarray(sim_time))
+        return jnp.asarray(0.0, dtype=jnp.asarray(sim_time).dtype)
+
+    def zero_vertical_tendency(unused_sigma_dot, scalar):
+        del unused_sigma_dot
+        return jnp.zeros_like(scalar)
+
+    monkeypatch.setattr(
+        primitive_equations,
+        "_pressure_ramped_vertical_dse_increment_weight",
+        record_ramp_time,
+    )
+    common_kwargs = {
+        "reference_temperature": reference_temperature,
+        "orography": jnp.zeros(coords.horizontal.modal_shape, dtype=jnp.float32),
+        "coords": coords,
+        "physics_specs": cast(Any, physics_specs),
+        "include_vertical_advection": True,
+        "temperature_tendency_formulation": (
+            primitive_equations.TEMPERATURE_TENDENCY_FORMULATION_POTENTIAL_TEMPERATURE
+        ),
+        "use_dry_static_energy_hsl_transport": True,
+        "use_layer_mass_weighted_dse_hsl_transport": True,
+        "use_pressure_ramped_vertical_dse_increment": True,
+        "horizontal_semilagrangian_theta_transport_step": step_seconds,
+    }
+    start_time_equation = primitive_equations.PrimitiveEquations(**common_kwargs)
+    midpoint_equation = primitive_equations.PrimitiveEquations(
+        **common_kwargs,
+        use_midpoint_pressure_ramped_vertical_dse_timing=True,
+    )
+    monkeypatch.setattr(
+        start_time_equation,
+        "_vertical_tendency",
+        zero_vertical_tendency,
+    )
+    monkeypatch.setattr(
+        midpoint_equation,
+        "_vertical_tendency",
+        zero_vertical_tendency,
+    )
+
+    for equation in (start_time_equation, midpoint_equation):
