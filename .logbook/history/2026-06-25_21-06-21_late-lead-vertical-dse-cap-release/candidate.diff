+    late_cap_tendency = (
+        primitive_equations.PRESSURE_RAMPED_VERTICAL_DSE_LATE_MAX_STEP_TEMPERATURE_INCREMENT_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+        / step_seconds
+    )
+    return (
+        coords.horizontal.to_nodal(capped_tendency),
