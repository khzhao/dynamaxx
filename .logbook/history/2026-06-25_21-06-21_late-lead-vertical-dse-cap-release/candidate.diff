+def _pressure_ramped_vertical_dse_late_cap_kelvin(
+    sim_time: Array,
+    physics_specs: units.SimUnitsProtocol,
+) -> jax.Array:
+    """Return the safe late-lead per-step vertical-DSE cap in kelvin."""
+    sim_time = jnp.asarray(sim_time)
+    base_cap_kelvin = jnp.asarray(
+        PRESSURE_RAMPED_VERTICAL_DSE_MAX_STEP_TEMPERATURE_INCREMENT_KELVIN,
+        dtype=sim_time.dtype,
+    )
+    late_cap_kelvin = jnp.asarray(
+        PRESSURE_RAMPED_VERTICAL_DSE_LATE_MAX_STEP_TEMPERATURE_INCREMENT_KELVIN,
+        dtype=sim_time.dtype,
+    )
+    hour = scales.units.Quantity(3600.0, "second")
+    nondimensional_hour = jnp.asarray(
+        physics_specs.nondimensionalize(hour),
+        dtype=sim_time.dtype,
+    )
+    cap_start_time = (
+        PRESSURE_RAMPED_VERTICAL_DSE_LATE_CAP_START_HOURS * nondimensional_hour
+    )
+    cap_full_time = (
+        PRESSURE_RAMPED_VERTICAL_DSE_LATE_CAP_FULL_HOURS * nondimensional_hour
+    )
+    release_duration = cap_full_time - cap_start_time
+    valid_schedule = (
+        jnp.all(jnp.isfinite(sim_time))
+        & jnp.all(jnp.isfinite(nondimensional_hour))
+        & jnp.isfinite(cap_start_time)
+        & jnp.isfinite(cap_full_time)
+        & jnp.isfinite(release_duration)
+        & (release_duration > 0.0)
+        & jnp.isfinite(base_cap_kelvin)
+        & jnp.isfinite(late_cap_kelvin)
+        & (late_cap_kelvin >= base_cap_kelvin)
+    )
+    safe_duration = jnp.where(
+        valid_schedule,
+        release_duration,
+        jnp.ones_like(release_duration),
+    )
+    release_fraction = jnp.clip(
+        (sim_time - cap_start_time) / safe_duration,
+        0.0,
+        1.0,
+    )
+    smooth_release = (
+        release_fraction * release_fraction * (3.0 - 2.0 * release_fraction)
+    )
+    scheduled_cap_kelvin = base_cap_kelvin + (
+        (late_cap_kelvin - base_cap_kelvin) * smooth_release
+    )
+    bounded_cap_kelvin = jnp.clip(
+        scheduled_cap_kelvin,
+        base_cap_kelvin,
+        late_cap_kelvin,
+    )
+    return jnp.where(valid_schedule, bounded_cap_kelvin, base_cap_kelvin)
+
