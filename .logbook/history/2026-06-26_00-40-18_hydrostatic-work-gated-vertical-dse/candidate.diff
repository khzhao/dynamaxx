+def test_hydrostatic_work_gate_preserves_column_neutral_increment(monkeypatch):
+    """Pressure-weighted column-neutral increments pass through the gate."""
+    (
+        coords,
+        physics_specs,
+        timed_state,
+        ramp_equation,
+        aux_state,
+        layer_pressure_thickness,
+        max_tendency,
+    ) = _pressure_ramped_vertical_dse_direct_test_context(
+        use_hydrostatic_work_gate=False,
+    )
+    gated_equation = _pressure_ramped_vertical_dse_direct_test_context(
+        use_hydrostatic_work_gate=True,
+    )[3]
+    layer_pattern = jnp.linspace(
+        -1.0,
+        1.0,
+        coords.vertical.layers,
+        dtype=jnp.float32,
+    )[:, jnp.newaxis, jnp.newaxis]
+    column_weight_sum = jnp.sum(layer_pressure_thickness, axis=0, keepdims=True)
+    weighted_pattern_mean = (
+        jnp.sum(layer_pressure_thickness * layer_pattern, axis=0, keepdims=True)
+        / column_weight_sum
+    )
+    neutral_increment = (
+        layer_pattern - weighted_pattern_mean
+    ) * jnp.asarray(max_tendency * 0.2, dtype=jnp.float32)
+
+    def neutral_vertical_tendency(unused_sigma_dot, scalar):
+        del unused_sigma_dot, scalar
+        return neutral_increment * physics_specs.Cp
+
+    monkeypatch.setattr(ramp_equation, "_vertical_tendency", neutral_vertical_tendency)
+    monkeypatch.setattr(
+        gated_equation,
+        "_vertical_tendency",
+        neutral_vertical_tendency,
+    )
+    common_kwargs = {
+        "state": timed_state,
+        "aux_state": aux_state,
+        "incumbent_temperature_tendency": jnp.zeros(
