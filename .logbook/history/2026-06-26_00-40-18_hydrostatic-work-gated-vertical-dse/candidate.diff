+def _pressure_ramped_vertical_dse_hydrostatic_work_gated_increment(
+    pressure_guarded_increment: Array,
+    layer_pressure_thickness: Array,
+    valid_layer_pressure_thickness: Array,
+) -> tuple[jax.Array, jax.Array]:
+    """Damp column-net vertical-DSE work while preserving vertical residuals."""
+    increment_dtype = pressure_guarded_increment.dtype
+    zero = jnp.asarray(0.0, dtype=increment_dtype)
+    one = jnp.asarray(1.0, dtype=increment_dtype)
+    safe_layer_pressure_thickness = jnp.where(
+        valid_layer_pressure_thickness,
+        layer_pressure_thickness,
+        zero,
+    )
+    column_pressure_thickness = jnp.sum(
+        safe_layer_pressure_thickness,
+        axis=0,
+        keepdims=True,
+    )
+    tiny_pressure_thickness = jnp.asarray(
+        jnp.finfo(layer_pressure_thickness.dtype).tiny,
+        dtype=layer_pressure_thickness.dtype,
+    )
+    valid_column_pressure_thickness = (
+        jnp.isfinite(column_pressure_thickness)
+        & (column_pressure_thickness > tiny_pressure_thickness)
+    )
+    safe_column_pressure_thickness = jnp.where(
+        valid_column_pressure_thickness,
+        column_pressure_thickness,
+        one,
+    )
+    column_mean_increment = (
+        jnp.sum(
+            safe_layer_pressure_thickness * pressure_guarded_increment,
+            axis=0,
+            keepdims=True,
+        )
+        / safe_column_pressure_thickness
+    )
+    vertical_residual_increment = (
+        pressure_guarded_increment - column_mean_increment
+    )
+    mean_square_increment = (
+        jnp.sum(
+            safe_layer_pressure_thickness * pressure_guarded_increment**2,
+            axis=0,
+            keepdims=True,
+        )
+        / safe_column_pressure_thickness
+    )
+    rms_vertical_increment = jnp.sqrt(jnp.maximum(mean_square_increment, zero))
+    epsilon = jnp.asarray(
+        PRESSURE_RAMPED_VERTICAL_DSE_HYDROSTATIC_WORK_EPSILON,
+        dtype=increment_dtype,
+    )
+    raw_work_ratio = jnp.abs(column_mean_increment) / (
+        rms_vertical_increment + epsilon
+    )
+    bounded_work_ratio = jnp.clip(
+        raw_work_ratio,
+        zero,
+        jnp.asarray(
+            PRESSURE_RAMPED_VERTICAL_DSE_HYDROSTATIC_WORK_RATIO_LIMIT,
+            dtype=increment_dtype,
+        ),
+    )
+    ratio_keep = jnp.asarray(
+        PRESSURE_RAMPED_VERTICAL_DSE_HYDROSTATIC_WORK_RATIO_KEEP,
+        dtype=increment_dtype,
+    )
+    ratio_zero = jnp.asarray(
+        PRESSURE_RAMPED_VERTICAL_DSE_HYDROSTATIC_WORK_RATIO_ZERO,
+        dtype=increment_dtype,
+    )
+    work_fraction = jnp.clip(
+        (bounded_work_ratio - ratio_keep) / (ratio_zero - ratio_keep),
+        zero,
+        one,
+    )
+    smooth_work_fraction = work_fraction * work_fraction * (
+        3.0 - 2.0 * work_fraction
+    )
+    column_mean_weight = one - smooth_work_fraction
+    blended_increment = (
+        vertical_residual_increment + column_mean_weight * column_mean_increment
+    )
+    finite_gate_diagnostics = jnp.all(
+        jnp.asarray(
+            [
+                jnp.all(valid_layer_pressure_thickness),
+                jnp.all(jnp.isfinite(layer_pressure_thickness)),
+                jnp.all(valid_column_pressure_thickness),
+                jnp.all(jnp.isfinite(column_mean_increment)),
+                jnp.all(jnp.isfinite(vertical_residual_increment)),
+                jnp.all(jnp.isfinite(mean_square_increment)),
+                jnp.all(mean_square_increment >= 0.0),
+                jnp.all(jnp.isfinite(raw_work_ratio)),
+                jnp.all(jnp.isfinite(bounded_work_ratio)),
+                jnp.all(bounded_work_ratio >= 0.0),
+                jnp.all(
+                    bounded_work_ratio
+                    <= PRESSURE_RAMPED_VERTICAL_DSE_HYDROSTATIC_WORK_RATIO_LIMIT
+                ),
+                jnp.all(jnp.isfinite(column_mean_weight)),
+                jnp.all(column_mean_weight >= 0.0),
+                jnp.all(column_mean_weight <= 1.0),
+                jnp.all(jnp.isfinite(blended_increment)),
+            ]
+        )
+    )
+    return blended_increment, finite_gate_diagnostics
