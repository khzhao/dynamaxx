+    surface_pressure = surface_pressure_hpa * 100.0 * pressure_factor
+    temperature = jnp.full((1, 3, 2, 2), 280.0, dtype=jnp.float32)
+    incumbent_temperature = jnp.full((1, 3, 2, 2), 260.0, dtype=jnp.float32)
+    incumbent_geopotential = jnp.full((1, 3, 2, 2), 1234.0, dtype=jnp.float32)
+    incumbent_pressure_fields = {
+        "temperature": incumbent_temperature,
+        "u_component_of_wind": jnp.zeros((1, 3, 2, 2), dtype=jnp.float32),
+        "v_component_of_wind": jnp.zeros((1, 3, 2, 2), dtype=jnp.float32),
+        "geopotential": incumbent_geopotential,
+    }
+
+    actual = _theta_hydrostatic_pressure_output_fields(
+        temperature=temperature,
+        specific_humidity=None,
+        incumbent_pressure_fields=incumbent_pressure_fields,
+        pressure_levels_hpa=pressure_levels_hpa,
+        surface_pressure=surface_pressure,
+        surface_pressure_hpa=surface_pressure_hpa,
+        sigma_coords=sigma_coords,
+        physics_specs=physics_specs,
+        horizontal_shape=(2, 2),
+    )
+
+    np.testing.assert_array_equal(
+        actual["temperature"][:, :, 0, 1],
+        incumbent_temperature[:, :, 0, 1],
+    )
+    np.testing.assert_array_equal(
+        actual["geopotential"][:, :, 0, 1],
+        incumbent_geopotential[:, :, 0, 1],
+    )
+    assert bool(jnp.all(actual["temperature"][:, :, 0, 0] != incumbent_temperature[:, :, 0, 0]))
+    assert bool(jnp.isfinite(actual["temperature"]).all())
+    assert bool(jnp.isfinite(actual["geopotential"]).all())
