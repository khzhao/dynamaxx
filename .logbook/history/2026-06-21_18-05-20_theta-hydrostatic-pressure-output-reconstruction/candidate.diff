+    specific_humidity: jax.Array | None,
+    incumbent_pressure_fields: dict[str, jax.Array],
+    pressure_levels_hpa: tuple[int, ...],
+    surface_pressure: jax.Array,
+    surface_pressure_hpa: jax.Array,
+    sigma_coords: sigma_coordinates.SigmaCoordinates,
+    physics_specs: Any,
+    horizontal_shape: tuple[int, int],
+) -> dict[str, jax.Array]:
+    """Reconstruct pressure-level temperature and geopotential from one column.
+
+    The pressure diagnostics use Dinosaur nondimensional pressure units for the
+    dry-theta conversion, while the existing sigma-to-pressure interpolation
+    helper keeps hPa coordinates for vertical indexing. If any column diagnostic
+    is nonfinite or nonpositive, that column keeps the incumbent pressure-field
+    values for both reconstructed variables.
+    """
+    sigma_centers = jnp.asarray(sigma_coords.centers, dtype=temperature.dtype)[
+        :, jnp.newaxis, jnp.newaxis
+    ]
+    pressure_factor = _unit_factor(physics_specs, "pascal")
+    requested_pressure = (
+        jnp.asarray(pressure_levels_hpa, dtype=temperature.dtype)
+        * jnp.asarray(100.0 * pressure_factor, dtype=temperature.dtype)
+    )[:, jnp.newaxis, jnp.newaxis]
+    reference_pressure = jnp.asarray(
+        100000.0 * pressure_factor,
+        dtype=temperature.dtype,
+    )
+    sigma_pressure = sigma_centers[jnp.newaxis, ...] * surface_pressure[:, jnp.newaxis]
+    pressure_is_valid = jnp.all(
+        jnp.isfinite(sigma_pressure) & (sigma_pressure > 0.0),
+        axis=1,
+    )
+    safe_surface_pressure_hpa = jnp.where(
+        jnp.isfinite(surface_pressure_hpa) & (surface_pressure_hpa > 0.0),
+        surface_pressure_hpa,
+        jnp.ones_like(surface_pressure_hpa) * 1000.0,
+    )
+
+    theta_on_sigma = primitive_equations.potential_temperature_from_temperature(
+        temperature,
+        sigma_pressure,
+        reference_pressure,
+        physics_specs.kappa,
+    )
+    theta_fields = _interp_sigma_to_pressure_by_time(
+        {TEMPERATURE_VARIABLE: theta_on_sigma},
+        _pressure_coordinates(pressure_levels_hpa),
+        sigma_coords,
+        safe_surface_pressure_hpa,
+    )
+    theta_on_pressure = theta_fields[TEMPERATURE_VARIABLE]
+    reconstructed_temperature = (
+        primitive_equations.temperature_from_potential_temperature(
+            theta_on_pressure,
+            requested_pressure[jnp.newaxis, ...],
+            reference_pressure,
+            physics_specs.kappa,
+        )
+    )
+    reconstructed_geopotential_on_sigma = primitive_equations.get_geopotential_on_sigma(
+        temperature,
+        specific_humidity=specific_humidity,
+        nodal_orography=jnp.zeros(horizontal_shape, dtype=temperature.dtype),
+        sigma=sigma_coords,
+        gravity_acceleration=physics_specs.g,
+        ideal_gas_constant=physics_specs.R,
+        water_vapor_gas_constant=physics_specs.R_vapor,
+    )
+    geopotential_fields = _interp_sigma_to_pressure_by_time(
+        {GEOPOTENTIAL_VARIABLE: reconstructed_geopotential_on_sigma},
+        _pressure_coordinates(pressure_levels_hpa),
+        sigma_coords,
+        safe_surface_pressure_hpa,
+    )
+    reconstructed_geopotential = geopotential_fields[GEOPOTENTIAL_VARIABLE]
+
+    finite_inputs = jnp.all(jnp.isfinite(temperature), axis=1) & pressure_is_valid
+    if specific_humidity is not None:
+        finite_inputs = finite_inputs & jnp.all(jnp.isfinite(specific_humidity), axis=1)
+    finite_reconstruction = (
+        finite_inputs
+        & jnp.all(jnp.isfinite(theta_on_sigma), axis=1)
+        & jnp.all(jnp.isfinite(theta_on_pressure), axis=1)
+        & jnp.all(jnp.isfinite(reconstructed_temperature), axis=1)
+        & jnp.all(jnp.isfinite(reconstructed_geopotential_on_sigma), axis=1)
+        & jnp.all(jnp.isfinite(reconstructed_geopotential), axis=1)
+        & jnp.all(jnp.isfinite(requested_pressure) & (requested_pressure > 0.0))
+    )
+    finite_reconstruction = finite_reconstruction[:, jnp.newaxis, ...]
+
+    pressure_fields = dict(incumbent_pressure_fields)
+    pressure_fields[TEMPERATURE_VARIABLE] = jnp.where(
+        finite_reconstruction,
+        reconstructed_temperature,
+        incumbent_pressure_fields[TEMPERATURE_VARIABLE],
+    )
+    pressure_fields[GEOPOTENTIAL_VARIABLE] = jnp.where(
+        finite_reconstruction,
+        reconstructed_geopotential,
+        incumbent_pressure_fields[GEOPOTENTIAL_VARIABLE],
+    )
+    return pressure_fields
