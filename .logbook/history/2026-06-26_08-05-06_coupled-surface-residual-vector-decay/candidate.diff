+def _apply_coupled_surface_residual_vector_correction(
+    trajectory_state: WeatherState,
+    *,
+    initial_state: WeatherState,
+    lead_steps: tuple[int, ...],
+    lead_hours: tuple[int, ...],
+    decay_hours: float,
+    use_stability_aware_decay: bool = False,
+    horizontal_grid: spherical_harmonic.Grid | None = None,
+    latitude_reversed: bool = False,
+    land_sea_fraction: jax.Array | None = None,
+) -> WeatherState:
+    """Apply paired T2m/U10 residual-vector decay after the raw trajectory."""
+    incumbent_state = _apply_scale_separated_near_surface_residual_correction(
+        trajectory_state,
+        initial_state=initial_state,
+        lead_steps=lead_steps,
+        lead_hours=lead_hours,
+        decay_hours=decay_hours,
+        use_stability_aware_decay=use_stability_aware_decay,
+        horizontal_grid=horizontal_grid,
+        latitude_reversed=latitude_reversed,
+        land_sea_fraction=land_sea_fraction,
+    )
+    required_channels = (
+        TWO_METER_TEMPERATURE_VARIABLE,
+        TEN_METER_U_WIND_VARIABLE,
+    )
+    if any(
+        channel not in initial_state.variables
+        or channel not in trajectory_state.variables
+        for channel in required_channels
+    ):
+        return incumbent_state
+
+    lead_hours_numpy = np.asarray(lead_hours, dtype=np.float64)
+    if not bool(np.isfinite(lead_hours_numpy).all()):
+        return incumbent_state
+
+    assert decay_hours > 0.0
+    assert len(lead_steps) == len(lead_hours)
+
+    lead_indices = jnp.asarray(lead_steps, dtype=jnp.int32)
+    corrected_values = jnp.take(trajectory_state.values, lead_indices, axis=0)
+    lead_hours_array = jnp.asarray(lead_hours, dtype=corrected_values.dtype)
+    temperature_output_index = int(
+        trajectory_state.variable_indices((TWO_METER_TEMPERATURE_VARIABLE,))[0]
+    )
+    temperature_initial_index = int(
+        initial_state.variable_indices((TWO_METER_TEMPERATURE_VARIABLE,))[0]
+    )
+    wind_output_index = int(
+        trajectory_state.variable_indices((TEN_METER_U_WIND_VARIABLE,))[0]
+    )
+    wind_initial_index = int(
+        initial_state.variable_indices((TEN_METER_U_WIND_VARIABLE,))[0]
+    )
+    initial_temperature = initial_state.values[temperature_initial_index]
+    initial_wind = initial_state.values[wind_initial_index]
+    temperature_residual = (
+        initial_temperature - trajectory_state.values[0, temperature_output_index]
+    )
+    wind_residual = initial_wind - trajectory_state.values[0, wind_output_index]
+
+    valid_decay = jnp.asarray(True)
+    valid_residual_split = jnp.asarray(True)
+    if horizontal_grid is None:
+        high_mode_decay = _near_surface_residual_decay_factors(
+            trajectory_state,
+            initial_state=initial_state,
+            lead_indices=lead_indices,
+            lead_hours_array=lead_hours_array,
+            decay_hours=decay_hours,
+            use_stability_aware_decay=use_stability_aware_decay,
+        )
+        residual_bands = ((temperature_residual, wind_residual, high_mode_decay),)
+    else:
+        high_mode_decay, low_mode_decay = _scale_separated_residual_decays(
+            trajectory_state,
+            initial_state=initial_state,
+            lead_indices=lead_indices,
+            lead_hours_array=lead_hours_array,
+            decay_hours=decay_hours,
+            use_stability_aware_decay=use_stability_aware_decay,
+        )
+        try:
+            (
+                low_mode_temperature_residual,
+                high_mode_temperature_residual,
+                temperature_split_is_valid,
+            ) = _split_near_surface_residual_by_scale(
+                temperature_residual,
+                horizontal_grid=horizontal_grid,
+                latitude_reversed=latitude_reversed,
+            )
+            (
+                low_mode_wind_residual,
+                high_mode_wind_residual,
+                wind_split_is_valid,
+            ) = _split_near_surface_residual_by_scale(
+                wind_residual,
+                horizontal_grid=horizontal_grid,
+                latitude_reversed=latitude_reversed,
+            )
+        except (AssertionError, AttributeError, TypeError, ValueError):
+            return incumbent_state
+        valid_residual_split = temperature_split_is_valid & wind_split_is_valid
+        residual_bands = (
+            (low_mode_temperature_residual, low_mode_wind_residual, low_mode_decay),
+            (high_mode_temperature_residual, high_mode_wind_residual, high_mode_decay),
+        )
+
+    temperature_increment = jnp.zeros_like(
+        corrected_values[:, temperature_output_index]
+    )
+    wind_increment = jnp.zeros_like(corrected_values[:, wind_output_index])
+    valid_vector_decay = jnp.asarray(True)
+    for temperature_band, wind_band, band_decay in residual_bands:
+        (
+            band_temperature_increment,
+            band_wind_increment,
+            band_is_valid,
+        ) = _coupled_surface_residual_vector_increment(
+            temperature_band,
+            wind_band,
+            band_decay,
+        )
+        temperature_increment = temperature_increment + band_temperature_increment
+        wind_increment = wind_increment + band_wind_increment
+        valid_vector_decay = valid_vector_decay & band_is_valid
+        valid_decay = valid_decay & jnp.all(
+            jnp.isfinite(band_decay) & (band_decay >= 0.0) & (band_decay <= 1.0)
+        )
+
+    candidate_temperature = (
+        corrected_values[:, temperature_output_index] + temperature_increment
+    )
+    candidate_wind = corrected_values[:, wind_output_index] + wind_increment
+    lead_zero_mask = lead_indices == 0
+    candidate_temperature = jnp.where(
+        lead_zero_mask[:, jnp.newaxis, jnp.newaxis],
+        initial_temperature[jnp.newaxis, ...],
+        candidate_temperature,
+    )
+    candidate_wind = jnp.where(
+        lead_zero_mask[:, jnp.newaxis, jnp.newaxis],
+        initial_wind[jnp.newaxis, ...],
+        candidate_wind,
+    )
+    candidate_is_valid = (
+        valid_residual_split
+        & valid_vector_decay
+        & valid_decay
+        & jnp.all(jnp.isfinite(candidate_temperature))
+        & jnp.all(jnp.isfinite(candidate_wind))
+    )
+    corrected_values = corrected_values.at[:, temperature_output_index].set(
+        jnp.where(
+            candidate_is_valid,
+            candidate_temperature,
+            incumbent_state.values[:, temperature_output_index],
+        )
+    )
+    corrected_values = corrected_values.at[:, wind_output_index].set(
+        jnp.where(
+            candidate_is_valid,
+            candidate_wind,
+            incumbent_state.values[:, wind_output_index],
+        )
+    )
+
+    return WeatherState(
+        values=corrected_values,
+        variables=trajectory_state.variables,
+    )
+
+
+def _near_surface_residual_decay_factors(
+    trajectory_state: WeatherState,
+    *,
+    initial_state: WeatherState,
+    lead_indices: jax.Array,
+    lead_hours_array: jax.Array,
+    decay_hours: float,
+    use_stability_aware_decay: bool,
+) -> jax.Array:
+    """Return scalar residual factors in the same shape as stability decay."""
+    if use_stability_aware_decay:
+        decay_hours_array_local = _stability_aware_near_surface_residual_decay_hours(
+            trajectory_state,
+            initial_state=initial_state,
+            lead_indices=lead_indices,
+            base_decay_hours=decay_hours,
+        )
+        return jnp.exp(
+            -lead_hours_array[:, jnp.newaxis, jnp.newaxis] / decay_hours_array_local
+        )
+    decay = jnp.exp(-lead_hours_array / jnp.asarray(decay_hours))
+    return decay[:, jnp.newaxis, jnp.newaxis]
+
+
+def _coupled_surface_residual_vector_increment(
+    temperature_residual: jax.Array,
+    wind_residual: jax.Array,
+    shared_decay: jax.Array,
+) -> tuple[jax.Array, jax.Array, jax.Array]:
+    """Return direction-preserving decayed increments for one residual band."""
+    scaled_temperature = (
+        temperature_residual / _STABILITY_AWARE_TEMPERATURE_RESIDUAL_SCALE_KELVIN
+    )
+    scaled_wind = wind_residual / _STABILITY_AWARE_WIND_RESIDUAL_SCALE_METERS_PER_SECOND
+    vector_norm = jnp.sqrt(jnp.maximum(scaled_temperature**2 + scaled_wind**2, 0.0))
+    safe_norm = jnp.where(vector_norm > 0.0, vector_norm, 1.0)
+    bounded_decay = jnp.clip(shared_decay, 0.0, 1.0)
+    decayed_norm = vector_norm[jnp.newaxis, ...] * bounded_decay
+    temperature_increment = (
+        scaled_temperature[jnp.newaxis, ...]
+        / safe_norm[jnp.newaxis, ...]
+        * decayed_norm
+        * _STABILITY_AWARE_TEMPERATURE_RESIDUAL_SCALE_KELVIN
+    )
+    wind_increment = (
+        scaled_wind[jnp.newaxis, ...]
+        / safe_norm[jnp.newaxis, ...]
+        * decayed_norm
+        * _STABILITY_AWARE_WIND_RESIDUAL_SCALE_METERS_PER_SECOND
+    )
+    vector_is_valid = (
+        jnp.all(jnp.isfinite(scaled_temperature))
+        & jnp.all(jnp.isfinite(scaled_wind))
+        & jnp.all(jnp.isfinite(vector_norm))
+        & jnp.all(jnp.isfinite(shared_decay))
+        & jnp.all(jnp.isfinite(temperature_increment))
+        & jnp.all(jnp.isfinite(wind_increment))
+    )
+    return temperature_increment, wind_increment, vector_is_valid
+
