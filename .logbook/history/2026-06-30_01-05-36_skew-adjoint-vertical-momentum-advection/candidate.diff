+def test_skew_adjoint_vertical_advection_identity_on_unequal_layers():
+    """The opt-in vertical momentum stencil is skew under layer-mass weights."""
+    coordinates = sigma_coordinates.SigmaCoordinates(
+        np.asarray([0.0, 0.08, 0.31, 0.67, 1.0], dtype=np.float32)
+    )
+    x = jnp.asarray(
+        [
+            [[0.2, -1.1], [0.7, 1.4]],
+            [[-0.8, 0.5], [1.9, -0.3]],
+            [[1.2, -0.4], [-1.7, 0.9]],
+            [[0.6, 1.5], [-0.2, -1.0]],
+        ],
+        dtype=jnp.float32,
+    )
+    sigma_dot = jnp.asarray(
+        [
+            [[0.03, -0.08], [0.11, -0.04]],
+            [[-0.07, 0.05], [0.02, 0.09]],
+            [[0.12, -0.06], [-0.10, 0.04]],
+        ],
+        dtype=jnp.float32,
+    )
+
+    skew_tendency = sigma_coordinates.skew_adjoint_vertical_advection(
+        sigma_dot,
+        x,
+        coordinates,
+    )
+    layer_thickness = jnp.asarray(coordinates.layer_thickness)[
+        :, jnp.newaxis, jnp.newaxis
+    ]
+    weighted_quadratic_form = jnp.sum(layer_thickness * x * skew_tendency)
+
+    np.testing.assert_allclose(weighted_quadratic_form, 0.0, atol=2e-8)
+
