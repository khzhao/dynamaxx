+            [[-1.2, 1.1, -1.0], [0.9, -0.8, 0.7], [-0.6, 0.5, -0.4], [0.3, -0.2, 0.1]],
+        ],
+        dtype=jnp.float32,
+    )
+    sigma_dot = jnp.asarray(
+        [
+            [
+                [0.02, -0.04, 0.06],
+                [-0.08, 0.10, -0.12],
+                [0.14, -0.16, 0.18],
+                [-0.20, 0.22, -0.24],
+            ],
+            [
+                [-0.03, 0.05, -0.07],
+                [0.09, -0.11, 0.13],
+                [-0.15, 0.17, -0.19],
+                [0.21, -0.23, 0.25],
+            ],
+            [
+                [0.04, -0.06, 0.08],
+                [-0.10, 0.12, -0.14],
+                [0.16, -0.18, 0.20],
+                [-0.22, 0.24, -0.26],
+            ],
+        ],
+        dtype=jnp.float32,
+    )
+    aux_state = primitive_equations.DiagnosticStateSigma(
+        vorticity=jnp.zeros_like(temperature_variation),
+        divergence=jnp.zeros_like(temperature_variation),
+        temperature_variation=temperature_variation,
+        cos_lat_u=(
+            jnp.zeros_like(temperature_variation),
+            jnp.zeros_like(temperature_variation),
+        ),
+        sigma_dot_explicit=sigma_dot,
+        sigma_dot_full=sigma_dot,
+        cos_lat_grad_log_sp=jnp.zeros(
+            (2,) + grid.coords.horizontal.nodal_shape,
+            dtype=jnp.float32,
+        ),
+        u_dot_grad_log_sp=jnp.zeros(grid.coords.nodal_shape, dtype=jnp.float32),
