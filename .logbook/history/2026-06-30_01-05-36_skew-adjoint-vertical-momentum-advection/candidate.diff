+def test_nonfinite_skew_momentum_tendency_falls_back_to_centered(monkeypatch):
+    """Nonfinite skew momentum terms fall back exactly to centered terms."""
+    grid = grid_metadata(
+        longitude=np.asarray([0.0, 90.0, 180.0, 270.0]),
+        latitude=np.asarray([90.0, 0.0, -90.0]),
+        layer_count=4,
+        spectral_wavenumbers=None,
+    )
+    physics_specs = units.SimUnits.from_si()
+    common_kwargs = {
+        "reference_temperature": _reference_temperature(
+            layer_count=4,
+            temperature_kelvin=250.0,
+        ),
+        "orography": jnp.zeros(grid.coords.horizontal.modal_shape, dtype=jnp.float32),
+        "coords": grid.coords,
+        "physics_specs": cast(Any, physics_specs),
+        "include_vertical_advection": True,
+    }
+    incumbent_equation = primitive_equations.PrimitiveEquations(**common_kwargs)
+    skew_equation = primitive_equations.PrimitiveEquations(
+        **common_kwargs,
+        use_skew_adjoint_vertical_momentum_advection=True,
+    )
+    sigma_dot = jnp.ones((3,) + grid.coords.horizontal.nodal_shape, dtype=jnp.float32)
+    u = jnp.arange(np.prod(grid.coords.nodal_shape), dtype=jnp.float32).reshape(
+        grid.coords.nodal_shape
+    )
+    v = u * -0.25
+
+    def nonfinite_skew_tendency(w, x, coordinates, axis=-3):
+        del w, coordinates, axis
+        return jnp.full_like(x, jnp.nan)
+
+    monkeypatch.setattr(
+        primitive_equations.sigma_coordinates,
+        "skew_adjoint_vertical_advection",
+        nonfinite_skew_tendency,
+    )
+
+    centered_u, centered_v = incumbent_equation._vertical_momentum_terms(
+        sigma_dot,
+        u,
+        v,
+    )
+    guarded_u, guarded_v = skew_equation._vertical_momentum_terms(sigma_dot, u, v)
+
+    np.testing.assert_array_equal(guarded_u, centered_u)
+    np.testing.assert_array_equal(guarded_v, centered_v)
+
+
