diff --git a/src/dynamaxx/dycore/models/dinosaur/sigma_coordinates.py b/src/dynamaxx/dycore/models/dinosaur/sigma_coordinates.py
index 4416f38..9c44cb9 100644
--- a/src/dynamaxx/dycore/models/dinosaur/sigma_coordinates.py
+++ b/src/dynamaxx/dycore/models/dinosaur/sigma_coordinates.py
@@ -405,6 +405,67 @@ def centered_vertical_advection(
     )
 
 
+@jax.named_call
+def skew_adjoint_vertical_advection(
+    w: Array,
+    x: Array,
+    coordinates: SigmaCoordinates,
+    axis: int = -3,
+) -> jnp.ndarray:
+    """Compute skew-adjoint vertical advection on sigma layers.
+
+    This operator uses zero top and bottom interface velocities and satisfies
+    ``sum(layer_thickness * x * A(x)) == 0`` up to roundoff for finite inputs and
+    positive layer thicknesses.
+    """
+    if coordinates.layers != x.shape[axis]:
+        raise ValueError(
+            "`x.shape[axis]` must be equal to `coordinates.layers`; "
+            f"got {x.shape[axis]} and {coordinates.layers}."
+        )
+    if coordinates.layers - 1 != w.shape[axis]:
+        raise ValueError(
+            "`w.shape[axis]` must be equal to `coordinates.layers - 1`; "
+            f"got {w.shape[axis]} and {coordinates.layers - 1}."
+        )
+
+    w_slc_shape = _slice_shape_along_axis(w, axis)
+    w_boundary_values = (
+        jnp.zeros(w_slc_shape, dtype=jax.dtypes.canonicalize_dtype(w.dtype)),
+        jnp.zeros(w_slc_shape, dtype=jax.dtypes.canonicalize_dtype(w.dtype)),
+    )
+    w_top, w_bottom = w_boundary_values
+    w_interfaces = jnp.concatenate([w_top, w, w_bottom], axis=axis)
+    w_lower = lax.slice_in_dim(w_interfaces, 0, -1, axis=axis)
+    w_upper = lax.slice_in_dim(w_interfaces, 1, None, axis=axis)
+
+    x_slc_shape = _slice_shape_along_axis(x, axis)
+    x_boundary = jnp.zeros(
+        x_slc_shape,
+        dtype=jax.dtypes.canonicalize_dtype(x.dtype),
+    )
+    x_lower = jnp.concatenate(
+        [x_boundary, lax.slice_in_dim(x, 0, -1, axis=axis)],
+        axis=axis,
+    )
+    x_upper = jnp.concatenate(
+        [lax.slice_in_dim(x, 1, None, axis=axis), x_boundary],
+        axis=axis,
+    )
+
+    numerator = w_upper * x_upper - w_lower * x_lower
+    numerator_axes = range(numerator.ndim)
+    inv_d𝜎 = 1 / coordinates.layer_thickness
+    inv_d𝜎_axes = [numerator_axes[axis]]
+    return -0.5 * einsum(
+        numerator,
+        numerator_axes,
+        inv_d𝜎,
+        inv_d𝜎_axes,
+        numerator_axes,
+    )
+
+
