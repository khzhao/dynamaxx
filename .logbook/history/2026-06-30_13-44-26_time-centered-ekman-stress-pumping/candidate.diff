+    )
+    endpoint_filter = _ekman_coupled_surface_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 900.0),
+    )
+    midpoint_filter = _ekman_coupled_surface_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+        step_seconds=_nondimensionalize_seconds(physics_specs, 900.0),
+        use_time_centered_closure=True,
+    )
+
+    endpoint_corrected = endpoint_filter(prev_state, next_state)
+    midpoint_corrected = midpoint_filter(next_state, next_state)
