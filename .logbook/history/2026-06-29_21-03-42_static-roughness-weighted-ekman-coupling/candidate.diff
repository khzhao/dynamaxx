+    coast_multiplier = float(np.mean(multiplier_array[:, 1]))
+    land_multiplier = float(np.mean(multiplier_array[:, 2]))
+    assert ocean_multiplier < coast_multiplier < land_multiplier
+    assert ocean_multiplier >= _EKMAN_ROUGHNESS_NORMALIZED_MIN
+    assert land_multiplier <= _EKMAN_ROUGHNESS_NORMALIZED_MAX
+
+
+def test_static_roughness_ekman_multiplier_uses_dinosaur_latitude_order():
+    """Latitude reversal is applied before the multiplier reaches the filter."""
+    source_order_land_fraction = jnp.asarray(
+        [
+            [0.0, 0.5, 1.0],
+            [0.0, 0.5, 1.0],
+            [0.0, 0.5, 1.0],
+            [0.0, 0.5, 1.0],
+        ],
+        dtype=jnp.float32,
+    )
+    quadrature_weights = jnp.ones_like(source_order_land_fraction)
+
+    multiplier = _static_roughness_weighted_ekman_multiplier_or_none(
+        source_order_land_fraction,
+        quadrature_weights=quadrature_weights,
+        latitude_reversed=True,
+    )
+
+    assert multiplier is not None
+    multiplier_array = np.asarray(multiplier)
+    assert float(np.mean(multiplier_array[:, 0])) > float(
+        np.mean(multiplier_array[:, 1])
+    )
+    assert float(np.mean(multiplier_array[:, 1])) > float(
+        np.mean(multiplier_array[:, 2])
+    )
