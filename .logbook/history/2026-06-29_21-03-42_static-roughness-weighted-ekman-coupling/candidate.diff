+def _static_roughness_weighted_ekman_multiplier_or_none(
+    land_sea_fraction: jax.Array | None,
+    *,
+    quadrature_weights: jax.Array,
+    latitude_reversed: bool,
+) -> jax.Array | None:
+    """Return a bounded, area-normalized static Ekman drag multiplier."""
+    try:
+        weights = np.asarray(jax.device_get(quadrature_weights), dtype=np.float64)
+    except Exception:
+        return None
+    valid_land_sea_fraction = _valid_land_sea_fraction_or_none(
+        land_sea_fraction,
+        tuple(int(size) for size in weights.shape),
+    )
+    if valid_land_sea_fraction is None:
+        return None
+    try:
+        land_fraction = np.asarray(
+            jax.device_get(
+                _to_dinosaur_latitude_order(
+                    valid_land_sea_fraction,
+                    latitude_reversed,
+                )
+            ),
+            dtype=np.float64,
+        )
+    except Exception:
+        return None
+    if weights.shape != land_fraction.shape:
+        return None
+    if weights.size == 0 or not bool(np.isfinite(weights).all()):
+        return None
+    total_weight = float(np.sum(weights))
+    if not np.isfinite(total_weight) or total_weight <= 0.0:
+        return None
+
+    smooth_land_weight = land_fraction * land_fraction * (3.0 - 2.0 * land_fraction)
+    coastline_weight = 4.0 * land_fraction * (1.0 - land_fraction)
+    raw_multiplier = (
+        _EKMAN_ROUGHNESS_RAW_OCEAN_MULTIPLIER
+        + (_EKMAN_ROUGHNESS_RAW_LAND_MULTIPLIER - _EKMAN_ROUGHNESS_RAW_OCEAN_MULTIPLIER)
+        * smooth_land_weight
+        + _EKMAN_ROUGHNESS_RAW_COAST_BUMP * coastline_weight
+    )
+    raw_multiplier = np.clip(
+        raw_multiplier,
+        _EKMAN_ROUGHNESS_NORMALIZED_MIN,
+        _EKMAN_ROUGHNESS_NORMALIZED_MAX,
+    )
+    raw_area_mean = float(np.sum(raw_multiplier * weights) / total_weight)
+    if not np.isfinite(raw_area_mean) or raw_area_mean <= 0.0:
+        return None
+
+    normalized_multiplier = raw_multiplier / raw_area_mean
+    normalized_multiplier = normalized_multiplier.astype(np.float32)
+    cast_area_mean = float(
+        np.sum(normalized_multiplier.astype(np.float64) * weights) / total_weight
+    )
+    if not np.isfinite(cast_area_mean) or cast_area_mean <= 0.0:
+        return None
+    normalized_multiplier = (
+        normalized_multiplier.astype(np.float64) / cast_area_mean
+    ).astype(np.float32)
+    correction_mean = float(
+        np.sum(normalized_multiplier.astype(np.float64) * weights) / total_weight
+    )
+    if np.isfinite(correction_mean) and correction_mean > 0.0:
+        residual = 1.0 - correction_mean
+        max_weight_index = np.unravel_index(int(np.argmax(weights)), weights.shape)
+        normalized_multiplier[max_weight_index] = np.float32(
+            normalized_multiplier[max_weight_index]
+            + residual * total_weight / float(weights[max_weight_index])
+        )
+
+    return _valid_ekman_surface_drag_multiplier_or_none(
+        normalized_multiplier,
+        land_fraction.shape,
+        weights,
+    )
+
+
+def _valid_ekman_surface_drag_multiplier_or_none(
+    surface_drag_multiplier: jax.Array | None,
+    spatial_shape: tuple[int, int],
+    quadrature_weights: jax.Array,
+) -> jax.Array | None:
+    """Return a finite mean-one Ekman multiplier or `None` for exact fallback."""
+    if surface_drag_multiplier is None:
+        return None
+    try:
+        candidate = np.asarray(
+            jax.device_get(surface_drag_multiplier),
+            dtype=np.float32,
+        )
+        weights = np.asarray(jax.device_get(quadrature_weights), dtype=np.float64)
+    except Exception:
+        return None
+    if candidate.shape != tuple(spatial_shape) or weights.shape != tuple(spatial_shape):
+        return None
+    if candidate.size == 0 or not bool(np.isfinite(candidate).all()):
+        return None
+    if weights.size == 0 or not bool(np.isfinite(weights).all()):
+        return None
+    total_weight = float(np.sum(weights))
+    if not np.isfinite(total_weight) or total_weight <= 0.0:
+        return None
+    if (
+        float(np.min(candidate)) < _EKMAN_ROUGHNESS_NORMALIZED_MIN
+        or float(np.max(candidate)) > _EKMAN_ROUGHNESS_NORMALIZED_MAX
+    ):
+        return None
+    area_mean = float(np.sum(candidate.astype(np.float64) * weights) / total_weight)
+    if (
+        not np.isfinite(area_mean)
+        or area_mean <= 0.0
+        or abs(area_mean - 1.0) > _EKMAN_ROUGHNESS_AREA_MEAN_ATOL
+    ):
+        return None
+    if bool(np.allclose(candidate, 1.0, rtol=0.0, atol=1.0e-7)):
+        return None
+    candidate.setflags(write=False)
+    return jnp.asarray(candidate, dtype=jnp.float32)
+
