+def test_ekman_coupled_filter_all_one_roughness_matches_incumbent():
+    """An all-one multiplier is removed so the filter is bitwise incumbent."""
+    coords, physics_specs, prev_state, next_state = _synthetic_ekman_coupled_state(
+        wind_scale=8.0,
+    )
+    filter_kwargs = {
+        "coords": coords,
+        "physics_specs": physics_specs,
+        "reference_temperature": _reference_temperature(
+            layer_count=coords.vertical.layers,
+            temperature_kelvin=250.0,
+        ),
+        "step_seconds": _nondimensionalize_seconds(physics_specs, 900.0),
+    }
+    incumbent_filter = _ekman_coupled_surface_step_filter(**filter_kwargs)
+    all_one_filter = _ekman_coupled_surface_step_filter(
+        **filter_kwargs,
+        surface_drag_multiplier=jnp.ones(
+            coords.horizontal.nodal_shape,
+            dtype=jnp.float32,
+        ),
+    )
+
+    incumbent = incumbent_filter(prev_state, next_state)
+    candidate = all_one_filter(prev_state, next_state)
+
+    np.testing.assert_array_equal(candidate.vorticity, incumbent.vorticity)
+    np.testing.assert_array_equal(candidate.divergence, incumbent.divergence)
+    np.testing.assert_array_equal(
+        candidate.temperature_variation,
+        incumbent.temperature_variation,
+    )
+    np.testing.assert_array_equal(
+        candidate.log_surface_pressure,
+        incumbent.log_surface_pressure,
+    )
+    assert candidate.tracers.keys() == incumbent.tracers.keys()
+    for tracer_name, tracer_value in candidate.tracers.items():
+        np.testing.assert_array_equal(tracer_value, incumbent.tracers[tracer_name])
+
