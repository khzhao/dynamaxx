+def test_first_step_divergence_filter_applies_once_before_second_inner_step():
+    """The trajectory wrapper filters only the first post-initialization inner step."""
+    horizontal_grid = _residual_split_test_grid()
+    initial_state, _, low_index, high_index = _first_step_filter_test_states(
+        horizontal_grid
