+    divergence_increment = jnp.zeros_like(initial_state.divergence)
+    divergence_increment = divergence_increment.at[:, low_index[0], low_index[1]].set(
+        jnp.asarray([1.0, 2.0], dtype=jnp.float32)
+    )
+    divergence_increment = divergence_increment.at[:, high_index[0], high_index[1]].set(
+        jnp.asarray([10.0, 20.0], dtype=jnp.float32)
+    )
+
+    def step_fn(state):
+        return _primitive_equation_state(
+            vorticity=state.vorticity,
+            divergence=state.divergence + divergence_increment,
+            temperature_variation=state.temperature_variation,
+            log_surface_pressure=state.log_surface_pressure,
+            tracers=state.tracers,
+            sim_time=state.sim_time,
