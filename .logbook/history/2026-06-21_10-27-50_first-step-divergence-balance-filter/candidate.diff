+def _first_step_filter_test_states(
+    horizontal_grid: spherical_harmonic.Grid,
+) -> tuple[Any, Any, tuple[int, int], tuple[int, int]]:
+    _, total_wavenumber = horizontal_grid.modal_mesh
+    valid_modes = np.asarray(horizontal_grid.mask)
+    low_index = tuple(np.argwhere(valid_modes & (total_wavenumber == 2))[0])
+    maximum_valid_total_wavenumber = np.max(total_wavenumber[valid_modes])
+    high_index = tuple(
+        np.argwhere(valid_modes & (total_wavenumber == maximum_valid_total_wavenumber))[
+            0
+        ]
+    )
+    base_shape = (2,) + horizontal_grid.modal_shape
+    base = jnp.zeros(base_shape, dtype=jnp.float32)
+    divergence_increment = jnp.zeros(base_shape, dtype=jnp.float32)
+    divergence_increment = divergence_increment.at[:, low_index[0], low_index[1]].set(
+        jnp.asarray([1.0, 2.0], dtype=jnp.float32)
+    )
+    divergence_increment = divergence_increment.at[
+        :, high_index[0], high_index[1]
+    ].set(jnp.asarray([4.0, 8.0], dtype=jnp.float32))
+    initial_state = _primitive_equation_state(
+        vorticity=base + 2.0,
+        divergence=base + 0.5,
+        temperature_variation=base + 3.0,
+        log_surface_pressure=jnp.zeros(
+            (1,) + horizontal_grid.modal_shape,
+            dtype=jnp.float32,
+        ),
+        tracers={"q": base + 4.0},
+        sim_time=jnp.asarray(1.0, dtype=jnp.float32),
+    )
+    raw_state = _primitive_equation_state(
+        vorticity=initial_state.vorticity + 5.0,
+        divergence=initial_state.divergence + divergence_increment,
+        temperature_variation=initial_state.temperature_variation + 6.0,
+        log_surface_pressure=initial_state.log_surface_pressure + 0.25,
+        tracers={"q": initial_state.tracers["q"] + 7.0},
+        sim_time=jnp.asarray(2.0, dtype=jnp.float32),
+    )
+    return initial_state, raw_state, low_index, high_index
