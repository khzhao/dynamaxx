+def _trajectory_from_step_with_first_step_divergence_filter(
+    step_fn: Any,
+    *,
+    horizontal_grid: spherical_harmonic.Grid,
+    outer_steps: int,
+    inner_steps: int,
+    start_with_input: bool,
+):
+    """Return a trajectory with only the first positive-time divergence step filtered."""
+
+    def multistep(post_dfi_initial_state):
+        def inner_step(carry, _):
+            state, filter_is_pending = carry
+            raw_next_state = step_fn(state)
+
+            def apply_filter(args):
+                reference_state, candidate_state = args
+                return _filter_first_step_divergence_increment(
+                    reference_state,
+                    candidate_state,
+                    horizontal_grid=horizontal_grid,
+                )
+
+            def keep_raw(args):
+                _, candidate_state = args
+                return candidate_state
+
+            next_state = jax.lax.cond(
+                filter_is_pending,
+                apply_filter,
+                keep_raw,
+                (post_dfi_initial_state, raw_next_state),
+            )
+            return (next_state, jnp.asarray(False)), None
+
+        def outer_step(carry, _):
+            state, _ = carry
+            next_carry, _ = jax.lax.scan(
+                inner_step,
+                carry,
+                xs=None,
+                length=inner_steps,
+            )
+            next_state, _ = next_carry
+            frame = state if start_with_input else next_state
+            return next_carry, frame
+
+        initial_carry = (post_dfi_initial_state, jnp.asarray(True))
+        final_carry, trajectory = jax.lax.scan(
+            outer_step,
+            initial_carry,
+            xs=None,
+            length=outer_steps,
+        )
+        final_state, _ = final_carry
+        return final_state, trajectory
+
+    return multistep
+
+
+def _filter_first_step_divergence_increment(
+    post_dfi_initial_state: Any,
+    raw_first_step_state: Any,
+    *,
+    horizontal_grid: spherical_harmonic.Grid,
+) -> Any:
+    """Filter only the first-step modal divergence increment with finite fallback."""
+    divergence_shape = tuple(raw_first_step_state.divergence.shape)
+    if divergence_shape != tuple(post_dfi_initial_state.divergence.shape):
+        return raw_first_step_state
+    if divergence_shape[-2:] != tuple(horizontal_grid.modal_shape):
+        return raw_first_step_state
+
+    taper = _first_step_divergence_increment_taper(horizontal_grid)
+    divergence_increment = (
+        raw_first_step_state.divergence - post_dfi_initial_state.divergence
+    )
+    filtered_divergence = post_dfi_initial_state.divergence + (
+        divergence_increment * taper
+    )
+    filtered_state = _primitive_equation_state(
+        vorticity=raw_first_step_state.vorticity,
+        divergence=filtered_divergence,
+        temperature_variation=raw_first_step_state.temperature_variation,
+        log_surface_pressure=raw_first_step_state.log_surface_pressure,
+        tracers=raw_first_step_state.tracers,
+        sim_time=raw_first_step_state.sim_time,
+    )
+
+    def keep_filtered(args):
+        del args
+        return filtered_state
+
+    def fall_back_to_raw(args):
+        del args
+        return raw_first_step_state
+
+    return jax.lax.cond(
+        _pytree_all_finite(filtered_state),
+        keep_filtered,
+        fall_back_to_raw,
+        operand=None,
+    )
+
+
+def _first_step_divergence_increment_taper(
+    horizontal_grid: spherical_harmonic.Grid,
+) -> jax.Array:
+    """Return the fixed weak high-wavenumber taper for divergence increments."""
+    _, total_wavenumber = horizontal_grid.modal_mesh
+    valid_modes = np.asarray(horizontal_grid.mask)
+    if not np.any(valid_modes):
+        return jnp.zeros(horizontal_grid.modal_shape, dtype=jnp.float32)
+
+    maximum_total_wavenumber = float(np.max(total_wavenumber[valid_modes]))
+    if maximum_total_wavenumber <= 0.0:
+        return jnp.asarray(valid_modes, dtype=jnp.float32)
+
+    taper_start = (
+        _FIRST_STEP_DIVERGENCE_FILTER_START_FRACTION * maximum_total_wavenumber
+    )
+    transition_width = max(maximum_total_wavenumber - taper_start, 1.0)
+    transition = (total_wavenumber - taper_start) / transition_width
+    transition = np.clip(transition, 0.0, 1.0)
+    smooth_tail = 0.5 * (1.0 - np.cos(np.pi * transition))
+    scale = 1.0 - (
+        1.0 - _FIRST_STEP_DIVERGENCE_FILTER_MIN_SCALE
+    ) * smooth_tail
+    scale = np.where(valid_modes, scale, 0.0)
+    return jnp.asarray(scale, dtype=jnp.float32)
+
+
+def _pytree_all_finite(state: Any) -> jax.Array:
+    """Return a scalar JAX boolean indicating whether all state leaves are finite."""
+    finite_leaves = [
+        jnp.all(jnp.isfinite(leaf)) for leaf in jax.tree_util.tree_leaves(state)
+    ]
+    if not finite_leaves:
+        return jnp.asarray(True)
+    return jnp.all(jnp.asarray(finite_leaves))
+
