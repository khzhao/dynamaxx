@@ -1996,6 +2024,108 @@ def _horizontal_diffusion_step_filter(
     )
 
 
+def _helmholtz_momentum_diffusion_step_filter(
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    step_seconds: float,
+    tau_seconds: float | None,
+    order: int,
+) -> Any:
+    """Return scalar diffusion with vector-wind diffusion for momentum."""
+    scalar_diffusion_filter = _horizontal_diffusion_step_filter(
+        coords=coords,
+        physics_specs=physics_specs,
+        step_seconds=step_seconds,
+        tau_seconds=tau_seconds,
+        order=order,
+    )
+    if tau_seconds is None:
+        resolution_factor = coords.horizontal.latitude_nodes / 128.0
+        tau_hours = 8.6 / (2.4 ** np.log2(resolution_factor))
+        tau_seconds = tau_hours * 3600.0
+    tau = _nondimensionalize_seconds(physics_specs, tau_seconds)
+    eigenvalues = jnp.asarray(coords.horizontal.laplacian_eigenvalues)
+    diffusion_scale = step_seconds / (tau * jnp.abs(eigenvalues[-1]) ** order)
+    modal_scaling = jnp.exp(-diffusion_scale * (-eigenvalues) ** order)
+
+    def finite_or_fallback(candidate: jax.Array, fallback: jax.Array) -> jax.Array:
+        return jnp.where(jnp.all(jnp.isfinite(candidate)), candidate, fallback)
+
+    def helmholtz_momentum_diffusion_filter(prev_state: Any, next_state: Any) -> Any:
+        scalar_filtered_state = scalar_diffusion_filter(prev_state, next_state)
+        u_wind, v_wind = spherical_harmonic.vor_div_to_uv_nodal(
+            coords.horizontal,
+            next_state.vorticity,
+            next_state.divergence,
+        )
+        u_modal = coords.horizontal.to_modal(u_wind)
+        v_modal = coords.horizontal.to_modal(v_wind)
+        u_diffused = coords.horizontal.to_nodal(modal_scaling * u_modal)
+        v_diffused = coords.horizontal.to_nodal(modal_scaling * v_modal)
+        vorticity, divergence = spherical_harmonic.uv_nodal_to_vor_div_modal(
+            coords.horizontal,
+            u_diffused,
+            v_diffused,
+        )
+        # The projected vector path should remain a dissipative wind update.
+        u_projected, v_projected = spherical_harmonic.vor_div_to_uv_nodal(
+            coords.horizontal,
+            vorticity,
+            divergence,
+        )
+        input_wind_energy = jnp.mean(u_wind**2 + v_wind**2)
+        projected_wind_energy = jnp.mean(u_projected**2 + v_projected**2)
+        projected_momentum_is_finite = (
+            jnp.all(jnp.isfinite(u_wind))
+            & jnp.all(jnp.isfinite(v_wind))
+            & jnp.all(jnp.isfinite(u_modal))
+            & jnp.all(jnp.isfinite(v_modal))
+            & jnp.all(jnp.isfinite(u_diffused))
+            & jnp.all(jnp.isfinite(v_diffused))
+            & jnp.all(jnp.isfinite(vorticity))
+            & jnp.all(jnp.isfinite(divergence))
+            & jnp.all(jnp.isfinite(u_projected))
+            & jnp.all(jnp.isfinite(v_projected))
+            & jnp.isfinite(input_wind_energy)
+            & jnp.isfinite(projected_wind_energy)
+        )
+        projected_momentum_is_dissipative = (
+            projected_wind_energy <= input_wind_energy * (1.0 + 1e-6)
+        )
+        use_projected_momentum = (
+            projected_momentum_is_finite & projected_momentum_is_dissipative
+        )
+        scalar_vorticity = finite_or_fallback(
+            scalar_filtered_state.vorticity,
+            next_state.vorticity,
+        )
+        scalar_divergence = finite_or_fallback(
+            scalar_filtered_state.divergence,
+            next_state.divergence,
+        )
+        safe_vorticity = jnp.where(
+            use_projected_momentum,
+            vorticity,
+            scalar_vorticity,
+        )
+        safe_divergence = jnp.where(
+            use_projected_momentum,
+            divergence,
+            scalar_divergence,
+        )
+        return _primitive_equation_state(
+            vorticity=safe_vorticity,
+            divergence=safe_divergence,
+            temperature_variation=scalar_filtered_state.temperature_variation,
+            log_surface_pressure=scalar_filtered_state.log_surface_pressure,
+            tracers=scalar_filtered_state.tracers,
+            sim_time=scalar_filtered_state.sim_time,
+        )
+
+    return helmholtz_momentum_diffusion_filter
+
+
