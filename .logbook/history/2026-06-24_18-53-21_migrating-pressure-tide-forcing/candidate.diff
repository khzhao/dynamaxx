+def _initial_utc_hour_or_nan(initial_time: np.datetime64) -> np.float32:
+    """Return UTC decimal hour for one initialization time, or NaN on failure."""
+    try:
+        timestamp = np.datetime64(initial_time, "ns")
+        day_start = timestamp.astype("datetime64[D]").astype("datetime64[ns]")
+        elapsed_seconds = (timestamp - day_start) / np.timedelta64(1, "s")
+        return np.float32((float(elapsed_seconds) / _SECONDS_PER_HOUR) % 24.0)
+    except (TypeError, ValueError, OverflowError):
+        return np.float32(np.nan)
+
+
+def _with_dinosaur_state_sim_time(state: Any, sim_time: float) -> Any:
+    """Return a primitive-equation state with an explicit simulation clock."""
+    return _primitive_equation_state(
+        vorticity=state.vorticity,
+        divergence=state.divergence,
+        temperature_variation=state.temperature_variation,
+        log_surface_pressure=state.log_surface_pressure,
+        tracers=state.tracers,
+        sim_time=jnp.asarray(sim_time, dtype=jnp.float32),
+    )
+
+
+def _migrating_surface_pressure_tide_step_filter(
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    physics_specs: Any,
+    initial_solar_hour: jax.Array | None,
+) -> Any:
+    """Return a rollout-only filter for a small migrating pressure tide."""
+    pressure_unit_factor = _unit_factor(physics_specs, "pascal")
+    time_unit_factor = _unit_factor(physics_specs, "second")
+    minimum_surface_pressure = (
+        _MIGRATING_PRESSURE_TIDE_MIN_SURFACE_PRESSURE_PA * pressure_unit_factor
+    )
+
+    if initial_solar_hour is None:
+        initial_solar_hour = jnp.asarray(jnp.nan, dtype=jnp.float32)
+    else:
+        initial_solar_hour = jnp.asarray(initial_solar_hour, dtype=jnp.float32)
+
+    def state_solar_hour(state: Any) -> jax.Array:
+        if state.sim_time is None:
+            return jnp.asarray(jnp.nan, dtype=jnp.float32)
+        elapsed_hours = jnp.asarray(state.sim_time, dtype=jnp.float32) / (
+            time_unit_factor * _SECONDS_PER_HOUR
+        )
+        return initial_solar_hour + elapsed_hours
+
+    def migrating_surface_pressure_tide_filter(prev_state: Any, next_state: Any) -> Any:
+        prev_solar_hour = state_solar_hour(prev_state)
+        next_solar_hour = state_solar_hour(next_state)
+        prev_tide_pa = _migrating_surface_pressure_tide_pattern_pa(
+            coords.horizontal,
+            prev_solar_hour,
+        )
+        next_tide_pa = _migrating_surface_pressure_tide_pattern_pa(
+            coords.horizontal,
+            next_solar_hour,
+        )
+        pressure_increment_pa = jnp.clip(
+            next_tide_pa - prev_tide_pa,
+            -_MIGRATING_PRESSURE_TIDE_MAX_INCREMENT_PA,
+            _MIGRATING_PRESSURE_TIDE_MAX_INCREMENT_PA,
+        )
+        nodal_surface_pressure = jnp.exp(
+            coords.horizontal.to_nodal(next_state.log_surface_pressure)[0]
+        )
+        guarded_surface_pressure = jnp.maximum(
+            nodal_surface_pressure,
+            minimum_surface_pressure,
+        )
+        log_surface_pressure_increment = jnp.clip(
+            pressure_increment_pa * pressure_unit_factor / guarded_surface_pressure,
+            -_MIGRATING_PRESSURE_TIDE_MAX_LOG_INCREMENT,
+            _MIGRATING_PRESSURE_TIDE_MAX_LOG_INCREMENT,
+        )
+        modal_log_surface_pressure_increment = coords.horizontal.to_modal(
+            log_surface_pressure_increment
+        )[jnp.newaxis]
+        corrected_log_surface_pressure = (
+            next_state.log_surface_pressure + modal_log_surface_pressure_increment
+        )
+        finite_diagnostics = jnp.all(
+            jnp.asarray(
+                [
+                    jnp.isfinite(initial_solar_hour),
+                    jnp.isfinite(prev_solar_hour),
+                    jnp.isfinite(next_solar_hour),
+                    next_solar_hour >= prev_solar_hour,
+                    jnp.all(jnp.isfinite(prev_tide_pa)),
+                    jnp.all(jnp.isfinite(next_tide_pa)),
+                    jnp.all(jnp.isfinite(nodal_surface_pressure)),
+                    jnp.all(nodal_surface_pressure > 0.0),
+                    jnp.all(jnp.isfinite(guarded_surface_pressure)),
+                    jnp.all(jnp.isfinite(log_surface_pressure_increment)),
+                    jnp.all(jnp.isfinite(corrected_log_surface_pressure)),
+                ]
+            )
+        )
+        log_surface_pressure = jnp.where(
+            finite_diagnostics,
+            corrected_log_surface_pressure,
+            next_state.log_surface_pressure,
+        )
+        return _primitive_equation_state(
+            vorticity=next_state.vorticity,
+            divergence=next_state.divergence,
+            temperature_variation=next_state.temperature_variation,
+            log_surface_pressure=log_surface_pressure,
+            tracers=next_state.tracers,
+            sim_time=next_state.sim_time,
+        )
+
+    return migrating_surface_pressure_tide_filter
+
+
+def _migrating_surface_pressure_tide_pattern_pa(
+    horizontal_grid: spherical_harmonic.Grid,
+    solar_hour: jax.Array,
+) -> jax.Array:
+    """Return a finite-amplitude mass-neutral migrating pressure tide in Pa."""
+    longitude, sin_latitude = horizontal_grid.nodal_mesh
+    latitude = jnp.arcsin(jnp.clip(sin_latitude, -1.0, 1.0))
+    local_solar_angle = longitude + (
+        2.0 * jnp.pi * jnp.asarray(solar_hour, dtype=jnp.float32)
+        / _HOURS_PER_SOLAR_DAY
+    )
+    semidiurnal_phase = 2.0 * (
+        local_solar_angle
+        - 2.0
+        * jnp.pi
+        * _MIGRATING_PRESSURE_TIDE_SEMIDIURNAL_MAX_LOCAL_HOUR
+        / _HOURS_PER_SOLAR_DAY
+    )
+    diurnal_phase = (
+        local_solar_angle
+        - 2.0
+        * jnp.pi
+        * _MIGRATING_PRESSURE_TIDE_DIURNAL_MAX_LOCAL_HOUR
+        / _HOURS_PER_SOLAR_DAY
+    )
+    envelope = _migrating_pressure_tide_latitude_envelope(latitude)
+    tide_pattern = envelope * (
+        _MIGRATING_PRESSURE_TIDE_SEMIDIURNAL_AMPLITUDE_PA
+        * jnp.cos(semidiurnal_phase)
+        + _MIGRATING_PRESSURE_TIDE_DIURNAL_AMPLITUDE_PA * jnp.cos(diurnal_phase)
+    )
+    quadrature_weights = jnp.asarray(horizontal_grid.quadrature_weights)
+    tide_pattern = tide_pattern - _area_weighted_global_mean(
+        tide_pattern,
+        quadrature_weights,
+    )
+    return tide_pattern
+
+
+def _migrating_pressure_tide_latitude_envelope(latitude: jax.Array) -> jax.Array:
+    """Return a smooth tropical-subtropical envelope with a high-latitude taper."""
+    latitude_degrees = jnp.abs(latitude) * 180.0 / jnp.pi
+    taper_fraction = (
+        latitude_degrees - _MIGRATING_PRESSURE_TIDE_TAPER_START_DEGREES
+    ) / (
+        _MIGRATING_PRESSURE_TIDE_TAPER_END_DEGREES
+        - _MIGRATING_PRESSURE_TIDE_TAPER_START_DEGREES
+    )
+    taper_fraction = jnp.clip(taper_fraction, 0.0, 1.0)
+    smooth_taper = 0.5 * (1.0 + jnp.cos(jnp.pi * taper_fraction))
+    smooth_taper = jnp.where(
+        latitude_degrees >= _MIGRATING_PRESSURE_TIDE_TAPER_END_DEGREES,
+        0.0,
+        smooth_taper,
+    )
+    return jnp.cos(latitude) ** 2 * smooth_taper
+
+
+def _area_weighted_global_mean(
+    field: jax.Array,
+    quadrature_weights: jax.Array,
+) -> jax.Array:
+    """Return the horizontal quadrature mean of a nodal field."""
+    weights = jnp.asarray(quadrature_weights, dtype=field.dtype)
+    return jnp.sum(field * weights) / jnp.sum(weights)
