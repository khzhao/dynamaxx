+def _land_soil_thermal_reservoir_inputs(
+    initial_state: WeatherState,
+    *,
+    dinosaur_state: Any,
+    coords: coordinate_systems.CoordinateSystem,
+    latitude_reversed: bool,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+) -> tuple[jax.Array, jax.Array] | None:
+    """Return a capped land reservoir anchor and snow coupling, or `None`."""
+    if (
+        _LAND_SOIL_TEMPERATURE_CHANNEL not in initial_state.variables
+        or _SNOW_DEPTH_CHANNEL not in initial_state.variables
+    ):
+        return None
+
+    soil_index = int(
+        initial_state.variable_indices((_LAND_SOIL_TEMPERATURE_CHANNEL,))[0]
+    )
+    soil_temperature = initial_state.values[soil_index] * _unit_factor(
+        physics_specs,
+        "kelvin",
+    )
+    soil_temperature = _to_dinosaur_latitude_order(
+        soil_temperature,
+        latitude_reversed,
+    )
+    soil_temperature = _valid_land_soil_temperature_or_none(
+        soil_temperature,
+        coords.horizontal.nodal_shape,
+    )
+    if soil_temperature is None:
+        return None
+
+    snow_index = int(initial_state.variable_indices((_SNOW_DEPTH_CHANNEL,))[0])
+    snow_depth = _to_dinosaur_latitude_order(
+        initial_state.values[snow_index],
+        latitude_reversed,
+    )
+    snow_depth = _valid_snow_depth_or_none(
+        snow_depth,
+        coords.horizontal.nodal_shape,
+    )
+    if snow_depth is None:
+        return None
+
+    air_anchor = _land_soil_reservoir_air_anchor(
+        initial_state,
+        dinosaur_state=dinosaur_state,
+        coords=coords,
+        latitude_reversed=latitude_reversed,
+        physics_specs=physics_specs,
+        reference_temperature=reference_temperature,
+    )
+    if air_anchor is None:
+        return None
+
+    maximum_departure = (
+        _LAND_SOIL_RESERVOIR_MAX_ANCHOR_DEPARTURE_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+    )
+    reservoir_anchor = air_anchor + jnp.clip(
+        soil_temperature - air_anchor,
+        -maximum_departure,
+        maximum_departure,
+    )
+    reservoir_anchor = _valid_land_soil_temperature_or_none(
+        reservoir_anchor,
+        coords.horizontal.nodal_shape,
+    )
+    if reservoir_anchor is None:
+        return None
+
+    snow_coupling_factor = _land_soil_snow_coupling_factor(snow_depth)
+    snow_coupling_factor = _valid_land_soil_coupling_factor_or_none(
+        snow_coupling_factor,
+        coords.horizontal.nodal_shape,
+    )
+    if snow_coupling_factor is None:
+        return None
+    return reservoir_anchor, snow_coupling_factor
+
+
+def _land_soil_reservoir_air_anchor(
+    initial_state: WeatherState,
+    *,
+    dinosaur_state: Any,
+    coords: coordinate_systems.CoordinateSystem,
+    latitude_reversed: bool,
+    physics_specs: Any,
+    reference_temperature: np.ndarray,
+) -> jax.Array | None:
+    """Return lead-zero screen temperature, or the lowest model air layer."""
+    if TWO_METER_TEMPERATURE_VARIABLE in initial_state.variables:
+        temperature_index = int(
+            initial_state.variable_indices((TWO_METER_TEMPERATURE_VARIABLE,))[0]
+        )
+        screen_temperature = initial_state.values[temperature_index] * _unit_factor(
+            physics_specs,
+            "kelvin",
+        )
+        screen_temperature = _to_dinosaur_latitude_order(
+            screen_temperature,
+            latitude_reversed,
+        )
+        valid_screen_temperature = _valid_land_soil_temperature_or_none(
+            screen_temperature,
+            coords.horizontal.nodal_shape,
+        )
+        if valid_screen_temperature is not None:
+            return valid_screen_temperature
+
+    full_temperature = (
+        coords.horizontal.to_nodal(dinosaur_state.temperature_variation)
+        + jnp.asarray(reference_temperature)[:, jnp.newaxis, jnp.newaxis]
+    )
+    return _valid_land_soil_temperature_or_none(
+        full_temperature[-1],
+        coords.horizontal.nodal_shape,
+    )
+
+
+def _land_soil_snow_coupling_factor(snow_depth: jax.Array) -> jax.Array:
+    """Return a bounded snow-insulation factor from water-equivalent snow depth."""
+    snow_depth = jnp.maximum(jnp.asarray(snow_depth, dtype=jnp.float32), 0.0)
+    return jnp.exp(-snow_depth / _LAND_SOIL_RESERVOIR_SNOW_EFOLDING_METERS)
+
+
+def _valid_land_soil_temperature_or_none(
+    temperature: jax.Array | None,
+    spatial_shape: tuple[int, int],
+) -> jax.Array | None:
+    """Return a positive finite temperature field or `None` for fallback."""
+    if temperature is None:
+        return None
+    try:
+        candidate = np.asarray(jax.device_get(temperature), dtype=np.float32)
+    except Exception:
+        return None
+    if candidate.shape != tuple(spatial_shape):
+        return None
+    if candidate.size == 0:
+        return None
+    if not bool(np.isfinite(candidate).all()):
+        return None
+    if float(np.min(candidate)) <= 0.0:
+        return None
+    candidate.setflags(write=False)
+    return jnp.asarray(candidate, dtype=jnp.float32)
+
+
+def _valid_snow_depth_or_none(
+    snow_depth: jax.Array | None,
+    spatial_shape: tuple[int, int],
+) -> jax.Array | None:
+    """Return a finite nonnegative snow-depth field or `None` for fallback."""
+    if snow_depth is None:
+        return None
+    try:
+        candidate = np.asarray(jax.device_get(snow_depth), dtype=np.float32)
+    except Exception:
+        return None
+    if candidate.shape != tuple(spatial_shape):
+        return None
+    if candidate.size == 0:
+        return None
+    if not bool(np.isfinite(candidate).all()):
+        return None
+    if float(np.min(candidate)) < 0.0:
+        return None
+    candidate.setflags(write=False)
+    return jnp.asarray(candidate, dtype=jnp.float32)
+
+
+def _valid_land_soil_coupling_factor_or_none(
+    coupling_factor: jax.Array | None,
+    spatial_shape: tuple[int, int],
+) -> jax.Array | None:
+    """Return a finite `[0, 1]` coupling factor or `None` for fallback."""
+    if coupling_factor is None:
+        return None
+    try:
+        candidate = np.asarray(jax.device_get(coupling_factor), dtype=np.float32)
+    except Exception:
+        return None
+    if candidate.shape != tuple(spatial_shape):
+        return None
+    if candidate.size == 0:
+        return None
+    if not bool(np.isfinite(candidate).all()):
+        return None
+    if float(np.min(candidate)) < 0.0 or float(np.max(candidate)) > 1.0:
+        return None
+    candidate.setflags(write=False)
+    return jnp.asarray(candidate, dtype=jnp.float32)
