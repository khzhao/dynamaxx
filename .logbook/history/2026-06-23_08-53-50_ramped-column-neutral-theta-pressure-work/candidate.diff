+            (sim_time - ramp_start) / (ramp_end - ramp_start),
+            0.0,
+            1.0,
+        )
+        smoothstep = ramp_fraction * ramp_fraction * (3.0 - 2.0 * ramp_fraction)
+        ramp = jnp.asarray(THETA_PRESSURE_WORK_MAX_RAMP, dtype=sim_time.dtype)
+        return jnp.where(
+            sim_time <= ramp_start,
+            jnp.asarray(0.0, dtype=sim_time.dtype),
+            jnp.where(sim_time >= ramp_end, ramp, ramp * smoothstep),
+        )
