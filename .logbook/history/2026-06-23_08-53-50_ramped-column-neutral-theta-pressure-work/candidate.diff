+        tracers=state.tracers,
+        sim_time=jnp.asarray(
+            _nondimensionalize_seconds(physics_specs, 96.0 * 3600.0),
+            dtype=jnp.float32,
+        ),
+    )
+    equation = primitive_equations.PrimitiveEquations(
+        reference_temperature,
+        jnp.zeros(coords.horizontal.modal_shape, dtype=jnp.float32),
+        coords,
+        cast(Any, physics_specs),
+        include_vertical_advection=False,
+        temperature_tendency_formulation=(
+            primitive_equations.TEMPERATURE_TENDENCY_FORMULATION_POTENTIAL_TEMPERATURE
+        ),
+        use_horizontal_semilagrangian_theta_transport=True,
+        use_midpoint_semilagrangian_theta_departure=True,
+        use_ramped_theta_pressure_work=True,
+        horizontal_semilagrangian_theta_transport_step=_nondimensionalize_seconds(
+            physics_specs,
+            900.0,
+        ),
+    )
+    pressure_work_pattern = jnp.stack(
+        [
+            jnp.full(coords.horizontal.nodal_shape, 0.01, dtype=jnp.float32),
+            jnp.full(coords.horizontal.nodal_shape, -0.03, dtype=jnp.float32),
+        ],
+        axis=0,
+    )
+
+    def synthetic_pressure_work(pressure, aux_state):
+        del pressure, aux_state
+        return pressure_work_pattern
+
+    monkeypatch.setattr(
+        equation,
+        "nodal_hydrostatic_theta_pressure_work",
+        synthetic_pressure_work,
+    )
+    aux_state = primitive_equations.compute_diagnostic_state_sigma(
+        active_state,
+        coords,
+    )
+    pressure = equation.nodal_pressure_sigma(active_state)
+    added_increment, finite_diagnostics = (
+        equation.ramped_column_neutral_theta_pressure_work_increment(
+            active_state,
+            pressure,
+            aux_state,
+            incumbent_adiabatic_tendency=jnp.zeros_like(pressure_work_pattern),
+        )
+    )
+    layer_thickness = coords.vertical.layer_thickness[:, np.newaxis, np.newaxis]
+    column_weights = pressure * layer_thickness
+    weighted_column_mean = jnp.sum(
+        added_increment * column_weights,
+        axis=0,
+    ) / jnp.sum(column_weights, axis=0)
+
+    assert bool(finite_diagnostics)
+    assert float(jnp.max(jnp.abs(added_increment))) > 0.0
+    np.testing.assert_allclose(weighted_column_mean, 0.0, rtol=1e-6, atol=1e-8)
