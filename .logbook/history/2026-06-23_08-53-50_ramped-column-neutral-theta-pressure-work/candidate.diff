+def test_hsl2_theta_pw_ramp_added_increment_is_column_neutral(monkeypatch):
+    """The applied increment has near-zero pressure/sigma weighted column mean."""
+    coords, physics_specs, reference_temperature, state = _ocean_bulk_shf_test_setup()
+    active_state = _primitive_equation_state(
