+    """The baroclinic-mode candidate is side-by-side with the ramp incumbent."""
+    model = create_dycore_model("dino_hsl2_mass_dse_wtg_vdse_bm")
+    incumbent = create_dycore_model("dino_hsl2_mass_dse_wtg_vdse_ramp")
