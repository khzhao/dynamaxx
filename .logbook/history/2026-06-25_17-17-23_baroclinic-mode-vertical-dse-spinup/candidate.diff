+    assert model.use_pressure_ramped_vertical_dse_increment
+    assert model.use_baroclinic_mode_vertical_dse_increment
+    assert not incumbent.use_baroclinic_mode_vertical_dse_increment
+    for field_name in model.__dataclass_fields__:
+        if field_name in {"name", "use_baroclinic_mode_vertical_dse_increment"}:
+            continue
+        assert getattr(model, field_name) == getattr(incumbent, field_name)
