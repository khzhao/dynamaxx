+def _split_pressure_weighted_column_increment(
+    nodal_increment: Array,
+    layer_pressure_thickness: Array,
+) -> tuple[jax.Array, jax.Array, jax.Array]:
+    """Split an increment into column-mean and pressure-neutral components."""
+    layer_pressure_thickness = jnp.asarray(
+        layer_pressure_thickness,
+        dtype=nodal_increment.dtype,
+    )
+    tiny_pressure = jnp.asarray(
+        jnp.finfo(layer_pressure_thickness.dtype).tiny,
+        dtype=layer_pressure_thickness.dtype,
+    )
+    valid_pressure_thickness = (
+        jnp.isfinite(layer_pressure_thickness)
+        & (layer_pressure_thickness > tiny_pressure)
+    )
+    safe_pressure_thickness = jnp.where(
+        valid_pressure_thickness,
+        layer_pressure_thickness,
+        jnp.ones_like(layer_pressure_thickness),
+    )
+    pressure_thickness_sum = jnp.sum(
+        safe_pressure_thickness,
+        axis=0,
+        keepdims=True,
+    )
+    valid_pressure_sum = (
+        jnp.isfinite(pressure_thickness_sum)
+        & (pressure_thickness_sum > tiny_pressure)
+    )
+    safe_pressure_sum = jnp.where(
+        valid_pressure_sum,
+        pressure_thickness_sum,
+        jnp.ones_like(pressure_thickness_sum),
+    )
+    column_mean = (
+        jnp.sum(
+            nodal_increment * safe_pressure_thickness,
+            axis=0,
+            keepdims=True,
+        )
+        / safe_pressure_sum
+    )
+    external_increment = jnp.broadcast_to(column_mean, nodal_increment.shape)
+    internal_increment = nodal_increment - external_increment
+    finite_split = jnp.all(
+        jnp.asarray(
+            [
+                jnp.all(valid_pressure_thickness),
+                jnp.all(valid_pressure_sum),
+                jnp.all(jnp.isfinite(nodal_increment)),
+                jnp.all(jnp.isfinite(external_increment)),
+                jnp.all(jnp.isfinite(internal_increment)),
+            ]
+        )
+    )
+    return external_increment, internal_increment, finite_split
+
