+def _surface_layer_veered_10m_wind(
+    *,
+    temperature: jax.Array,
+    u_wind: jax.Array,
+    v_wind: jax.Array,
+    surface_pressure_hpa: jax.Array,
+    sigma_coords: sigma_coordinates.SigmaCoordinates,
+    latitude_sine: jax.Array,
+) -> tuple[jax.Array, jax.Array]:
+    """Diagnose 10 m wind with bounded stable, hemisphere-aware veering."""
+    richardson_u_wind, richardson_v_wind = _surface_layer_richardson_10m_wind(
+        temperature=temperature,
+        u_wind=u_wind,
+        v_wind=v_wind,
+        surface_pressure_hpa=surface_pressure_hpa,
+        sigma_coords=sigma_coords,
+    )
+    if sigma_coords.layers < 2:
+        return richardson_u_wind, richardson_v_wind
+
+    lower_sigma = float(sigma_coords.centers[-1])
+    upper_sigma = float(sigma_coords.centers[-2])
+    lower_pressure_hpa = surface_pressure_hpa * lower_sigma
+    upper_pressure_hpa = surface_pressure_hpa * upper_sigma
+    safe_lower_pressure_hpa = jnp.maximum(lower_pressure_hpa, 1.0)
+    safe_upper_pressure_hpa = jnp.maximum(upper_pressure_hpa, 1.0)
+    lower_temperature = temperature[:, -1]
+    upper_temperature = temperature[:, -2]
+    lower_theta = (
+        lower_temperature
+        * (1000.0 / safe_lower_pressure_hpa)
+        ** _STABILITY_AWARE_POTENTIAL_TEMPERATURE_EXPONENT
+    )
+    upper_theta = (
+        upper_temperature
+        * (1000.0 / safe_upper_pressure_hpa)
+        ** _STABILITY_AWARE_POTENTIAL_TEMPERATURE_EXPONENT
+    )
+    mean_temperature = jnp.maximum(0.5 * (lower_temperature + upper_temperature), 1.0)
+    mean_theta = jnp.maximum(0.5 * (lower_theta + upper_theta), 1.0)
+
+    pressure_ratio = jnp.maximum(safe_lower_pressure_hpa / safe_upper_pressure_hpa, 1.0)
+    layer_separation_meters = (
+        _DRY_AIR_GAS_CONSTANT_SI * mean_temperature / _GRAVITY_ACCELERATION_SI
+    ) * jnp.log(pressure_ratio)
+    lowest_layer_height_meters = (
+        _DRY_AIR_GAS_CONSTANT_SI * lower_temperature / _GRAVITY_ACCELERATION_SI
+    ) * jnp.log(1.0 / max(lower_sigma, 1.0e-6))
+    layer_separation_meters = jnp.maximum(layer_separation_meters, 1.0)
+    lowest_layer_height_meters = jnp.maximum(lowest_layer_height_meters, 10.0)
+
+    lowest_u_wind = u_wind[:, -1]
+    lowest_v_wind = v_wind[:, -1]
+    upper_u_wind = u_wind[:, -2]
+    upper_v_wind = v_wind[:, -2]
+    shear_u_wind = upper_u_wind - lowest_u_wind
+    shear_v_wind = upper_v_wind - lowest_v_wind
+    squared_shear = shear_u_wind**2 + shear_v_wind**2
+    shear_speed = jnp.sqrt(jnp.maximum(squared_shear, 0.0))
+    safe_squared_shear = jnp.maximum(
+        squared_shear,
+        _SURFACE_LAYER_SHEAR_FLOOR_METERS_PER_SECOND**2,
+    )
+    richardson_number = (
+        (_GRAVITY_ACCELERATION_SI / mean_theta)
+        * (upper_theta - lower_theta)
+        * layer_separation_meters
+        / safe_squared_shear
+    )
+    richardson_number = jnp.clip(richardson_number, -1.0, 1.0)
+
+    stable_fraction = (
+        richardson_number - _SURFACE_LAYER_VEERING_NEUTRAL_RI_THRESHOLD
+    ) / (
+        _SURFACE_LAYER_VEERING_FULL_STABLE_RI
+        - _SURFACE_LAYER_VEERING_NEUTRAL_RI_THRESHOLD
+    )
+    stable_fraction = jnp.clip(stable_fraction, 0.0, 1.0)
+    shear_fraction = (
+        shear_speed - _SURFACE_LAYER_SHEAR_FLOOR_METERS_PER_SECOND
+    ) / _SURFACE_LAYER_VEERING_SHEAR_SCALE_METERS_PER_SECOND
+    shear_fraction = jnp.clip(shear_fraction, 0.0, 1.0)
+
+    wind_speed = jnp.sqrt(jnp.maximum(lowest_u_wind**2 + lowest_v_wind**2, 0.0))
+    safe_turn_denominator = jnp.maximum(
+        wind_speed * shear_speed,
+        jnp.finfo(richardson_u_wind.dtype).tiny,
+    )
+    shear_turn_fraction = (
+        jnp.abs(lowest_u_wind * shear_v_wind - lowest_v_wind * shear_u_wind)
+        / safe_turn_denominator
+    )
+    shear_turn_fraction = jnp.sqrt(jnp.clip(shear_turn_fraction, 0.0, 1.0))
+
+    absolute_latitude_degrees = jnp.rad2deg(
+        jnp.arcsin(jnp.clip(jnp.abs(latitude_sine), 0.0, 1.0))
+    )
+    latitude_fraction = (
+        absolute_latitude_degrees - _SURFACE_LAYER_VEERING_ZERO_LATITUDE_DEGREES
+    ) / (
+        _SURFACE_LAYER_VEERING_FULL_LATITUDE_DEGREES
+        - _SURFACE_LAYER_VEERING_ZERO_LATITUDE_DEGREES
+    )
+    latitude_fraction = jnp.clip(latitude_fraction, 0.0, 1.0)
+
+    angle_degrees = (
+        _SURFACE_LAYER_VEERING_MAX_ANGLE_DEGREES
+        * stable_fraction
+        * shear_fraction
+        * shear_turn_fraction
+        * latitude_fraction
+    )
+    rotation_angle = -jnp.sign(latitude_sine) * jnp.deg2rad(angle_degrees)
+    cosine_angle = jnp.cos(rotation_angle)
+    sine_angle = jnp.sin(rotation_angle)
+    rotated_u_wind = richardson_u_wind * cosine_angle - richardson_v_wind * sine_angle
+    rotated_v_wind = richardson_u_wind * sine_angle + richardson_v_wind * cosine_angle
+    richardson_speed = jnp.sqrt(
+        jnp.maximum(richardson_u_wind**2 + richardson_v_wind**2, 0.0)
+    )
+    rotated_speed = jnp.sqrt(jnp.maximum(rotated_u_wind**2 + rotated_v_wind**2, 0.0))
+    speed_scale = jnp.where(
+        rotated_speed > jnp.finfo(richardson_u_wind.dtype).tiny,
+        richardson_speed / rotated_speed,
+        1.0,
+    )
+    rotated_u_wind = rotated_u_wind * speed_scale
+    rotated_v_wind = rotated_v_wind * speed_scale
+
+    required_values = jnp.stack(
+        [
+            lower_temperature,
+            upper_temperature,
+            lowest_u_wind,
+            upper_u_wind,
+            lowest_v_wind,
+            upper_v_wind,
+            surface_pressure_hpa,
+            lower_pressure_hpa,
+            upper_pressure_hpa,
+            layer_separation_meters,
+            lowest_layer_height_meters,
+            richardson_number,
+            shear_speed,
+            angle_degrees,
+            jnp.broadcast_to(latitude_sine, surface_pressure_hpa.shape),
+            rotated_u_wind,
+            rotated_v_wind,
+        ]
+    )
+    finite_mask = (
+        jnp.all(jnp.isfinite(required_values), axis=0)
+        & (surface_pressure_hpa > 0.0)
+        & (lower_pressure_hpa > 0.0)
+        & (upper_pressure_hpa > 0.0)
+        & (lower_temperature > 0.0)
+        & (upper_temperature > 0.0)
+        & (jnp.abs(latitude_sine) <= 1.0)
+        & (shear_speed > _SURFACE_LAYER_SHEAR_FLOOR_METERS_PER_SECOND)
+    )
+    return (
+        jnp.where(finite_mask, rotated_u_wind, richardson_u_wind),
+        jnp.where(finite_mask, rotated_v_wind, richardson_v_wind),
+    )
+
