+def _veered_10m_wind_inputs(
+    *,
+    upper_temperature_offset: float = 20.0,
+    latitude_sine: jax.Array,
+) -> tuple[
+    jax.Array,
+    jax.Array,
+    jax.Array,
+    jax.Array,
+    sigma_coordinates.SigmaCoordinates,
+    jax.Array,
+]:
+    sigma_coords = sigma_coordinates.SigmaCoordinates(
+        np.asarray([0.0, 0.99, 1.0], dtype=np.float32)
+    )
+    latitude_count = latitude_sine.shape[-1]
+    lower_temperature = 290.0
+    neutral_upper_temperature = lower_temperature * (
+        sigma_coords.centers[-2] / sigma_coords.centers[-1]
+    ) ** (2.0 / 7.0)
+    upper_temperature = jnp.full(
+        (latitude_count,),
+        neutral_upper_temperature + upper_temperature_offset,
+        dtype=jnp.float32,
+    )
+    lower_temperature_array = jnp.full(
+        (latitude_count,),
+        lower_temperature,
+        dtype=jnp.float32,
+    )
+    temperature = jnp.stack(
+        [upper_temperature, lower_temperature_array],
+        axis=0,
+    )[jnp.newaxis, :, jnp.newaxis, :]
+    upper_u_wind = jnp.full((latitude_count,), 10.0, dtype=jnp.float32)
+    upper_v_wind = jnp.full((latitude_count,), 6.0, dtype=jnp.float32)
+    lower_u_wind = jnp.full((latitude_count,), 10.0, dtype=jnp.float32)
+    lower_v_wind = jnp.zeros((latitude_count,), dtype=jnp.float32)
+    u_wind = jnp.stack([upper_u_wind, lower_u_wind], axis=0)[
+        jnp.newaxis,
+        :,
+        jnp.newaxis,
+        :,
+    ]
+    v_wind = jnp.stack([upper_v_wind, lower_v_wind], axis=0)[
+        jnp.newaxis,
+        :,
+        jnp.newaxis,
+        :,
+    ]
+    surface_pressure_hpa = jnp.full(
+        (1, 1, latitude_count),
+        1000.0,
+        dtype=jnp.float32,
+    )
+    return (
+        temperature,
+        u_wind,
+        v_wind,
+        surface_pressure_hpa,
+        sigma_coords,
+        latitude_sine,
+    )
+
+
