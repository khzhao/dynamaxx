+def _coherence_gated_u_wind_residual_or_incumbent(
+    residual: jax.Array,
+    *,
+    trajectory_state: WeatherState,
+    initial_state: WeatherState,
+    output_index: int,
+    initial_index: int,
+    u_wind_residual_coherence_fields: tuple[jax.Array, jax.Array] | None,
+) -> jax.Array:
+    """Gate the u10 residual, or return the unchanged residual on bad inputs."""
+    if u_wind_residual_coherence_fields is None:
+        return residual
+    lower_u_wind_by_lead, upper_u_wind_by_lead = u_wind_residual_coherence_fields
+    lower_u_wind = lower_u_wind_by_lead[0]
+    upper_u_wind = upper_u_wind_by_lead[0]
+    analyzed_u_wind = initial_state.values[initial_index]
+    raw_u_wind = trajectory_state.values[0, output_index]
+    required_fields = (
+        residual,
+        analyzed_u_wind,
+        raw_u_wind,
+        lower_u_wind,
+        upper_u_wind,
+    )
+    if any(tuple(field.shape) != tuple(residual.shape) for field in required_fields):
+        return residual
+
+    coherence_factor = _u_wind_residual_coherence_factor(
+        analyzed_u_wind=analyzed_u_wind,
+        raw_u_wind=raw_u_wind,
+        lower_u_wind=lower_u_wind,
+        upper_u_wind=upper_u_wind,
+    )
+    gated_residual = residual * coherence_factor
+    finite_checks = [
+        jnp.all(jnp.isfinite(field))
+        for field in (*required_fields, coherence_factor)
+    ]
+    gate_is_valid = jnp.all(
+        jnp.asarray(finite_checks)
+    )
+    return jnp.where(gate_is_valid, gated_residual, residual)
+
+
+def _sigma_u_wind_residual_coherence_fields(
+    trajectory: Any,
+    *,
+    coords: coordinate_systems.CoordinateSystem,
+    latitude_reversed: bool,
+    physics_specs: Any,
+) -> tuple[jax.Array, jax.Array] | None:
+    """Return lowest and next-lowest sigma u winds in WeatherState grid order."""
+    sigma_coords = cast(sigma_coordinates.SigmaCoordinates, coords.vertical)
+    if sigma_coords.layers < 2:
+        return None
+    u_wind, _ = spherical_harmonic.vor_div_to_uv_nodal(
+        coords.horizontal,
+        trajectory.vorticity,
+        trajectory.divergence,
+    )
+    u_wind = u_wind / _unit_factor(physics_specs, "meter / second")
+    return (
+        _from_dinosaur_latitude_order(u_wind[:, -1], latitude_reversed),
+        _from_dinosaur_latitude_order(u_wind[:, -2], latitude_reversed),
+    )
+
+
+def _u_wind_residual_coherence_factor(
+    *,
+    analyzed_u_wind: jax.Array,
+    raw_u_wind: jax.Array,
+    lower_u_wind: jax.Array,
+    upper_u_wind: jax.Array,
+) -> jax.Array:
+    """Return a bounded local factor for carrying initial u10 residual memory."""
+    wind_scale = jnp.asarray(
+        _U_RESIDUAL_COHERENCE_WIND_SCALE_METERS_PER_SECOND,
+        dtype=raw_u_wind.dtype,
+    )
+    sign_scale_squared = wind_scale**2
+    analyzed_raw_sign_support = 0.5 * (
+        1.0 + jnp.tanh((analyzed_u_wind * raw_u_wind) / sign_scale_squared)
+    )
+    lower_column_sign_support = 0.5 * (
+        1.0 + jnp.tanh((lower_u_wind * upper_u_wind) / sign_scale_squared)
+    )
+    lower_column_speed = jnp.maximum(jnp.abs(raw_u_wind), jnp.abs(lower_u_wind))
+    weak_flow_support = jnp.clip(lower_column_speed / wind_scale, 0.0, 1.0)
+    shear_magnitude = jnp.abs(upper_u_wind - lower_u_wind)
+    reference_speed = wind_scale + jnp.maximum(
+        jnp.abs(lower_u_wind),
+        jnp.abs(upper_u_wind),
+    )
+    shear_support = 1.0 / (1.0 + shear_magnitude / reference_speed)
+    coherence_support = (
+        analyzed_raw_sign_support
+        * lower_column_sign_support
+        * weak_flow_support
+        * shear_support
+    )
+    min_factor = jnp.asarray(_U_RESIDUAL_COHERENCE_MIN_FACTOR, dtype=raw_u_wind.dtype)
+    return jnp.clip(
+        min_factor + (1.0 - min_factor) * coherence_support,
+        min_factor,
+        1.0,
+    )
+
+
