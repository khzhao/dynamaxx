+
+    np.testing.assert_array_equal(
+        candidate.select(("10m_u_component_of_wind",)).values[0, 0],
+        initial_u_wind,
+    )
+    np.testing.assert_allclose(
+        candidate.select(("2m_temperature",)).values,
+        incumbent.select(("2m_temperature",)).values,
+        rtol=1e-6,
+        atol=1e-6,
+    )
+    np.testing.assert_array_equal(
+        candidate.select(
