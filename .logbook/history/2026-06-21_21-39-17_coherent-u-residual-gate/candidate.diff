+def test_u_residual_gate_falls_back_to_incumbent_scale_residual():
+    """Missing or nonfinite coherence fields leave scale-separated output unchanged."""
+    raw_temperature = jnp.stack(
+        [
+            jnp.full((4, 3), 280.0, dtype=jnp.float32),
+            jnp.full((4, 3), 282.0, dtype=jnp.float32),
+        ]
+    )
+    raw_u_wind = jnp.stack(
+        [
+            jnp.full((4, 3), 2.0, dtype=jnp.float32),
+            jnp.full((4, 3), 2.5, dtype=jnp.float32),
+        ]
+    )
+    initial_state = WeatherState(
+        values=jnp.stack([raw_temperature[0] + 4.0, raw_u_wind[0] - 3.0]),
+        variables=("2m_temperature", "10m_u_component_of_wind"),
+    )
+    grid = grid_metadata(
+        longitude=np.array([0.0, 90.0, 180.0, 270.0]),
+        latitude=np.array([90.0, 0.0, -90.0]),
+        layer_count=2,
+        spectral_wavenumbers=None,
+    )
+    common_kwargs = {
+        "initial_state": initial_state,
+        "lead_steps": (0, 1),
+        "lead_hours": (0, 96),
+        "decay_hours": 48.0,
+        "horizontal_grid": grid.coords.horizontal,
+        "latitude_reversed": grid.latitude_reversed,
+    }
+    missing_column_state = WeatherState(
+        values=jnp.stack([raw_temperature, raw_u_wind], axis=1),
+        variables=("2m_temperature", "10m_u_component_of_wind"),
+    )
+
+    missing_incumbent = _apply_scale_separated_near_surface_residual_correction(
+        missing_column_state,
+        **common_kwargs,
+    )
+    missing_candidate = _apply_scale_separated_near_surface_residual_correction(
+        missing_column_state,
+        **common_kwargs,
+        use_u_wind_residual_coherence_gate=True,
+    )
+
+    np.testing.assert_array_equal(missing_candidate.values, missing_incumbent.values)
+
+    low_column_u_wind = jnp.stack(
+        [
+            jnp.full((4, 3), jnp.inf, dtype=jnp.float32),
+            jnp.full((4, 3), 2.5, dtype=jnp.float32),
+        ]
+    )
+    upper_column_u_wind = jnp.stack(
+        [
+            jnp.full((4, 3), 2.0, dtype=jnp.float32),
+            jnp.full((4, 3), 2.5, dtype=jnp.float32),
+        ]
+    )
+    nonfinite_column_state = WeatherState(
+        values=jnp.stack(
+            [raw_temperature, raw_u_wind, low_column_u_wind, upper_column_u_wind],
+            axis=1,
+        ),
+        variables=(
+            "2m_temperature",
+            "10m_u_component_of_wind",
+            "u_component_of_wind_900",
+            "u_component_of_wind_500",
+        ),
+    )
+
+    nonfinite_incumbent = _apply_scale_separated_near_surface_residual_correction(
+        nonfinite_column_state,
+        **common_kwargs,
+    )
+    nonfinite_candidate = _apply_scale_separated_near_surface_residual_correction(
+        nonfinite_column_state,
+        **common_kwargs,
+        use_u_wind_residual_coherence_gate=True,
+        u_wind_residual_coherence_fields=(low_column_u_wind, upper_column_u_wind),
+    )
+
+    np.testing.assert_array_equal(nonfinite_candidate.values, nonfinite_incumbent.values)
