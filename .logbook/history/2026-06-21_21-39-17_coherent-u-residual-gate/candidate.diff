+                "u_component_of_wind_900",
+                "u_component_of_wind_500",
+                "mean_sea_level_pressure",
+                "geopotential_500",
+            )
+        ).values,
+        trajectory_state.select(
+            (
+                "u_component_of_wind_900",
+                "u_component_of_wind_500",
+                "mean_sea_level_pressure",
+                "geopotential_500",
+            )
+        ).values,
+    )
+    candidate_u_change = jnp.abs(
+        candidate.select(("10m_u_component_of_wind",)).values[1, 0] - raw_u_wind[1]
+    )
+    incumbent_u_change = jnp.abs(
+        incumbent.select(("10m_u_component_of_wind",)).values[1, 0] - raw_u_wind[1]
+    )
+    assert bool(jnp.all(candidate_u_change < incumbent_u_change))
