+        latitude_reversed=False,
+        physics_specs=physics_specs,
+    )
+    incompatible_result = _bounded_screen_temperature_layer_initialization(
+        jnp.full((2, 5, 3), 285.0, dtype=jnp.float32),
+        state=single_state,
+        latitude_reversed=False,
+        physics_specs=physics_specs,
+    )
+
+    np.testing.assert_array_equal(nonfinite_result, temperature)
+    np.testing.assert_array_equal(
+        incompatible_result,
+        jnp.full((2, 5, 3), 285.0, dtype=jnp.float32),
+    )
