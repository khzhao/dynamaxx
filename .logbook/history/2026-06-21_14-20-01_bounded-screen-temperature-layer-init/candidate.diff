+def _bounded_screen_temperature_layer_initialization(
+    temperature: jax.Array,
+    *,
+    state: WeatherState,
+    latitude_reversed: bool,
+    physics_specs: Any,
+) -> jax.Array:
+    """Nudge only the lowest sigma temperature toward same-time 2 m analysis."""
+    if TWO_METER_TEMPERATURE_VARIABLE not in state.variables:
+        return temperature
+
+    screen_temperature = state.select((TWO_METER_TEMPERATURE_VARIABLE,)).values[0]
+    screen_temperature = _to_dinosaur_latitude_order(
+        screen_temperature,
+        latitude_reversed,
+    )
+    screen_temperature = screen_temperature * _unit_factor(physics_specs, "kelvin")
+    lowest_temperature = temperature[-1]
+    if tuple(screen_temperature.shape) != tuple(lowest_temperature.shape):
+        return temperature
+
+    max_difference = (
+        _SCREEN_TEMPERATURE_LAYER_INIT_MAX_DIFFERENCE_KELVIN
+        * _unit_factor(physics_specs, "kelvin")
+    )
+    increment = _SCREEN_TEMPERATURE_LAYER_INIT_BLEND * jnp.clip(
+        screen_temperature - lowest_temperature,
+        -max_difference,
+        max_difference,
+    )
+    adjusted_lowest_temperature = lowest_temperature + increment
+    adjusted_temperature = temperature.at[-1].set(adjusted_lowest_temperature)
+    update_is_finite = (
+        jnp.all(jnp.isfinite(screen_temperature))
+        & jnp.all(jnp.isfinite(lowest_temperature))
+        & jnp.all(jnp.isfinite(adjusted_lowest_temperature))
+    )
+    return jnp.where(update_is_finite, adjusted_temperature, temperature)
+
