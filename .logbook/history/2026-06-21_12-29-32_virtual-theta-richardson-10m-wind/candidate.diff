+    lower_temperature = 290.0
+    neutral_upper_temperature = lower_temperature * (
+        sigma_coords.centers[-2] / sigma_coords.centers[-1]
+    ) ** (2.0 / 7.0)
+    temperature = jnp.stack(
+        [
+            jnp.full((1, 2), neutral_upper_temperature, dtype=jnp.float32),
+            jnp.full((1, 2), lower_temperature, dtype=jnp.float32),
+        ],
+        axis=0,
+    )[jnp.newaxis]
+    u_wind = jnp.full_like(temperature, 10.0)
+    v_wind = jnp.full_like(temperature, -4.0)
+    surface_pressure_hpa = jnp.full((1, 1, 2), 1000.0, dtype=jnp.float32)
