+def test_hydrostatic_inverted_mass_dse_matches_dense_column_solve():
+    """Hydrostatic DSE inversion solves the dense sigma operator per column."""
+    coords, physics_specs, reference_temperature, _ = _ocean_bulk_shf_test_setup()
+    equation = primitive_equations.PrimitiveEquations(
+        reference_temperature,
+        jnp.zeros(coords.horizontal.modal_shape, dtype=jnp.float32),
+        coords,
+        cast(Any, physics_specs),
+        include_vertical_advection=False,
+    )
+    longitude_pattern = jnp.arange(
+        coords.horizontal.nodal_shape[0],
+        dtype=jnp.float32,
+    )[:, jnp.newaxis]
+    latitude_pattern = jnp.arange(
+        coords.horizontal.nodal_shape[1],
+        dtype=jnp.float32,
+    )[jnp.newaxis, :]
+    layer_values = jnp.linspace(
+        -3.0,
+        5.0,
+        coords.vertical.layers,
+        dtype=jnp.float32,
+    )
+    layer_mass_dse_tendency = (
+        layer_values[:, jnp.newaxis, jnp.newaxis]
+        * (1.0 + 0.05 * longitude_pattern - 0.03 * latitude_pattern)[
+            jnp.newaxis,
+            :,
+            :,
+        ]
+    )
+
+    actual, finite_diagnostics = (
+        equation._hydrostatic_inverted_mass_dse_horizontal_temperature_tendency(
+            layer_mass_dse_tendency,
+        )
+    )
+
+    geopotential_weights = primitive_equations.get_geopotential_weights_sigma(
+        coords.vertical,
+        physics_specs.R,
+    )
+    hydrostatic_dse_operator = jnp.asarray(
+        geopotential_weights,
+        dtype=layer_mass_dse_tendency.dtype,
+    ) + physics_specs.Cp * jnp.eye(
+        coords.vertical.layers,
+        dtype=layer_mass_dse_tendency.dtype,
+    )
+    expected = jnp.reshape(
+        jnp.linalg.solve(
+            hydrostatic_dse_operator,
+            jnp.reshape(
