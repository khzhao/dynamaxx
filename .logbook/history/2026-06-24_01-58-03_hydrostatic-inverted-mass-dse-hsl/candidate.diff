+                (coords.vertical.layers, -1),
+            ),
+        ),
+        layer_mass_dse_tendency.shape,
+    )
+    assert bool(finite_diagnostics)
+    np.testing.assert_allclose(actual, expected, rtol=1.0e-6, atol=1.0e-6)
