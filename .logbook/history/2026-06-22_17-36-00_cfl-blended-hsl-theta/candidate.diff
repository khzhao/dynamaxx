+            valid_caps
+            & jnp.all(jnp.isfinite(longitude_displacement))
+            & jnp.all(jnp.isfinite(latitude_displacement))
+            & finite_raw_weight
+            & jnp.all(jnp.isfinite(blend_weight))
+            & jnp.all(blend_weight >= 0.0)
+            & jnp.all(blend_weight <= 1.0)
+        )
+        return blend_weight, finite_bounded_weight
