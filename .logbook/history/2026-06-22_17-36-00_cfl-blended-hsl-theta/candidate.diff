+            HORIZONTAL_SEMILAGRANGIAN_THETA_MAX_CFL * latitude_spacing
+        )
+        valid_caps = (
+            (latitude_count > 1)
+            & jnp.isfinite(max_longitude_displacement)
+            & (max_longitude_displacement > 0)
+            & jnp.isfinite(max_latitude_displacement)
+            & (max_latitude_displacement > 0)
+        )
+        longitude_weight = jnp.abs(longitude_displacement) / max_longitude_displacement
+        latitude_weight = jnp.abs(latitude_displacement) / max_latitude_displacement
+        raw_weight = jnp.sqrt(jnp.maximum(longitude_weight, latitude_weight))
+        finite_raw_weight = jnp.all(jnp.isfinite(raw_weight))
+        blend_weight = jnp.clip(
+            jnp.where(jnp.isfinite(raw_weight), raw_weight, 0.0),
+            0.0,
+            1.0,
+        )
