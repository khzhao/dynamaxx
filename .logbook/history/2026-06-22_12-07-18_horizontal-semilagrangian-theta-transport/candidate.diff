+            & (radius > 0)
+            & jnp.isfinite(radius)
+            & jnp.isfinite(latitude_spacing)
+            & (latitude_count > 1)
+            & finite_raw_displacement
+            & bounded_displacement
+        )
+        return longitude_displacement, latitude_displacement, valid_displacement
